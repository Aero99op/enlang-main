in script:
    # State Declarations
    create terminalStep as 0
    create mouseX as 0
    create mouseY as 0
    create targetX as 0
    create targetY as 0
    create orbitTime as 0

    show "⚡ Initializing Prayas Kumar Sahoo 3D Cyber Portfolio Engine in Pure Enlang (.enlgs)..."

    # Procedural 3D Sun Texture Generator in Pure Enlgs
    to do createSunTexture:
        create c as document.createElement("canvas")
        c.width = 1024
        c.height = 512
        create ctx as c.getContext("2d")
        create grad as ctx.createLinearGradient(0, 0, 0, 512)
        grad.addColorStop(0, "#ff2200")
        grad.addColorStop(0.25, "#ff6600")
        grad.addColorStop(0.5, "#ffaa00")
        grad.addColorStop(0.75, "#ffdd33")
        grad.addColorStop(1, "#ff4400")
        ctx.fillStyle = grad
        ctx.fillRect(0, 0, 1024, 512)
        
        repeat 1800 times:
            create x as Math.random() * 1024
            create y as Math.random() * 512
            create r as 2 + Math.random() * 20
            create alpha as 0.15 + Math.random() * 0.4
            if Math.random() > 0.4:
                ctx.fillStyle = "rgba(255, 255, 220, " + alpha + ")"
            else:
                ctx.fillStyle = "rgba(255, 60, 0, " + alpha + ")"
            ctx.beginPath()
            ctx.arc(x, y, r, 0, Math.PI * 2)
            ctx.fill()

        repeat 22 times:
            create sx as Math.random() * 1024
            create sy as 100 + Math.random() * 312
            create sr as 6 + Math.random() * 16
            ctx.fillStyle = "rgba(45, 8, 0, 0.85)"
            ctx.beginPath()
            ctx.arc(sx, sy, sr, 0, Math.PI * 2)
            ctx.fill()
            ctx.strokeStyle = "rgba(255, 120, 0, 0.6)"
            ctx.lineWidth = 4
            ctx.stroke()

        create tex as new THREE.CanvasTexture(c)
        tex.wrapS = THREE.RepeatWrapping
        tex.wrapT = THREE.RepeatWrapping
        return tex

    # Procedural 3D Moon Texture Generator with Craters & Lunar Maria
    to do createMoonTexture:
        create c as document.createElement("canvas")
        c.width = 1024
        c.height = 512
        create ctx as c.getContext("2d")
        ctx.fillStyle = "#8a96a6"
        ctx.fillRect(0, 0, 1024, 512)

        create maria as [ {x: 350, y: 200, r: 130}, {x: 270, y: 300, r: 95}, {x: 490, y: 170, r: 120}, {x: 660, y: 220, r: 145}, {x: 770, y: 320, r: 85}, {x: 180, y: 350, r: 75} ]
        for m in maria:
            create mg as ctx.createRadialGradient(m.x, m.y, 8, m.x, m.y, m.r)
            mg.addColorStop(0, "rgba(40, 50, 65, 0.9)")
            mg.addColorStop(0.65, "rgba(55, 65, 80, 0.7)")
            mg.addColorStop(1, "rgba(138, 150, 166, 0)")
            ctx.fillStyle = mg
            ctx.beginPath()
            ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2)
            ctx.fill()

        repeat 2400 times:
            create x as Math.random() * 1024
            create y as Math.random() * 512
            create r as 1 + Math.random() * 6
            if Math.random() > 0.5:
                ctx.fillStyle = "rgba(255, 255, 255, 0.3)"
            else:
                ctx.fillStyle = "rgba(15, 20, 30, 0.35)"
            ctx.beginPath()
            ctx.arc(x, y, r, 0, Math.PI * 2)
            ctx.fill()

        create craters as [ {x: 310, y: 380, r: 26, rays: true}, {x: 430, y: 140, r: 20, rays: false}, {x: 560, y: 190, r: 18, rays: false}, {x: 790, y: 260, r: 22, rays: false}, {x: 210, y: 180, r: 17, rays: false}, {x: 890, y: 380, r: 24, rays: false} ]
        for cr in craters:
            if cr.rays == true:
                ctx.strokeStyle = "rgba(255, 255, 255, 0.4)"
                ctx.lineWidth = 1.5
                repeat 14 times:
                    create angle as (Math.random()) * Math.PI * 2
                    ctx.beginPath()
                    ctx.moveTo(cr.x, cr.y)
                    ctx.lineTo(cr.x + Math.cos(angle) * 180, cr.y + Math.sin(angle) * 180)
                    ctx.stroke()
            ctx.fillStyle = "rgba(12, 16, 24, 0.85)"
            ctx.beginPath()
            ctx.arc(cr.x, cr.y, cr.r, 0, Math.PI * 2)
            ctx.fill()
            ctx.strokeStyle = "rgba(255, 255, 255, 0.8)"
            ctx.lineWidth = 3
            ctx.stroke()

        create tex as new THREE.CanvasTexture(c)
        return tex

    # Main 3D Scene Initialization
    to do init3D:
        if typeof THREE == "undefined":
            after 150 ms:
                call init3D
            return

        create canvas as get element "webgl-canvas"
        if !canvas:
            after 150 ms:
                call init3D
            return

        create scene as new THREE.Scene()
        create camera as new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000)
        create renderer as new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true })
        renderer.setSize(window.innerWidth, window.innerHeight)
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))

        # Ambient & Sun Point Lighting
        create ambientLight as new THREE.AmbientLight("#475569", 0.65)
        scene.add(ambientLight)

        create sunLight as new THREE.PointLight("#ffeedd", 2.2, 80)
        sunLight.position.set(7.0, 3.5, -4.5)
        scene.add(sunLight)

        # 3D Deep Space Starfield
        create particlesCount as 2500
        create positions as new Float32Array(particlesCount * 3)
        create colors as new Float32Array(particlesCount * 3)

        repeat 2500 times:
            create i as (Math.floor(Math.random() * 2500)) * 3
            positions[i] = (Math.random() - 0.5) * 45
            positions[i + 1] = (Math.random() - 0.5) * 45
            positions[i + 2] = (Math.random() - 0.5) * 45
            create rChoice as Math.random()
            if rChoice < 0.45:
                colors[i] = 0.0
                colors[i + 1] = 0.95
                colors[i + 2] = 1.0
            else if rChoice < 0.8:
                colors[i] = 0.7
                colors[i + 1] = 0.35
                colors[i + 2] = 1.0
            else:
                colors[i] = 1.0
                colors[i + 1] = 0.85
                colors[i + 2] = 0.4

        create particlesGeometry as new THREE.BufferGeometry()
        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3))
        particlesGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3))
        create particlesMaterial as new THREE.PointsMaterial({ size: 0.11, vertexColors: true, transparent: true, opacity: 0.85 })
        create particlesMesh as new THREE.Points(particlesGeometry, particlesMaterial)
        scene.add(particlesMesh)

        # 3D Sun with Solar Coronas
        create sunTex as createSunTexture()
        create sunGeo as new THREE.SphereGeometry(2.5, 64, 64)
        create sunMat as new THREE.MeshBasicMaterial({ map: sunTex })
        create sunMesh as new THREE.Mesh(sunGeo, sunMat)
        sunMesh.position.set(7.0, 3.5, -5.5)
        scene.add(sunMesh)

        create sunCoronaGeo1 as new THREE.SphereGeometry(2.78, 32, 32)
        create sunCoronaMat1 as new THREE.MeshBasicMaterial({ color: "#ff8800", transparent: true, opacity: 0.45, blending: THREE.AdditiveBlending })
        create sunCorona1 as new THREE.Mesh(sunCoronaGeo1, sunCoronaMat1)
        sunMesh.add(sunCorona1)

        create sunCoronaGeo2 as new THREE.SphereGeometry(3.3, 32, 32)
        create sunCoronaMat2 as new THREE.MeshBasicMaterial({ color: "#ffbb00", transparent: true, opacity: 0.22, blending: THREE.AdditiveBlending })
        create sunCorona2 as new THREE.Mesh(sunCoronaGeo2, sunCoronaMat2)
        sunMesh.add(sunCorona2)

        # 3D Moon with Atmospheric Halo and Orbital Ring
        create moonTex as createMoonTexture()
        create moonGeo as new THREE.SphereGeometry(1.75, 64, 64)
        create moonMat as new THREE.MeshStandardMaterial({ map: moonTex, roughness: 0.85, metalness: 0.1 })
        create moonMesh as new THREE.Mesh(moonGeo, moonMat)
        moonMesh.position.set(-6.8, -1.8, -5.0)
        scene.add(moonMesh)

        create moonHaloGeo as new THREE.SphereGeometry(1.9, 32, 32)
        create moonHaloMat as new THREE.MeshBasicMaterial({ color: "#38bdf8", transparent: true, opacity: 0.2, blending: THREE.AdditiveBlending })
        create moonHalo as new THREE.Mesh(moonHaloGeo, moonHaloMat)
        moonMesh.add(moonHalo)

        create ringGeo as new THREE.TorusGeometry(2.6, 0.04, 16, 100)
        create ringMat as new THREE.MeshBasicMaterial({ color: "#00f2fe", transparent: true, opacity: 0.35 })
        create ringMesh as new THREE.Mesh(ringGeo, ringMat)
        ringMesh.rotation.x = Math.PI / 2.5
        ringMesh.rotation.y = Math.PI / 6
        moonMesh.add(ringMesh)

        # Distant Cyber Floating Wireframes
        create geom1 as new THREE.IcosahedronGeometry(1.4, 1)
        create mat1 as new THREE.MeshBasicMaterial({ color: "#00f2fe", wireframe: true, transparent: true, opacity: 0.25 })
        create poly1 as new THREE.Mesh(geom1, mat1)
        poly1.position.set(2.0, -3.8, -7.0)
        scene.add(poly1)

        create geom2 as new THREE.TorusKnotGeometry(1.2, 0.3, 64, 8)
        create mat2 as new THREE.MeshBasicMaterial({ color: "#a855f7", wireframe: true, transparent: true, opacity: 0.2 })
        create poly2 as new THREE.Mesh(geom2, mat2)
        poly2.position.set(-2.5, 3.8, -8.0)
        scene.add(poly2)

        camera.position.z = 7

        to do render3DScene:
            requestAnimationFrame(render3DScene)
            orbitTime = orbitTime + 0.008

            targetX = targetX + (mouseX - targetX) * 0.05
            targetY = targetY + (mouseY - targetY) * 0.05

            particlesMesh.rotation.y = particlesMesh.rotation.y + 0.0008
            particlesMesh.rotation.x = particlesMesh.rotation.x + 0.0004

            # Sun Dynamic Plasma Shift & Rotation
            sunMesh.rotation.y = sunMesh.rotation.y + 0.005
            sunMesh.rotation.x = sunMesh.rotation.x + 0.002
            sunCorona1.rotation.y = sunCorona1.rotation.y - 0.008
            sunCorona2.rotation.z = sunCorona2.rotation.z + 0.004
            sunTex.offset.x = (sunTex.offset.x + 0.001) % 1

            sunMesh.position.x = 7.0 + targetX * 1.6
            sunMesh.position.y = 3.5 - targetY * 1.6 + Math.sin(orbitTime) * 0.25
            sunLight.position.copy(sunMesh.position)

            # Moon Dynamic Rotation & Gentle Orbit
            moonMesh.rotation.y = moonMesh.rotation.y + 0.004
            ringMesh.rotation.z = ringMesh.rotation.z + 0.01
            moonMesh.position.x = -6.8 + targetX * 1.4
            moonMesh.position.y = -1.8 - targetY * 1.4 + Math.cos(orbitTime) * 0.2

            # Background Wireframes
            poly1.rotation.x = poly1.rotation.x + 0.008
            poly1.rotation.y = poly1.rotation.y + 0.012
            poly2.rotation.x = poly2.rotation.x - 0.006
            poly2.rotation.y = poly2.rotation.y + 0.009

            camera.position.x = targetX * 0.7
            camera.position.y = -targetY * 0.7
            camera.lookAt(scene.position)

            renderer.render(scene, camera)

        call render3DScene

    when "window" is moved:
        mouseX = (event.clientX / window.innerWidth - 0.5) * 2
        mouseY = (event.clientY / window.innerHeight - 0.5) * 2

    when "window" is resized:
        camera.aspect = window.innerWidth / window.innerHeight
        camera.updateProjectionMatrix()
        renderer.setSize(window.innerWidth, window.innerHeight)

    # Trigger Init
    call init3D

    # Toast Notification Helper in Pure Enlgs
    to do showToast with message:
        set text of "toast-alert" to message
        show element "toast-alert"
        after 3 seconds:
            hide element "toast-alert"

    # Button Event Handlers in Pure Enlgs
    when "btn-copy-phone" is clicked:
        copy "8260350182"
        call showToast with "📞 Phone number copied: 8260350182"

    when "btn-copy-email" is clicked:
        copy "prayaskumarsahoo45@gmail.com"
        call showToast with "✉️ Email copied: prayaskumarsahoo45@gmail.com"

    # Terminal Code Simulation
    define codeSnippets as [ "// [1] Booting Spring Boot 3.2.0 Microservice...", "@RestController @RequestMapping(\"/api/v1/lms\")\npublic class CourseEnrollmentController {\n    @Autowired private EnrollmentService service;\n    @PostMapping(\"/enroll\")\n    public ResponseEntity<ApiResponse> enrollStudent(@Valid @RequestBody StudentDTO dto) {\n        return ResponseEntity.ok(service.processEnrollment(dto));\n    }\n}", "// [2] Connecting Oracle & MySQL Production Clusters...\n[DB POOL] HikariCP initialized (10 active connections, latency 1.2ms)\n[AUTH] Spring Security JWT Filter Chain Active [200 OK]", "// [3] Running Payroll Calculation Engine...\n[PAYROLL ENGINE] Tax brackets calculated. Stored procedure executed successfully.\nStatus: ALL SYSTEMS OPERATIONAL (Java 21 Virtual Threads Enabled)" ]

    to do advanceTerminal:
        set terminalStep = (terminalStep + 1) % 4
        set text of "terminal-output" to codeSnippets[terminalStep]
        call showToast with "💻 Loaded Backend Module [" + (terminalStep + 1) + "/4]"

    when "btn-term-next" is clicked:
        call advanceTerminal

    # Contact Form Submission
    when "contact-form" is submitted:
        prevent default
        create senderName as get value of "contact-name"
        create senderEmail as get value of "contact-email"
        create senderMsg as get value of "contact-message"
        if senderName == "":
            alert "Please enter your name"
            return
        if senderEmail == "":
            alert "Please enter your email"
            return
        call showToast with "🚀 Message sent! Thanks " + senderName + ", Prayas will reply soon."
        set text of "contact-status" to "✅ Inquiry submitted successfully. Thank you!"
        set value of "contact-name" to ""
        set value of "contact-email" to ""
        set value of "contact-message" to ""

    # Live Clock in Footer
    every 1 second:
        refresh "live-clock" with "Engine Active • Asia/Kolkata • " + new Date().toLocaleTimeString()

    show "⚡ 3D Sun & Moon Celestial Scene is 100% Active in Pure Enlang Script (.enlgs)!"
