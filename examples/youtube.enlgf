document enlgf:
    head:
        title "YouTube — Watch, Stream and Share"
        connect design youtube.enlgd
        connect script youtube.enlgs

    body:
        div class "yt-app":
            # ── Top Navigation Bar ──
            header class "yt-header":
                div class "yt-header-left":
                    button "☰" id "btn-sidebar-toggle" class "yt-icon-btn" title "Guide"
                    div class "yt-logo" id "btn-logo" title "YouTube Home":
                        span "▶" class "yt-logo-icon"
                        span "YouTube" class "yt-logo-text"
                        span "IN" class "yt-country"

                div class "yt-header-center":
                    div class "yt-search-box":
                        input type "text" id "search-input" placeholder "Search across all of YouTube or paste YouTube URL / Video ID..." class "yt-search-input"
                        button "🔍" id "btn-search" class "yt-search-btn" title "Search"
                    button "🎙️" id "btn-voice" class "yt-icon-btn voice-btn" title "Search with your voice"

                div class "yt-header-right":
                    button "＋ Create" id "btn-create" class "yt-btn-create" title "Create or upload video"
                    button "🔔" id "btn-notif" class "yt-icon-btn notif-btn" title "Notifications":
                        span "3" class "notif-badge"
                    button "☾" id "btn-theme" class "yt-icon-btn" title "Appearance: Dark / Light"
                    div "S" class "yt-user-avatar" id "user-profile" title "Spandan Prayas Patra"

            # ── Main Layout: Sidebar + Multi-View Content ──
            div class "yt-main-layout":
                # Left Navigation Sidebar
                aside class "yt-sidebar" id "yt-sidebar":
                    div class "sidebar-section":
                        button "🏠 Home" id "nav-home" class "sidebar-item active"
                        button "⚡ Shorts" id "nav-shorts" class "sidebar-item"
                        button "📺 Subscriptions" id "nav-subs" class "sidebar-item"

                    div class "sidebar-divider"

                    div class "sidebar-section":
                        p "YOU" class "sidebar-heading"
                        button "📁 Library" id "nav-library" class "sidebar-item"
                        button "🕒 History" id "nav-history" class "sidebar-item"
                        button "🎬 Your Videos" id "nav-your-videos" class "sidebar-item"
                        button "⏱️ Watch Later" id "nav-watch-later" class "sidebar-item"
                        button "👍 Liked Videos" id "nav-liked" class "sidebar-item"

                    div class "sidebar-divider"

                    div class "sidebar-section":
                        p "SUBSCRIPTIONS" class "sidebar-heading"
                        div class "sub-channel" id "sub-1":
                            span "☕" class "channel-icon"
                            span "Java & Spring Master" class "channel-name"
                        div class "sub-channel" id "sub-2":
                            span "🚀" class "channel-icon"
                            span "Enlang Official" class "channel-name"
                        div class "sub-channel" id "sub-3":
                            span "⚛️" class "channel-icon"
                            span "Next.js & React Pro" class "channel-name"
                        div class "sub-channel" id "sub-4":
                            span "🪐" class "channel-icon"
                            span "Three.js Creative 3D" class "channel-name"
                        div class "sub-channel" id "sub-5":
                            span "⚡" class "channel-icon"
                            span "MrBeast" class "channel-name"

                    div class "sidebar-divider"

                    div class "sidebar-section":
                        p "EXPLORE" class "sidebar-heading"
                        button "🔥 Trending" id "nav-trending" class "sidebar-item"
                        button "🎵 Music" id "nav-music" class "sidebar-item"
                        button "🎮 Gaming" id "nav-gaming" class "sidebar-item"
                        button "📰 News" id "nav-news" class "sidebar-item"
                        button "🏆 Sports" id "nav-sports" class "sidebar-item"

                # Central Multi-View Panel
                section class "yt-content":
                    # 1. Main Video Feed Panel
                    div id "view-feed" class "view-panel active":
                        # Category Chips Bar
                        nav class "category-bar":
                            button "All" id "chip-all" class "chip active"
                            button "Coding & AI" id "chip-coding" class "chip"
                            button "Java Backend" id "chip-java" class "chip"
                            button "Spring Boot" id "chip-spring" class "chip"
                            button "Enlang Stack" id "chip-enlang" class "chip"
                            button "System Design" id "chip-sysdesign" class "chip"
                            button "Next.js" id "chip-next" class "chip"
                            button "Cloudflare Edge" id "chip-edge" class "chip"
                            button "Lo-Fi Music" id "chip-music" class "chip"
                            button "Gaming" id "chip-gaming" class "chip"
                            button "Science & Tech" id "chip-science" class "chip"
                            button "Podcasts" id "chip-podcasts" class "chip"

                        # Real-time Status Banner
                        div class "feed-status-bar":
                            span "🔴 Infinite Real YouTube Feed" id "live-status-title" class "live-indicator"
                            span "Real-time YouTube Streaming • 100% Real Live Catalog" id "live-status-desc" class "live-subtext"

                        # Dynamic Video Cards Grid
                        div class "video-grid" id "video-grid-container"

                        # Shorts Shelf on Home
                        div class "shorts-shelf":
                            div class "shorts-header":
                                span "⚡" class "shorts-icon"
                                h3 "Shorts" class "shorts-title"
                            div class "shorts-grid":
                                div class "short-card" id "short-shelf-1":
                                    div class "short-thumb":
                                        img src "https://i.ytimg.com/vi/gJrjgg1KVL4/hqdefault.jpg" class "short-img"
                                        span "🔥 3 Java Performance Hacks" class "short-overlay-title"
                                    p "3.2M views" class "short-views"
                                div class "short-card" id "short-shelf-2":
                                    div class "short-thumb":
                                        img src "https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg" class "short-img"
                                        span "🚀 Enlang 100% Native Output" class "short-overlay-title"
                                    p "1.8M views" class "short-views"
                                div class "short-card" id "short-shelf-3":
                                    div class "short-thumb":
                                        img src "https://i.ytimg.com/vi/8aGhZQkoFbQ/hqdefault.jpg" class "short-img"
                                        span "🌐 Cloudflare 0ms Latency" class "short-overlay-title"
                                    p "950K views" class "short-views"
                                div class "short-card" id "short-shelf-4":
                                    div class "short-thumb":
                                        img src "https://i.ytimg.com/vi/Q7AOvWpIVHU/hqdefault.jpg" class "short-img"
                                        span "✨ Raymarched 3D Shaders" class "short-overlay-title"
                                    p "2.4M views" class "short-views"

                        # Infinite Load More Trigger
                        div class "infinite-loading-bar":
                            button "Load More Videos" id "btn-load-more" class "btn-load-more"

                    # 2. Shorts Fullscreen Player Panel
                    div id "view-shorts" class "view-panel":
                        div class "shorts-reel-container":
                            div class "shorts-reel-viewport":
                                div class "shorts-video-box" id "shorts-active-box":
                                    iframe id "shorts-iframe" class "shorts-embed-frame" src "about:blank" allow "autoplay; encrypted-media; picture-in-picture" allowfullscreen "true"
                                    div class "shorts-top-bar":
                                        span "⚡ YouTube Shorts" class "shorts-brand-tag"
                                        button "🔇" id "btn-shorts-mute" class "shorts-ctrl-icon"
                                    div class "shorts-bottom-overlay":
                                        div class "shorts-creator-row":
                                            div "S" class "shorts-avatar"
                                            span "@SpandanPrayas" id "shorts-author-name" class "shorts-username"
                                            button "Subscribe" id "btn-shorts-sub" class "btn-shorts-sub"
                                        p "🔥 3 Insane Java 21 Performance Hacks you never knew existed! #Java #SpringBoot #Dev" id "shorts-title-text" class "shorts-desc"
                                        div class "shorts-music-row":
                                            span "🎵 Spandan Original Audio • High Performance Remix" id "shorts-audio-text"
                                div class "shorts-action-rail":
                                    button id "btn-shorts-like" class "shorts-rail-btn":
                                        span "👍"
                                        span "245K" id "shorts-like-count" class "rail-count"
                                    button id "btn-shorts-dislike" class "shorts-rail-btn":
                                        span "👎"
                                        span "Dislike" class "rail-count"
                                    button id "btn-shorts-comment" class "shorts-rail-btn":
                                        span "💬"
                                        span "4.2K" class "rail-count"
                                    button id "btn-shorts-share" class "shorts-rail-btn":
                                        span "↗"
                                        span "Share" class "rail-count"
                                    button id "btn-shorts-more" class "shorts-rail-btn":
                                        span "⋯"
                                        span "More" class "rail-count"
                                    div class "shorts-sound-disc"
                                div class "shorts-nav-arrows":
                                    button "▲" id "btn-shorts-prev" class "shorts-arrow-btn" title "Previous Short"
                                    button "▼" id "btn-shorts-next" class "shorts-arrow-btn" title "Next Short"

                    # 3. Watch Video Page Panel
                    div id "view-watch" class "view-panel":
                        div class "watch-layout":
                            # Left Primary Column
                            div class "watch-primary":
                                # Player Container with Ambient Backlight
                                div class "ambient-glow-wrapper":
                                    div class "ambient-backlight" id "player-ambient-light"
                                    div class "video-player-container":
                                        div class "player-screen" id "main-player-screen":
                                            iframe id "player-iframe" class "yt-embed-frame" src "about:blank" allow "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen "true"
                                        # Native-Styled Video Controls Bar
                                        div class "player-controls":
                                            button "⏸" id "btn-player-play" class "ctrl-btn" title "Play/Pause (k)"
                                            button "⏭" id "btn-player-next" class "ctrl-btn" title "Next video (Shift+N)"
                                            div class "volume-group":
                                                button "🔊" id "btn-player-mute" class "ctrl-btn" title "Mute (m)"
                                                input type "range" min "0" max "100" value "100" class "vol-slider" id "player-volume"
                                            span "04:18 / 71:22" id "player-time-display" class "ctrl-time"
                                            div class "scrubber-bar" id "player-scrubber":
                                                div class "scrubber-fill" id "scrubber-progress" style "width: 15%;"
                                            button "CC" id "btn-player-cc" class "ctrl-btn" title "Subtitles/Closed Captions (c)"
                                            button "1x" id "btn-player-speed" class "ctrl-btn" title "Playback Speed"
                                            button "⚙️ 1080p" id "btn-player-quality" class "ctrl-btn" title "Quality (1080p HD)"
                                            button "⛶" id "btn-player-fullscreen" class "ctrl-btn" title "Full screen (f)"

                                # Video Title & Creator Row
                                div class "watch-header":
                                    h1 "Spring Boot 3 Full Course 2025 - Beginner to Pro" id "watch-video-title" class "watch-title"
                                    div class "watch-actions-row":
                                        div class "channel-info-box":
                                            div "S" id "watch-channel-avatar" class "channel-avatar-lg"
                                            div class "channel-details":
                                                h3 "Spandan Prayas Patra" id "watch-channel-name" class "channel-title"
                                                p "128K subscribers" id "watch-channel-subs" class "channel-subs"
                                            button "Join" id "btn-join" class "btn-join"
                                            button "Subscribe" id "btn-subscribe" class "btn-subscribe"
                                        div class "action-buttons-group":
                                            div class "like-dislike-pill":
                                                button "👍 142K" id "btn-like" class "btn-like"
                                                div class "pill-sep"
                                                button "👎" id "btn-dislike" class "btn-dislike"
                                            button "↗ Share" id "btn-share" class "btn-action"
                                            button "⬇ Download" id "btn-download" class "btn-action"
                                            button "✂ Clip" id "btn-clip" class "btn-action"
                                            button "⋯ More" id "btn-more" class "btn-action"

                                # Video Description Box & Chapters
                                div class "watch-description-box":
                                    p "1,039,987 views • Premiered on Aug 15, 2026" id "desc-stats" class "desc-stats"
                                    p "In this deep dive tutorial, Spandan Prayas Patra walks through architecting mission-critical Java 21 backend microservices, configuring HikariCP connection pools for Oracle & MySQL, and applying strict ACID transaction management." id "watch-desc-text" class "desc-content"
                                    div class "chapters-section":
                                        p "TIMESTAMPS & CHAPTERS (Click to jump):" class "chapters-title"
                                        div class "chapter-pill-list" id "chapters-container":
                                            button "00:00 • Introduction" id "ch-1" class "chapter-btn"
                                            button "04:15 • Setup" id "ch-2" class "chapter-btn"
                                            button "09:30 • Core Logic" id "ch-3" class "chapter-btn"
                                            button "14:00 • Benchmarks" id "ch-4" class "chapter-btn"

                                # Real-time Public Comments
                                div class "comments-container":
                                    div class "comments-header":
                                        h3 "328 Comments" id "comments-count-header"
                                        span "𝄘 Sort by" id "btn-sort-comments" class "sort-tag"
                                    div class "add-comment-row":
                                        div "S" class "user-avatar-sm"
                                        div class "comment-input-wrap":
                                            input type "text" id "new-comment-input" placeholder "Add a comment..." class "comment-input"
                                            div class "comment-btn-bar":
                                                button "Cancel" id "btn-cancel-comment" class "btn-ghost"
                                                button "Comment" id "btn-submit-comment" class "btn-primary"
                                    div class "comment-list" id "comment-list-container"

                            # Right Secondary Column: Up Next Recommendations
                            aside class "watch-secondary":
                                div class "rec-header-row":
                                    h3 "Up Next" class "rec-header"
                                    div class "autoplay-toggle-wrap":
                                        span "Autoplay" class "autoplay-label"
                                        input type "checkbox" checked "true" id "toggle-autoplay"
                                div class "rec-list" id "rec-list-container"

                    # 4. Subscriptions Feed Panel
                    div id "view-subs" class "view-panel":
                        h2 "Latest from Your Subscriptions" class "library-heading"
                        div class "subs-channel-stories" id "subs-channels-row"
                        div class "video-grid" id "subs-grid-container"

                    # 5. Library & Watch History Panel
                    div id "view-library" class "view-panel":
                        h2 "Library & Watch History" class "library-heading"
                        div class "library-section-block":
                            button "Clear History" id "btn-clear-history" class "btn-ghost"
                            h3 "🕒 Recently Watched" class "library-subheading"
                            div class "history-list" id "history-list-container"
                        div class "library-section-block":
                            h3 "⏱️ Watch Later" class "library-subheading"
                            div class "video-grid" id "watch-later-container"
                        div class "library-section-block":
                            h3 "👍 Liked Videos" class "library-subheading"
                            div class "video-grid" id "liked-videos-container"

                    # 6. Trending View Panel
                    div id "view-trending" class "view-panel":
                        h2 "🔥 Trending on YouTube (India & World)" class "trending-heading"
                        div class "trending-tabs":
                            button "Now" id "tab-trend-now" class "tab-btn active"
                            button "Music" id "tab-trend-music" class "tab-btn"
                            button "Gaming" id "tab-trend-gaming" class "tab-btn"
                            button "Films" id "tab-trend-films" class "tab-btn"
                        div class "trending-list" id "trending-list-container"

            # ── Profile Menu Dropdown ──
            div class "profile-dropdown" id "dropdown-profile":
                div class "profile-dropdown-header":
                    div "S" class "yt-user-avatar"
                    div class "profile-header-meta":
                        h4 "Spandan Prayas Patra" class "profile-name"
                        p "@SpandanPrayas" class "profile-handle"
                div class "profile-divider"
                button "👤 Your channel" id "btn-profile-channel" class "profile-menu-item"
                button "⚙️ YouTube Studio" id "btn-profile-studio" class "profile-menu-item"
                button "🔄 Switch account" id "btn-profile-switch" class "profile-menu-item"
                button "🚪 Sign out" id "btn-profile-signout" class "profile-menu-item"
                div class "profile-divider"
                button "🌓 Appearance: Dark/Light" id "btn-profile-appearance" class "profile-menu-item"
                button "🌐 Location: India" id "btn-profile-location" class "profile-menu-item"

            # ── Modals & Notifications Dropdown ──
            div class "yt-modal" id "modal-create":
                div class "modal-box":
                    div class "modal-header":
                        h3 "Upload Video" class "modal-title"
                        button "✕" id "btn-close-create" class "modal-close-btn"
                    div class "modal-body":
                        div class "upload-drop-zone":
                            span "☁️" class "upload-icon-huge"
                            p "Drag and drop video files to upload" class "upload-hint"
                        div class "upload-form":
                            input type "text" id "upload-title-input" placeholder "Title (required)" class "modal-input"
                            textarea id "upload-desc-input" placeholder "Tell viewers about your video..." class "modal-textarea"
                    div class "modal-footer":
                        button "Cancel" id "btn-cancel-upload" class "btn-ghost"
                        button "Publish" id "btn-publish-video" class "btn-primary"

            div class "yt-modal" id "modal-share":
                div class "modal-box":
                    div class "modal-header":
                        h3 "Share Video" class "modal-title"
                        button "✕" id "btn-close-share" class "modal-close-btn"
                    div class "modal-body":
                        div class "share-social-grid":
                            button "WhatsApp" class "social-btn"
                            button "Twitter / X" class "social-btn"
                            button "Facebook" class "social-btn"
                            button "Reddit" class "social-btn"
                            button "Email" class "social-btn"
                        div class "share-link-row":
                            input type "text" id "share-link-input" readonly "true" value "https://youtu.be/gJrjgg1KVL4" class "share-link-box"
                            button "Copy" id "btn-copy-share" class "btn-primary"

            div class "notif-dropdown" id "dropdown-notif":
                div class "notif-header":
                    h4 "Notifications" class "notif-title"
                    button "⚙️" class "notif-opt-btn"
                div class "notif-list":
                    div class "notif-item unread":
                        div "S" class "user-avatar-sm"
                        div class "notif-content":
                            p "Spandan Prayas Patra uploaded: Spring Boot 3 Full Course 2025" class "notif-msg"
                            span "1 hour ago" class "notif-time"
                    div class "notif-item unread":
                        div "J" class "user-avatar-sm"
                        div class "notif-content":
                            p "JavaScript Mastery uploaded: Next.js 15 & React 19 Full Stack" class "notif-msg"
                            span "3 hours ago" class "notif-time"
                    div class "notif-item":
                        div "R" class "user-avatar-sm"
                        div class "notif-content":
                            p "Rockstar Games premiered: GTA VI Official Trailer 1" class "notif-msg"
                            span "1 day ago" class "notif-time"

            # Bottom Toast Alert Banner
            div class "yt-toast" id "yt-toast"
