import numpy
import matplotlib.pyplot

display "--- Generating Gaussian Membership Function (MF) Plot ---"

# 1. Create X range from -5.0 to 5.0 with 200 data points
declare x = call linspace with -5, 5, 200 from numpy

# 2. Gaussian MF parameters (Mean = 0.0, Sigma = 1.0)
declare mean_val = 0
declare sigma_val = 1

# 3. Calculate Gaussian MF: exp( -0.5 * ((x - mean) / sigma)^2 )
declare diff = x - mean_val
declare ratio = diff / sigma_val
declare sq = ratio * ratio
declare factor = -0.5
declare exponent = factor * sq
declare y = call exp with exponent from numpy

# 4. Plot using Matplotlib (Pattern 1: from matplotlib.pyplot)
call plot with x, y from matplotlib.pyplot
call title with "Gaussian Membership Function (mean=0, sigma=1)" from matplotlib.pyplot
call xlabel with "x" from matplotlib.pyplot
call ylabel with "Degree of Membership" from matplotlib.pyplot
call grid with true from matplotlib.pyplot

# 5. Save the generated plot image
call savefig with "gaussian_mf.png" from matplotlib.pyplot

display "Gaussian MF plot successfully generated and saved to gaussian_mf.png!"
