# Enlang Design (.enlgd) - YouTube 1:1 Complete Platform Theme

define color "yt-bg" as "#0f0f0f"
define color "yt-header-bg" as "#0f0f0f"
define color "yt-surface" as "#272727"
define color "yt-surface-hover" as "#383838"
define color "yt-hover" as "rgba(255, 255, 255, 0.1)"
define color "yt-text" as "#f1f1f1"
define color "yt-muted" as "#aaaaaa"
define color "yt-red" as "#ff0000"
define color "yt-blue" as "#3ea6ff"
define color "yt-border" as "rgba(255, 255, 255, 0.1)"

for "body" apply:
    margin 0
    padding 0
    background use color "yt-bg"
    color use color "yt-text"
    font-family "YouTube Sans, Roboto, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif"
    min-height 100 viewport-height
    line-height 1.4
    overflow-x hidden
end

# ── Complete Light Mode (White Theme) Overrides ──
for "body.light-theme" apply:
    background "#ffffff"
    color "#0f0f0f"
end

for "body.light-theme .yt-app" apply:
    background "#ffffff"
end

for "body.light-theme .yt-header" apply:
    background "#ffffff"
    border-bottom "1px solid #e5e5e5"
end

for "body.light-theme .yt-logo-text" apply:
    color "#0f0f0f"
end

for "body.light-theme .yt-icon-btn" apply:
    color "#0f0f0f"
end

for "body.light-theme .yt-search-box" apply:
    background "#ffffff"
    border "1px solid #cccccc"
end

for "body.light-theme .yt-search-input" apply:
    color "#0f0f0f"
end

for "body.light-theme .yt-search-btn" apply:
    background "#f8f8f8"
    border-left "1px solid #cccccc"
    color "#0f0f0f"
end

for "body.light-theme .yt-sidebar" apply:
    background "#ffffff"
    border-right "1px solid #e5e5e5"
end

for "body.light-theme .sidebar-item" apply:
    color "#0f0f0f"
end

for "body.light-theme .sidebar-item:hover" apply:
    background "#f2f2f2"
end

for "body.light-theme .sidebar-item.active" apply:
    background "#f2f2f2"
    color "#0f0f0f"
    font-weight 600
end

for "body.light-theme .sub-channel" apply:
    color "#0f0f0f"
end

for "body.light-theme .sub-channel:hover" apply:
    background "#f2f2f2"
end

for "body.light-theme .sidebar-heading" apply:
    color "#606060"
end

for "body.light-theme .sidebar-divider" apply:
    background "#e5e5e5"
end

for "body.light-theme .chip" apply:
    background "#f2f2f2"
    color "#0f0f0f"
    border "1px solid #e5e5e5"
end

for "body.light-theme .chip.active" apply:
    background "#0f0f0f"
    color "#ffffff"
end

for "body.light-theme .video-title" apply:
    color "#0f0f0f"
end

for "body.light-theme .video-channel" apply:
    color "#606060"
end

for "body.light-theme .video-stats" apply:
    color "#606060"
end

for "body.light-theme .watch-title" apply:
    color "#0f0f0f"
end

for "body.light-theme .channel-title" apply:
    color "#0f0f0f"
end

for "body.light-theme .channel-subs" apply:
    color "#606060"
end

for "body.light-theme .desc-content" apply:
    color "#0f0f0f"
end

for "body.light-theme .desc-stats" apply:
    color "#0f0f0f"
end

for "body.light-theme .watch-description-box" apply:
    background "#f2f2f2"
    border "1px solid #e5e5e5"
end

for "body.light-theme .action-buttons-group .btn-action" apply:
    background "#f2f2f2"
    color "#0f0f0f"
end

for "body.light-theme .like-dislike-pill" apply:
    background "#f2f2f2"
end

for "body.light-theme .btn-like" apply:
    color "#0f0f0f"
end

for "body.light-theme .btn-dislike" apply:
    color "#0f0f0f"
end

for "body.light-theme .btn-subscribe" apply:
    background "#0f0f0f"
    color "#ffffff"
end

for "body.light-theme .btn-join" apply:
    background "#f2f2f2"
    color "#0f0f0f"
    border "1px solid #cccccc"
end

for "body.light-theme .comment-msg" apply:
    color "#0f0f0f"
end

for "body.light-theme .comment-author" apply:
    color "#0f0f0f"
end

for "body.light-theme .comment-input" apply:
    color "#0f0f0f"
    border-bottom "1px solid #cccccc"
end

for "body.light-theme .comments-header h3" apply:
    color "#0f0f0f"
end

for "body.light-theme .sort-tag" apply:
    color "#0f0f0f"
end

for "body.light-theme .rec-title" apply:
    color "#0f0f0f"
end

for "body.light-theme .rec-channel" apply:
    color "#606060"
end

for "body.light-theme .rec-stats" apply:
    color "#606060"
end

for "body.light-theme .history-title" apply:
    color "#0f0f0f"
end

for "body.light-theme .history-sub" apply:
    color "#606060"
end

for "body.light-theme .library-heading" apply:
    color "#0f0f0f"
end

for "body.light-theme .library-subheading" apply:
    color "#0f0f0f"
end

for "body.light-theme .trending-heading" apply:
    color "#0f0f0f"
end

for "body.light-theme .channel-story-name" apply:
    color "#0f0f0f"
end

for "body.light-theme .modal-box" apply:
    background "#ffffff"
    color "#0f0f0f"
    border "1px solid #cccccc"
end

for "body.light-theme .modal-title" apply:
    color "#0f0f0f"
end

for "body.light-theme .modal-input" apply:
    background "#ffffff"
    color "#0f0f0f"
    border "1px solid #cccccc"
end

for "body.light-theme .modal-textarea" apply:
    background "#ffffff"
    color "#0f0f0f"
    border "1px solid #cccccc"
end

for "body.light-theme .chapter-btn" apply:
    background "#ffffff"
    color "#0f0f0f"
    border "1px solid #cccccc"
end

for "body.light-theme .chapter-btn:hover" apply:
    background "#e5e5e5"
end

for "body.light-theme .notif-dropdown" apply:
    background "#ffffff"
    color "#0f0f0f"
    border "1px solid #cccccc"
end

for "body.light-theme .notif-title" apply:
    color "#0f0f0f"
end

for "body.light-theme .notif-msg" apply:
    color "#0f0f0f"
end

for "body.light-theme .profile-dropdown" apply:
    background "#ffffff"
    color "#0f0f0f"
    border "1px solid #cccccc"
end

for "body.light-theme .profile-name" apply:
    color "#0f0f0f"
end

for "body.light-theme .profile-menu-item" apply:
    color "#0f0f0f"
end

for "body.light-theme .profile-menu-item:hover" apply:
    background "#f2f2f2"
end

# ── General Structure & Components ──
for ".yt-app" apply:
    display flex
    flex-direction column
    min-height 100 viewport-height
    background use color "yt-bg"
end

for ".yt-header" apply:
    display flex
    align-items center
    justify-content space-between
    padding "0 16px"
    height "56px"
    position sticky
    top 0
    z-index 1000
    background use color "yt-header-bg"
    border-bottom "1px solid rgba(255, 255, 255, 0.08)"
    box-sizing border-box
end

for ".yt-header-left" apply:
    display flex
    align-items center
    gap "16px"
end

for ".yt-icon-btn" apply:
    background transparent
    border none
    color use color "yt-text"
    font-size "18px"
    cursor pointer
    width "40px"
    height "40px"
    border-radius "50%"
    display flex
    align-items center
    justify-content center
    transition "background 0.2s ease"
end

for ".yt-icon-btn:hover" apply:
    background use color "yt-hover"
end

for ".yt-logo" apply:
    display flex
    align-items center
    gap "4px"
    cursor pointer
    user-select none
end

for ".yt-logo-icon" apply:
    color "#ff0000"
    font-size "22px"
end

for ".yt-logo-text" apply:
    font-size "18px"
    font-weight 700
    letter-spacing "-0.5px"
    color "#ffffff"
end

for ".yt-country" apply:
    font-size "10px"
    color "#aaaaaa"
    margin-top "-10px"
end

for ".yt-header-center" apply:
    display flex
    align-items center
    gap "12px"
    flex "0 1 680px"
    justify-content center
end

for ".yt-search-box" apply:
    display flex
    align-items center
    width 100 percent
    max-width "560px"
    height "40px"
    background "#121212"
    border "1px solid #303030"
    border-radius "40px"
    overflow hidden
end

for ".yt-search-input" apply:
    flex 1
    height 100 percent
    padding "0 16px"
    background transparent
    border none
    color "#ffffff"
    font-size "15px"
    outline none
end

for ".yt-search-btn" apply:
    width "64px"
    height 100 percent
    background "#222222"
    border none
    border-left "1px solid #303030"
    color "#ffffff"
    cursor pointer
    font-size "16px"
end

for ".yt-header-right" apply:
    display flex
    align-items center
    gap "8px"
end

for ".yt-btn-create" apply:
    display flex
    align-items center
    gap "6px"
    height "36px"
    padding "0 14px"
    border-radius "18px"
    background use color "yt-surface"
    border none
    color use color "yt-text"
    font-size "14px"
    font-weight 600
    cursor pointer
end

for ".yt-btn-create:hover" apply:
    background use color "yt-surface-hover"
end

for ".notif-badge" apply:
    position absolute
    top "4px"
    right "4px"
    background "#cc0000"
    color "#ffffff"
    font-size "10px"
    font-weight 700
    padding "1px 5px"
    border-radius "10px"
end

for ".yt-user-avatar" apply:
    width "34px"
    height "34px"
    border-radius "50%"
    background "#8b5cf6"
    color "#ffffff"
    display flex
    align-items center
    justify-content center
    font-weight 700
    font-size "15px"
    cursor pointer
    user-select none
end

for ".yt-main-layout" apply:
    display flex
    flex 1
    position relative
    min-height "calc(100vh - 56px)"
end

# ── Sidebar ──
for ".yt-sidebar" apply:
    width "240px"
    background use color "yt-bg"
    padding "12px 12px"
    display flex
    flex-direction column
    gap "4px"
    position sticky
    top "56px"
    height "calc(100vh - 56px)"
    overflow-y auto
    box-sizing border-box
    flex-shrink 0
end

for ".sidebar-section" apply:
    display flex
    flex-direction column
    gap "2px"
end

for ".sidebar-heading" apply:
    font-size "12px"
    font-weight 700
    color use color "yt-muted"
    padding "8px 12px 4px"
    margin 0
    text-transform uppercase
    letter-spacing "0.5px"
end

for ".sidebar-item" apply:
    display flex
    align-items center
    gap "16px"
    padding "10px 12px"
    border-radius "10px"
    background transparent
    border none
    color use color "yt-text"
    font-size "14px"
    font-weight 500
    cursor pointer
    text-align left
    width 100 percent
    transition "background 0.15s ease"
end

for ".sidebar-item:hover" apply:
    background use color "yt-hover"
end

for ".sidebar-item.active" apply:
    background use color "yt-surface"
    font-weight 600
end

for ".sidebar-divider" apply:
    height "1px"
    background "rgba(255, 255, 255, 0.1)"
    margin "8px 0"
end

for ".sub-channel" apply:
    display flex
    align-items center
    gap "12px"
    padding "8px 12px"
    border-radius "10px"
    cursor pointer
    font-size "14px"
end

for ".sub-channel:hover" apply:
    background use color "yt-hover"
end

for ".channel-icon" apply:
    font-size "18px"
end

# ── Main Content & Panels ──
for ".yt-content" apply:
    flex 1
    padding "16px 24px"
    min-width 0
    box-sizing border-box
    overflow-y auto
end

for ".view-panel" apply:
    display none
end

for ".view-panel.active" apply:
    display block
end

# ── Category Chips Bar ──
for ".category-bar" apply:
    display flex
    gap "10px"
    overflow-x auto
    padding "4px 0 16px"
    scrollbar-width none
end

for ".chip" apply:
    padding "8px 14px"
    border-radius "8px"
    background use color "yt-surface"
    border none
    color use color "yt-text"
    font-size "14px"
    font-weight 500
    cursor pointer
    white-space nowrap
    transition "background 0.2s ease"
end

for ".chip:hover" apply:
    background use color "yt-surface-hover"
end

for ".chip.active" apply:
    background "#ffffff"
    color "#0f0f0f"
    font-weight 600
end

# ── Status Bar ──
for ".feed-status-bar" apply:
    display flex
    align-items center
    justify-content space-between
    padding "8px 16px"
    background "rgba(59, 130, 246, 0.1)"
    border "1px solid rgba(59, 130, 246, 0.25)"
    border-radius "10px"
    margin-bottom "16px"
end

for ".live-indicator" apply:
    font-size "13px"
    font-weight 700
    color "#60a5fa"
end

for ".live-subtext" apply:
    font-size "12px"
    color "#94a3b8"
end

# ── Video Grid & Cards ──
for ".video-grid" apply:
    display grid
    grid-template-columns "repeat(auto-fill, minmax(320px, 1fr))"
    gap "20px"
end

for ".video-card" apply:
    display flex
    flex-direction column
    gap "8px"
    cursor pointer
    transition "transform 0.2s ease"
end

for ".video-card:hover" apply:
    transform "translateY(-4px)"
end

for ".thumbnail-wrapper" apply:
    position relative
    width 100 percent
    aspect-ratio "16 / 9"
    border-radius "12px"
    overflow hidden
    background "#1a1a1a"
end

for ".thumb-real-img" apply:
    width 100 percent
    height 100 percent
    object-fit cover
    display block
end

for ".duration-badge" apply:
    position absolute
    bottom "8px"
    right "8px"
    background "rgba(0, 0, 0, 0.85)"
    color "#ffffff"
    font-size "12px"
    font-weight 600
    padding "2px 6px"
    border-radius "4px"
end

for ".video-meta" apply:
    display flex
    gap "12px"
    align-items flex-start
    margin-top "6px"
end

for ".channel-avatar" apply:
    width "36px"
    height "36px"
    border-radius "50%"
    background "#2563eb"
    color "#ffffff"
    display flex
    align-items center
    justify-content center
    font-weight 700
    font-size "14px"
    flex-shrink 0
    margin 0
end

for ".video-details" apply:
    display flex
    flex-direction column
    gap "4px"
    flex 1
    min-width 0
end

for ".video-title" apply:
    font-size "14px"
    font-weight 600
    color use color "yt-text"
    margin 0
    line-height 1.3
    display "-webkit-box"
    -webkit-line-clamp 2
    -webkit-box-orient vertical
    overflow hidden
end

for ".video-channel" apply:
    font-size "13px"
    color use color "yt-muted"
    margin 0
end

for ".video-stats" apply:
    font-size "12px"
    color use color "yt-muted"
    margin 0
end

# ── Shorts Shelf on Home ──
for ".shorts-shelf" apply:
    margin "32px 0"
    padding "16px 0"
    border-top "1px solid rgba(255, 255, 255, 0.1)"
    border-bottom "1px solid rgba(255, 255, 255, 0.1)"
end

for ".shorts-header" apply:
    display flex
    align-items center
    gap "8px"
    margin-bottom "16px"
end

for ".shorts-icon" apply:
    font-size "22px"
    color "#ff0000"
end

for ".shorts-title" apply:
    font-size "18px"
    font-weight 700
    margin 0
end

for ".shorts-grid" apply:
    display grid
    grid-template-columns "repeat(auto-fill, minmax(200px, 1fr))"
    gap "16px"
end

for ".short-card" apply:
    display flex
    flex-direction column
    gap "8px"
    cursor pointer
end

for ".short-thumb" apply:
    position relative
    width 100 percent
    aspect-ratio "9 / 16"
    border-radius "12px"
    overflow hidden
    background "#1e293b"
end

for ".short-img" apply:
    width 100 percent
    height 100 percent
    object-fit cover
    display block
end

for ".short-overlay-title" apply:
    position absolute
    bottom "10px"
    left "10px"
    right "10px"
    color "#ffffff"
    font-size "13px"
    font-weight 600
    text-shadow "0 2px 4px rgba(0,0,0,0.8)"
end

for ".short-views" apply:
    font-size "12px"
    color use color "yt-muted"
    margin 0
end

# ── Infinite Loading Bar ──
for ".infinite-loading-bar" apply:
    display flex
    justify-content center
    padding "24px 0"
end

for ".btn-load-more" apply:
    padding "12px 28px"
    border-radius "24px"
    background use color "yt-surface"
    border "1px solid rgba(255, 255, 255, 0.15)"
    color use color "yt-text"
    font-size "14px"
    font-weight 600
    cursor pointer
    transition "background 0.2s ease, transform 0.2s ease"
end

for ".btn-load-more:hover" apply:
    background use color "yt-surface-hover"
    transform "scale(1.02)"
end

# ── Watch Page Layout ──
for ".watch-layout" apply:
    display flex
    gap "24px"
    max-width "1700px"
    margin "0 auto"
end

for ".watch-primary" apply:
    flex "1 1 68%"
    min-width 0
end

for ".watch-secondary" apply:
    flex "0 0 380px"
    min-width "340px"
end

for ".ambient-glow-wrapper" apply:
    position relative
    width 100 percent
    border-radius "16px"
    overflow hidden
    margin-bottom "16px"
end

for ".ambient-backlight" apply:
    position absolute
    top 0
    left 0
    right 0
    bottom 0
    filter "blur(50px)"
    opacity 0.4
    z-index 0
    pointer-events none
end

for ".video-player-container" apply:
    position relative
    z-index 1
    background "#000000"
    border-radius "16px"
    overflow hidden
    box-shadow "0 8px 32px rgba(0, 0, 0, 0.5)"
end

for ".player-screen" apply:
    width 100 percent
    aspect-ratio "16 / 9"
    background "#000000"
end

for ".yt-embed-frame" apply:
    width 100 percent
    height 100 percent
    border none
    display block
end

for ".player-controls" apply:
    display flex
    align-items center
    gap "12px"
    padding "8px 16px"
    background "rgba(15, 15, 15, 0.95)"
    border-top "1px solid rgba(255, 255, 255, 0.08)"
end

for ".ctrl-btn" apply:
    background transparent
    border none
    color "#ffffff"
    font-size "15px"
    cursor pointer
    padding "6px 10px"
    border-radius "6px"
    transition "background 0.2s ease"
end

for ".ctrl-btn:hover" apply:
    background "rgba(255, 255, 255, 0.15)"
end

for ".volume-group" apply:
    display flex
    align-items center
    gap "6px"
end

for ".vol-slider" apply:
    width "70px"
    accent-color "#ff0000"
    cursor pointer
end

for ".ctrl-time" apply:
    font-size "12px"
    color "#aaaaaa"
    font-family monospace
end

for ".scrubber-bar" apply:
    flex 1
    height "8px"
    background "#444444"
    border-radius "4px"
    cursor pointer
    position relative
    overflow hidden
end

for ".scrubber-bar:hover" apply:
    height "10px"
end

for ".scrubber-fill" apply:
    height 100 percent
    background "#ff0000"
    border-radius "4px"
    pointer-events none
end

for ".watch-header" apply:
    margin-bottom "16px"
end

for ".watch-title" apply:
    font-size "20px"
    font-weight 700
    margin "0 0 12px 0"
    line-height 1.3
end

for ".watch-actions-row" apply:
    display flex
    align-items center
    justify-content space-between
    flex-wrap wrap
    gap "16px"
end

for ".channel-info-box" apply:
    display flex
    align-items center
    gap "12px"
end

for ".channel-avatar-lg" apply:
    width "44px"
    height "44px"
    border-radius "50%"
    background "#3b82f6"
    color "#ffffff"
    display flex
    align-items center
    justify-content center
    font-weight 700
    font-size "18px"
end

for ".channel-title" apply:
    font-size "15px"
    font-weight 700
    margin 0
end

for ".channel-subs" apply:
    font-size "12px"
    color use color "yt-muted"
    margin 0
end

for ".btn-join" apply:
    padding "8px 16px"
    border-radius "18px"
    background "rgba(255, 255, 255, 0.1)"
    border "1px solid rgba(255, 255, 255, 0.2)"
    color use color "yt-text"
    font-size "13px"
    font-weight 600
    cursor pointer
end

for ".btn-subscribe" apply:
    padding "8px 18px"
    border-radius "18px"
    background "#ffffff"
    border none
    color "#0f0f0f"
    font-size "13px"
    font-weight 700
    cursor pointer
    transition "background 0.2s ease"
end

for ".btn-subscribe:hover" apply:
    background "#e5e5e5"
end

for ".action-buttons-group" apply:
    display flex
    align-items center
    gap "8px"
end

for ".like-dislike-pill" apply:
    display flex
    align-items center
    background use color "yt-surface"
    border-radius "18px"
    overflow hidden
end

for ".btn-like" apply:
    padding "8px 14px"
    background transparent
    border none
    color use color "yt-text"
    font-size "13px"
    font-weight 600
    cursor pointer
    display flex
    align-items center
    gap "6px"
end

for ".pill-sep" apply:
    width "1px"
    height "20px"
    background "rgba(255, 255, 255, 0.15)"
end

for ".btn-dislike" apply:
    padding "8px 14px"
    background transparent
    border none
    color use color "yt-text"
    font-size "13px"
    cursor pointer
end

for ".btn-action" apply:
    padding "8px 14px"
    border-radius "18px"
    background use color "yt-surface"
    border none
    color use color "yt-text"
    font-size "13px"
    font-weight 600
    cursor pointer
    display flex
    align-items center
    gap "6px"
end

# ── Description Box & Chapters ──
for ".watch-description-box" apply:
    background use color "yt-surface"
    border-radius "12px"
    padding "16px"
    margin-bottom "24px"
end

for ".desc-stats" apply:
    font-size "14px"
    font-weight 700
    margin "0 0 8px 0"
end

for ".desc-content" apply:
    font-size "14px"
    line-height 1.5
    margin 0
    white-space pre-line
end

for ".chapters-section" apply:
    margin-top "16px"
    padding-top "12px"
    border-top "1px solid rgba(255, 255, 255, 0.1)"
end

for ".chapters-title" apply:
    font-size "13px"
    font-weight 700
    color use color "yt-blue"
    margin "0 0 8px 0"
end

for ".chapter-pill-list" apply:
    display flex
    flex-wrap wrap
    gap "8px"
end

for ".chapter-btn" apply:
    padding "6px 12px"
    border-radius "6px"
    background "#1a1a1a"
    border "1px solid #333333"
    color "#3ea6ff"
    font-size "12px"
    font-weight 600
    cursor pointer
    transition "background 0.2s ease"
end

for ".chapter-btn:hover" apply:
    background "#333333"
end

# ── Comments Section ──
for ".comments-container" apply:
    display flex
    flex-direction column
    gap "16px"
end

for ".comments-header" apply:
    display flex
    align-items center
    gap "24px"
end

for ".comments-header h3" apply:
    font-size "18px"
    font-weight 700
    margin 0
end

for ".sort-tag" apply:
    font-size "13px"
    font-weight 600
    cursor pointer
end

for ".add-comment-row" apply:
    display flex
    gap "16px"
    align-items flex-start
end

for ".user-avatar-sm" apply:
    width "36px"
    height "36px"
    border-radius "50%"
    background "#8b5cf6"
    color "#ffffff"
    display flex
    align-items center
    justify-content center
    font-weight 700
    font-size "14px"
    flex-shrink 0
end

for ".comment-input-wrap" apply:
    flex 1
    display flex
    flex-direction column
    gap "8px"
end

for ".comment-input" apply:
    width 100 percent
    background transparent
    border none
    border-bottom "1px solid rgba(255, 255, 255, 0.2)"
    color "#ffffff"
    font-size "14px"
    padding "6px 0"
    outline none
end

for ".comment-btn-bar" apply:
    display flex
    justify-content flex-end
    gap "8px"
end

for ".btn-ghost" apply:
    padding "8px 16px"
    border-radius "18px"
    background transparent
    border none
    color use color "yt-text"
    font-size "13px"
    font-weight 600
    cursor pointer
end

for ".btn-primary" apply:
    padding "8px 16px"
    border-radius "18px"
    background use color "yt-blue"
    border none
    color "#0f0f0f"
    font-size "13px"
    font-weight 700
    cursor pointer
end

for ".comment-list" apply:
    display flex
    flex-direction column
    gap "16px"
    margin-top "8px"
end

for ".comment-card" apply:
    display flex
    gap "16px"
    align-items flex-start
end

for ".comment-card.pinned" apply:
    padding "12px"
    background "rgba(59, 130, 246, 0.08)"
    border-left "3px solid #3b82f6"
    border-radius "0 8px 8px 0"
end

for ".pinned-tag" apply:
    font-size "11px"
    color "#3ea6ff"
    font-weight 700
    margin-bottom "4px"
    display block
end

for ".comment-body" apply:
    flex 1
    display flex
    flex-direction column
    gap "4px"
end

for ".comment-author-row" apply:
    display flex
    align-items center
    gap "8px"
end

for ".comment-author" apply:
    font-size "13px"
    font-weight 700
    color use color "yt-text"
end

for ".comment-author-badge" apply:
    font-size "13px"
    font-weight 700
    color "#3ea6ff"
end

for ".creator-pill" apply:
    font-size "11px"
    background "#2563eb"
    color "#ffffff"
    padding "1px 6px"
    border-radius "10px"
end

for ".comment-time" apply:
    font-size "12px"
    color use color "yt-muted"
end

for ".comment-msg" apply:
    font-size "14px"
    line-height 1.4
    margin 0
end

for ".comment-reactions" apply:
    display flex
    align-items center
    gap "12px"
    margin-top "4px"
end

for ".btn-react" apply:
    background transparent
    border none
    color use color "yt-muted"
    font-size "12px"
    cursor pointer
    padding "2px 6px"
    border-radius "4px"
end

# ── Up Next Recommendations ──
for ".watch-secondary" apply:
    display flex
    flex-direction column
    gap "12px"
end

for ".rec-header-row" apply:
    display flex
    align-items center
    justify-content space-between
end

for ".rec-header" apply:
    font-size "16px"
    font-weight 700
    margin 0
end

for ".autoplay-toggle-wrap" apply:
    display flex
    align-items center
    gap "8px"
end

for ".autoplay-label" apply:
    font-size "13px"
    color use color "yt-muted"
end

for ".rec-list" apply:
    display flex
    flex-direction column
    gap "12px"
end

for ".rec-card" apply:
    display flex
    gap "10px"
    cursor pointer
    border-radius "8px"
    padding "4px"
    transition "background 0.2s ease"
end

for ".rec-card:hover" apply:
    background use color "yt-hover"
end

for ".rec-thumb" apply:
    position relative
    width "140px"
    aspect-ratio "16 / 9"
    border-radius "8px"
    overflow hidden
    background "#1a1a1a"
    flex-shrink 0
end

for ".rec-details" apply:
    flex 1
    display flex
    flex-direction column
    gap "2px"
    min-width 0
end

for ".rec-title" apply:
    font-size "13px"
    font-weight 600
    color use color "yt-text"
    margin 0
    line-height 1.3
    display "-webkit-box"
    -webkit-line-clamp 2
    -webkit-box-orient vertical
    overflow hidden
end

for ".rec-channel" apply:
    font-size "12px"
    color use color "yt-muted"
    margin 0
end

for ".rec-stats" apply:
    font-size "11px"
    color use color "yt-muted"
    margin 0
end

# ── Shorts Fullscreen View ──
for ".shorts-reel-container" apply:
    display flex
    justify-content center
    align-items center
    height "calc(100vh - 100px)"
    position relative
end

for ".shorts-reel-viewport" apply:
    display flex
    align-items center
    gap "16px"
    height 100 percent
    max-height "750px"
end

for ".shorts-video-box" apply:
    position relative
    width "420px"
    height 100 percent
    border-radius "16px"
    overflow hidden
    box-shadow "0 12px 40px rgba(0, 0, 0, 0.7)"
    background "#000000"
end

for ".shorts-embed-frame" apply:
    width 100 percent
    height 100 percent
    border none
    display block
end

for ".shorts-top-bar" apply:
    position absolute
    top "16px"
    left "16px"
    right "16px"
    display flex
    justify-content space-between
    align-items center
    z-index 10
end

for ".shorts-brand-tag" apply:
    font-size "14px"
    font-weight 700
    color "#ffffff"
    text-shadow "0 2px 4px rgba(0,0,0,0.8)"
end

for ".shorts-ctrl-icon" apply:
    background "rgba(0, 0, 0, 0.6)"
    border none
    color "#ffffff"
    font-size "16px"
    border-radius "50%"
    width "36px"
    height "36px"
    cursor pointer
end

for ".shorts-bottom-overlay" apply:
    position absolute
    bottom "16px"
    left "16px"
    right "16px"
    display flex
    flex-direction column
    gap "8px"
    z-index 10
    text-shadow "0 2px 4px rgba(0,0,0,0.8)"
end

for ".shorts-creator-row" apply:
    display flex
    align-items center
    gap "10px"
end

for ".shorts-avatar" apply:
    width "36px"
    height "36px"
    border-radius "50%"
    background "#8b5cf6"
    color "#ffffff"
    display flex
    align-items center
    justify-content center
    font-weight 700
end

for ".shorts-username" apply:
    font-size "14px"
    font-weight 700
    color "#ffffff"
end

for ".btn-shorts-sub" apply:
    padding "6px 14px"
    border-radius "16px"
    background "#ffffff"
    border none
    color "#0f0f0f"
    font-size "12px"
    font-weight 700
    cursor pointer
end

for ".shorts-desc" apply:
    font-size "13px"
    color "#ffffff"
    margin 0
    line-height 1.3
end

for ".shorts-music-row" apply:
    display flex
    align-items center
    gap "6px"
    font-size "12px"
    color "#e2e8f0"
end

for ".shorts-action-rail" apply:
    display flex
    flex-direction column
    align-items center
    gap "16px"
end

for ".shorts-rail-btn" apply:
    display flex
    flex-direction column
    align-items center
    gap "4px"
    background use color "yt-surface"
    border none
    color "#ffffff"
    font-size "18px"
    width "48px"
    height "48px"
    border-radius "50%"
    cursor pointer
    justify-content center
    transition "transform 0.2s ease"
end

for ".shorts-rail-btn:hover" apply:
    transform "scale(1.1)"
end

for ".rail-count" apply:
    font-size "11px"
    font-weight 600
end

for ".shorts-sound-disc" apply:
    width "40px"
    height "40px"
    border-radius "50%"
    background "conic-gradient(#ff0000, #3ea6ff, #10b981, #ff0000)"
    border "3px solid #ffffff"
end

for ".shorts-nav-arrows" apply:
    display flex
    flex-direction column
    gap "12px"
    margin-left "16px"
end

for ".shorts-arrow-btn" apply:
    width "44px"
    height "44px"
    border-radius "50%"
    background use color "yt-surface"
    border "1px solid rgba(255, 255, 255, 0.1)"
    color "#ffffff"
    font-size "16px"
    cursor pointer
    display flex
    align-items center
    justify-content center
end

# ── Subscriptions, Library, Trending ──
for ".subs-channel-stories" apply:
    display flex
    gap "16px"
    overflow-x auto
    padding "12px 0 20px"
    margin-bottom "16px"
end

for ".channel-story-bubble" apply:
    display flex
    flex-direction column
    align-items center
    gap "6px"
    cursor pointer
    min-width "72px"
end

for ".channel-story-avatar" apply:
    width "56px"
    height "56px"
    border-radius "50%"
    padding "2px"
    border "2px solid #3ea6ff"
    display flex
    align-items center
    justify-content center
    font-weight 700
    font-size "18px"
    background "#1e293b"
    color "#ffffff"
end

for ".channel-story-name" apply:
    font-size "11px"
    color use color "yt-text"
    text-align center
    white-space nowrap
    overflow hidden
    text-overflow ellipsis
    max-width "70px"
end

for ".library-section-block" apply:
    margin-bottom "32px"
end

for ".library-subheading" apply:
    font-size "16px"
    font-weight 700
    margin "0 0 16px 0"
end

for ".history-list" apply:
    display flex
    flex-direction column
    gap "12px"
end

for ".history-card" apply:
    display flex
    gap "16px"
    cursor pointer
    padding "8px"
    border-radius "10px"
    transition "background 0.2s ease"
end

for ".history-card:hover" apply:
    background use color "yt-hover"
end

for ".history-thumb" apply:
    position relative
    width "200px"
    aspect-ratio "16 / 9"
    border-radius "10px"
    overflow hidden
    background "#1a1a1a"
    flex-shrink 0
end

for ".history-details" apply:
    display flex
    flex-direction column
    gap "4px"
    flex 1
end

for ".history-title" apply:
    font-size "15px"
    font-weight 600
    margin 0
end

for ".history-sub" apply:
    font-size "13px"
    color use color "yt-muted"
    margin 0
end

for ".history-time" apply:
    font-size "12px"
    color use color "yt-blue"
    margin 0
end

# ── Trending View ──
for ".trending-tabs" apply:
    display flex
    gap "12px"
    margin "16px 0 24px"
end

for ".tab-btn" apply:
    padding "8px 20px"
    border-radius "20px"
    background use color "yt-surface"
    border none
    color use color "yt-text"
    font-size "14px"
    font-weight 600
    cursor pointer
end

for ".tab-btn.active" apply:
    background "#ffffff"
    color "#0f0f0f"
end

for ".trending-list" apply:
    display flex
    flex-direction column
    gap "16px"
end

for ".trending-card" apply:
    display flex
    gap "20px"
    cursor pointer
    padding "12px"
    border-radius "12px"
    transition "background 0.2s ease"
    align-items flex-start
end

for ".trending-card:hover" apply:
    background use color "yt-hover"
end

for ".trending-rank-badge" apply:
    font-size "26px"
    font-weight 900
    color "#ef4444"
    width "40px"
    display flex
    align-items center
    justify-content center
    flex-shrink 0
end

# ── Modals & Toasts ──
for ".yt-modal" apply:
    position fixed
    top 0
    left 0
    right 0
    bottom 0
    background "rgba(0, 0, 0, 0.75)"
    display none
    align-items center
    justify-content center
    z-index 2000
end

for ".modal-box" apply:
    width "520px"
    max-width 90 percent
    background "#212121"
    border-radius "16px"
    border "1px solid rgba(255, 255, 255, 0.1)"
    box-shadow "0 16px 48px rgba(0,0,0,0.8)"
    overflow hidden
    display flex
    flex-direction column
end

for ".modal-header" apply:
    display flex
    align-items center
    justify-content space-between
    padding "16px 20px"
    border-bottom "1px solid rgba(255, 255, 255, 0.1)"
end

for ".modal-title" apply:
    font-size "18px"
    font-weight 700
    margin 0
end

for ".modal-close-btn" apply:
    background transparent
    border none
    color use color "yt-text"
    font-size "18px"
    cursor pointer
end

for ".modal-body" apply:
    padding "20px"
    display flex
    flex-direction column
    gap "16px"
end

for ".upload-drop-zone" apply:
    border "2px dashed rgba(255, 255, 255, 0.2)"
    border-radius "12px"
    padding "32px 16px"
    display flex
    flex-direction column
    align-items center
    gap "12px"
    background "rgba(255, 255, 255, 0.02)"
end

for ".upload-icon-huge" apply:
    font-size "44px"
end

for ".upload-hint" apply:
    font-size "14px"
    color use color "yt-muted"
    margin 0
end

for ".upload-form" apply:
    display flex
    flex-direction column
    gap "12px"
end

for ".modal-input" apply:
    width 100 percent
    padding "10px 14px"
    background "#121212"
    border "1px solid #383838"
    border-radius "8px"
    color "#ffffff"
    font-size "14px"
    box-sizing border-box
end

for ".modal-textarea" apply:
    width 100 percent
    height "80px"
    padding "10px 14px"
    background "#121212"
    border "1px solid #383838"
    border-radius "8px"
    color "#ffffff"
    font-size "14px"
    box-sizing border-box
    resize vertical
end

for ".modal-footer" apply:
    display flex
    justify-content flex-end
    gap "12px"
    padding "14px 20px"
    border-top "1px solid rgba(255, 255, 255, 0.1)"
end

for ".share-social-grid" apply:
    display grid
    grid-template-columns "repeat(auto-fit, minmax(130px, 1fr))"
    gap "10px"
end

for ".social-btn" apply:
    padding "10px 12px"
    background use color "yt-surface"
    border "1px solid rgba(255, 255, 255, 0.1)"
    border-radius "8px"
    color "#ffffff"
    font-size "13px"
    font-weight 600
    cursor pointer
end

for ".share-link-row" apply:
    display flex
    gap "8px"
    margin-top "8px"
end

for ".share-link-box" apply:
    flex 1
    padding "10px 14px"
    background "#121212"
    border "1px solid #383838"
    border-radius "8px"
    color use color "yt-blue"
    font-size "14px"
end

# ── Notifications Dropdown ──
for ".notif-dropdown" apply:
    position fixed
    top "60px"
    right "80px"
    width "380px"
    background "#212121"
    border "1px solid rgba(255, 255, 255, 0.15)"
    border-radius "12px"
    box-shadow "0 12px 36px rgba(0,0,0,0.7)"
    display none
    flex-direction column
    z-index 1500
    overflow hidden
end

for ".notif-header" apply:
    display flex
    align-items center
    justify-content space-between
    padding "12px 16px"
    border-bottom "1px solid rgba(255, 255, 255, 0.1)"
end

for ".notif-title" apply:
    font-size "15px"
    font-weight 700
    margin 0
end

for ".notif-opt-btn" apply:
    background transparent
    border none
    color use color "yt-muted"
    cursor pointer
end

for ".notif-list" apply:
    display flex
    flex-direction column
    max-height "360px"
    overflow-y auto
end

for ".notif-item" apply:
    display flex
    gap "12px"
    padding "12px 16px"
    cursor pointer
    border-bottom "1px solid rgba(255, 255, 255, 0.05)"
end

for ".notif-item:hover" apply:
    background use color "yt-hover"
end

for ".notif-item.unread" apply:
    background "rgba(59, 130, 246, 0.08)"
end

for ".notif-content" apply:
    flex 1
    display flex
    flex-direction column
    gap "4px"
end

for ".notif-msg" apply:
    font-size "13px"
    margin 0
    line-height 1.3
end

for ".notif-time" apply:
    font-size "11px"
    color use color "yt-muted"
end

# ── Profile Menu Dropdown ──
for ".profile-dropdown" apply:
    position fixed
    top "60px"
    right "16px"
    width "280px"
    background "#212121"
    border "1px solid rgba(255, 255, 255, 0.15)"
    border-radius "12px"
    box-shadow "0 12px 36px rgba(0,0,0,0.7)"
    display none
    flex-direction column
    z-index 1500
    overflow hidden
end

for ".profile-dropdown-header" apply:
    display flex
    align-items center
    gap "12px"
    padding "16px"
end

for ".profile-header-meta" apply:
    display flex
    flex-direction column
    gap "2px"
end

for ".profile-name" apply:
    font-size "14px"
    font-weight 700
    margin 0
    color use color "yt-text"
end

for ".profile-handle" apply:
    font-size "12px"
    color use color "yt-muted"
    margin 0
end

for ".profile-divider" apply:
    height "1px"
    background "rgba(255, 255, 255, 0.1)"
    margin "4px 0"
end

for ".profile-menu-item" apply:
    display flex
    align-items center
    gap "12px"
    padding "10px 16px"
    background transparent
    border none
    color use color "yt-text"
    font-size "14px"
    cursor pointer
    text-align left
    width 100 percent
    transition "background 0.15s ease"
end

for ".profile-menu-item:hover" apply:
    background use color "yt-hover"
end

# ── Toast Alert Banner ──
for ".yt-toast" apply:
    position fixed
    bottom "24px"
    left "24px"
    background "#212121"
    color "#ffffff"
    padding "12px 20px"
    border-radius "8px"
    box-shadow "0 8px 24px rgba(0,0,0,0.6)"
    border "1px solid rgba(255, 255, 255, 0.15)"
    font-size "14px"
    font-weight 600
    z-index 3000
    display none
end

for ".channel-avatar-img" apply:
    width 100 percent
    height 100 percent
    border-radius "50%"
    object-fit cover
    display block
end

for ".comment-avatar-img" apply:
    width 100 percent
    height 100 percent
    border-radius "50%"
    object-fit cover
    display block
end

