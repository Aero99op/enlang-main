in script:
    # State Declarations
    create terminalStep as 0

    show "⚡ Initializing Prayas Kumar Sahoo 3D Cyber Portfolio Engine..."

    # Clipboard Copy Helper
    ;function copyToClipboard(valToCopy) {
    ;if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(valToCopy);
    ;} else {
    const ta = document.createElement("textarea");
    ta.value = valToCopy;
    ta.style.position = "fixed";
    ta.style.left = "-9999px";
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    ;try { document.execCommand('copy'); } catch(e){}
    ta.remove();
    ;}
    ;}

    # Procedural 3D Sun Texture Generator
    ;function createSunTexture() {
    const c = document.createElement("canvas");
    c.width = 1024;
    c.height = 512;
    const ctx = c.getContext("2d");
    const grad = ctx.createLinearGradient(0, 0, 0, 512);
    grad.addColorStop(0, "#ff2200");
    grad.addColorStop(0.25, "#ff6600");
    grad.addColorStop(0.5, "#ffaa00");
    grad.addColorStop(0.75, "#ffdd33");
    grad.addColorStop(1, "#ff4400");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 1024, 512);
    ;for (let i = 0; i < 1800; i++) {
    const x = Math.random() * 1024;
    const y = Math.random() * 512;
    const r = 2 + Math.random() * 20;
    const alpha = 0.15 + Math.random() * 0.4;
    ctx.fillStyle = (Math.random() > 0.4) ? "rgba(255, 255, 220, " + alpha + ")" : "rgba(255, 60, 0, " + alpha + ")";
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ;}
    ;for (let s = 0; s < 22; s++) {
    const sx = Math.random() * 1024;
    const sy = 100 + Math.random() * 312;
    const sr = 6 + Math.random() * 16;
    ctx.fillStyle = "rgba(45, 8, 0, 0.85)";
    ctx.beginPath();
    ctx.arc(sx, sy, sr, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = "rgba(255, 120, 0, 0.6)";
    ctx.lineWidth = 4;
    ctx.stroke();
    ;}
    const tex = new THREE.CanvasTexture(c);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    return tex;
    ;}

    # Procedural 3D Moon Texture Generator with Craters and Maria
    ;function createMoonTexture() {
    const c = document.createElement("canvas");
    c.width = 1024;
    c.height = 512;
    const ctx = c.getContext("2d");
    ctx.fillStyle = "#8a96a6";
    ctx.fillRect(0, 0, 1024, 512);
    const maria = [ {x: 350, y: 200, r: 130}, {x: 270, y: 300, r: 95}, {x: 490, y: 170, r: 120}, {x: 660, y: 220, r: 145}, {x: 770, y: 320, r: 85}, {x: 180, y: 350, r: 75} ];
    ;for (let m = 0; m < maria.length; m++) {
    const mc = maria[m];
    const mg = ctx.createRadialGradient(mc.x, mc.y, 8, mc.x, mc.y, mc.r);
    mg.addColorStop(0, "rgba(40, 50, 65, 0.9)");
    mg.addColorStop(0.65, "rgba(55, 65, 80, 0.7)");
    mg.addColorStop(1, "rgba(138, 150, 166, 0)");
    ctx.fillStyle = mg;
    ctx.beginPath();
    ctx.arc(mc.x, mc.y, mc.r, 0, Math.PI * 2);
    ctx.fill();
    ;}
    ;for (let i = 0; i < 2400; i++) {
    const x = Math.random() * 1024;
    const y = Math.random() * 512;
    const r = 1 + Math.random() * 6;
    ctx.fillStyle = Math.random() > 0.5 ? "rgba(255, 255, 255, 0.3)" : "rgba(15, 20, 30, 0.35)";
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ;}
    const craters = [ {x: 310, y: 380, r: 26}, {x: 430, y: 140, r: 20}, {x: 560, y: 190, r: 18}, {x: 790, y: 260, r: 22}, {x: 210, y: 180, r: 17}, {x: 890, y: 380, r: 24} ];
    ;for (let cIdx = 0; cIdx < craters.length; cIdx++) {
    const cr = craters[cIdx];
    ;if (cIdx === 0) {
    ctx.strokeStyle = "rgba(255, 255, 255, 0.4)";
    ctx.lineWidth = 1.5;
    ;for (let ray = 0; ray < 14; ray++) {
    const angle = (ray / 14) * Math.PI * 2;
    ctx.beginPath();
    ctx.moveTo(cr.x, cr.y);
    ctx.lineTo(cr.x + Math.cos(angle) * 180, cr.y + Math.sin(angle) * 180);
    ctx.stroke();
    ;}
    ;}
    ctx.fillStyle = "rgba(12, 16, 24, 0.85)";
    ctx.beginPath();
    ctx.arc(cr.x, cr.y, cr.r, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = "rgba(255, 255, 255, 0.8)";
    ctx.lineWidth = 3;
    ctx.stroke();
    ;}
    const tex = new THREE.CanvasTexture(c);
    return tex;
    ;}

    # 3D Three.js Background Scene Initialization with Safe Guard
    ;function init3D() {
    ;if (typeof THREE === "undefined") {
    setTimeout(init3D, 150);
    return;
    }
    const canvas = document.getElementById("webgl-canvas");
    ;if (!canvas) {
    setTimeout(init3D, 150);
    return;
    }

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    # Celestial Lighting
    const ambientLight = new THREE.AmbientLight("#475569", 0.65);
    scene.add(ambientLight);

    const sunLight = new THREE.PointLight("#ffeedd", 2.2, 80);
    sunLight.position.set(7.0, 3.5, -4.5);
    scene.add(sunLight);

    # 3D Deep Space Starfield
    const particlesCount = 2500;
    const positions = new Float32Array(particlesCount * 3);
    const colors = new Float32Array(particlesCount * 3);

    ;for (let i = 0; i < particlesCount * 3; i += 3) {
    positions[i] = (Math.random() - 0.5) * 45;
    positions[i + 1] = (Math.random() - 0.5) * 45;
    positions[i + 2] = (Math.random() - 0.5) * 45;

    const rChoice = Math.random();
    ;if (rChoice < 0.45) {
    colors[i] = 0.0; colors[i + 1] = 0.95; colors[i + 2] = 1.0;
    ;} else if (rChoice < 0.8) {
    colors[i] = 0.7; colors[i + 1] = 0.35; colors[i + 2] = 1.0;
    ;} else {
    colors[i] = 1.0; colors[i + 1] = 0.85; colors[i + 2] = 0.4;
    ;}
    }

    const particlesGeometry = new THREE.BufferGeometry();
    particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    particlesGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    const particlesMaterial = new THREE.PointsMaterial({ size: 0.11, vertexColors: true, transparent: true, opacity: 0.85 });
    const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
    scene.add(particlesMesh);

    # Realistic 3D Sun Model with Plasma Surface and Solar Coronas
    const sunTex = createSunTexture();
    const sunGeo = new THREE.SphereGeometry(2.5, 64, 64);
    const sunMat = new THREE.MeshBasicMaterial({ map: sunTex });
    const sunMesh = new THREE.Mesh(sunGeo, sunMat);
    sunMesh.position.set(7.0, 3.5, -5.5);
    scene.add(sunMesh);

    const sunCoronaGeo1 = new THREE.SphereGeometry(2.78, 32, 32);
    const sunCoronaMat1 = new THREE.MeshBasicMaterial({ color: "#ff8800", transparent: true, opacity: 0.45, blending: THREE.AdditiveBlending });
    const sunCorona1 = new THREE.Mesh(sunCoronaGeo1, sunCoronaMat1);
    sunMesh.add(sunCorona1);

    const sunCoronaGeo2 = new THREE.SphereGeometry(3.3, 32, 32);
    const sunCoronaMat2 = new THREE.MeshBasicMaterial({ color: "#ffbb00", transparent: true, opacity: 0.22, blending: THREE.AdditiveBlending });
    const sunCorona2 = new THREE.Mesh(sunCoronaGeo2, sunCoronaMat2);
    sunMesh.add(sunCorona2);

    # Realistic 3D Moon Model with Maria, Craters, and Atmospheric Rim
    const moonTex = createMoonTexture();
    const moonGeo = new THREE.SphereGeometry(1.75, 64, 64);
    const moonMat = new THREE.MeshStandardMaterial({ map: moonTex, roughness: 0.85, metalness: 0.1 });
    const moonMesh = new THREE.Mesh(moonGeo, moonMat);
    moonMesh.position.set(-6.8, -1.8, -5.0);
    scene.add(moonMesh);

    const moonHaloGeo = new THREE.SphereGeometry(1.9, 32, 32);
    const moonHaloMat = new THREE.MeshBasicMaterial({ color: "#38bdf8", transparent: true, opacity: 0.2, blending: THREE.AdditiveBlending });
    const moonHalo = new THREE.Mesh(moonHaloGeo, moonHaloMat);
    moonMesh.add(moonHalo);

    # Cosmic Orbital Ring Around Moon
    const ringGeo = new THREE.TorusGeometry(2.6, 0.04, 16, 100);
    const ringMat = new THREE.MeshBasicMaterial({ color: "#00f2fe", transparent: true, opacity: 0.35 });
    const ringMesh = new THREE.Mesh(ringGeo, ringMat);
    ringMesh.rotation.x = Math.PI / 2.5;
    ringMesh.rotation.y = Math.PI / 6;
    moonMesh.add(ringMesh);

    # Subtle Futuristic Cyber Floating Accents in Background
    const geom1 = new THREE.IcosahedronGeometry(1.4, 1);
    const mat1 = new THREE.MeshBasicMaterial({ color: "#00f2fe", wireframe: true, transparent: true, opacity: 0.25 });
    const poly1 = new THREE.Mesh(geom1, mat1);
    poly1.position.set(2.0, -3.8, -7.0);
    scene.add(poly1);

    const geom2 = new THREE.TorusKnotGeometry(1.2, 0.3, 64, 8);
    const mat2 = new THREE.MeshBasicMaterial({ color: "#a855f7", wireframe: true, transparent: true, opacity: 0.2 });
    const poly2 = new THREE.Mesh(geom2, mat2);
    poly2.position.set(-2.5, 3.8, -8.0);
    scene.add(poly2);

    camera.position.z = 7;

    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;
    let orbitTime = 0;

    window.addEventListener('mousemove', function(event) {
    mouseX = (event.clientX / window.innerWidth - 0.5) * 2;
    mouseY = (event.clientY / window.innerHeight - 0.5) * 2;
    });

    window.addEventListener('resize', function() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    });

    ;function render3DScene() {
    requestAnimationFrame(render3DScene);
    orbitTime += 0.008;

    targetX += (mouseX - targetX) * 0.05;
    targetY += (mouseY - targetY) * 0.05;

    particlesMesh.rotation.y += 0.0008;
    particlesMesh.rotation.x += 0.0004;

    # Sun Dynamic Rotation & Plasma Texture Shift
    sunMesh.rotation.y += 0.005;
    sunMesh.rotation.x += 0.002;
    sunCorona1.rotation.y -= 0.008;
    sunCorona2.rotation.z += 0.004;
    sunTex.offset.x = (sunTex.offset.x + 0.001) % 1;

    # Sun Parallax Position
    sunMesh.position.x = 7.0 + targetX * 1.6;
    sunMesh.position.y = 3.5 - targetY * 1.6 + Math.sin(orbitTime) * 0.25;
    sunLight.position.copy(sunMesh.position);

    # Moon Dynamic Rotation & Gentle Orbit
    moonMesh.rotation.y += 0.004;
    ringMesh.rotation.z += 0.01;
    moonMesh.position.x = -6.8 + targetX * 1.4;
    moonMesh.position.y = -1.8 - targetY * 1.4 + Math.cos(orbitTime) * 0.2;

    # Background Geometry Rotation
    poly1.rotation.x += 0.008;
    poly1.rotation.y += 0.012;
    poly2.rotation.x -= 0.006;
    poly2.rotation.y += 0.009;

    camera.position.x = targetX * 0.7;
    camera.position.y = -targetY * 0.7;
    camera.lookAt(scene.position);

    renderer.render(scene, camera);
    }
    render3DScene();
    }
    init3D();

    # Toast Notification Helper
    to do showToast with message:
        set text of "toast-alert" to message
        (document.getElementById("toast-alert") || document.querySelector("toast-alert")).style.display = "block"
        after 3 seconds:
            (document.getElementById("toast-alert") || document.querySelector("toast-alert")).style.display = "none"

    # Copy Phone to Clipboard
    when "btn-copy-phone" is clicked:
        call copyToClipboard with "8260350182"
        call showToast with "📞 Phone number copied: 8260350182"

    # Copy Email to Clipboard
    when "btn-copy-email" is clicked:
        call copyToClipboard with "prayaskumarsahoo45@gmail.com"
        call showToast with "✉️ Email copied: prayaskumarsahoo45@gmail.com"

    # Terminal Code Simulation
    const codeSnippets = [ "// [1] Booting Spring Boot 3.2.0 Microservice...", "@RestController @RequestMapping(\"/api/v1/lms\")\npublic class CourseEnrollmentController {\n    @Autowired private EnrollmentService service;\n    @PostMapping(\"/enroll\")\n    public ResponseEntity<ApiResponse> enrollStudent(@Valid @RequestBody StudentDTO dto) {\n        return ResponseEntity.ok(service.processEnrollment(dto));\n    }\n}", "// [2] Connecting Oracle & MySQL Production Clusters...\n[DB POOL] HikariCP initialized (10 active connections, latency 1.2ms)\n[AUTH] Spring Security JWT Filter Chain Active [200 OK]", "// [3] Running Payroll Calculation Engine...\n[PAYROLL ENGINE] Tax brackets calculated. Stored procedure executed successfully.\nStatus: ALL SYSTEMS OPERATIONAL (Java 21 Virtual Threads Enabled)" ];

    to do advanceTerminal:
        terminalStep = (terminalStep + 1) % 4
        set text of "terminal-output" to codeSnippets[terminalStep]
        call showToast with "💻 Loaded Backend Module [" + (terminalStep + 1) + "/4]"

    when "btn-term-next" is clicked:
        call advanceTerminal

    # Contact Form Submission
    when "contact-form" is submitted:
        let senderName = get value of "contact-name"
        let senderEmail = get value of "contact-email"
        let senderMsg = get value of "contact-message"
        if senderName == "":
            alert "Please enter your name"
            return
        if senderEmail == "":
            alert "Please enter your email"
            return
        call showToast with "🚀 Message sent! Thanks " + senderName + ", Prayas will reply soon."
        set text of "contact-status" to "✅ Inquiry submitted successfully. Thank you!"
        set value of "contact-name" to ""
        set value of "contact-email" to ""
        set value of "contact-message" to ""

    # Live Clock in Footer
    every 1 second:
        refresh "live-clock" with "Engine Active • Asia/Kolkata • " + new Date().toLocaleTimeString()

    show "⚡ 3D Scene, Particle Grid, and Interactive Controls are 100% Active!"
