{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EnLang Core (.enlg)",
  "scopeName": "source.enlg",
  "patterns": [
    {
      "name": "comment.line.number-sign.enlang",
      "match": "(#|//).*$"
    },
    {
      "name": "string.quoted.double.enlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.enlang", "match": "\\\\." }]
    },
    {
      "name": "string.quoted.single.enlang",
      "begin": "'",
      "end": "'",
      "patterns": [{ "name": "constant.character.escape.enlang", "match": "\\\\." }]
    },
    {
      "name": "constant.numeric.enlang",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "keyword.declaration.enlang",
      "match": "\\b(remember|freeze|create|define|let|set|put|update|change|as|to|into|to do|action|function|with|class|blueprint)\\b"
    },
    {
      "name": "keyword.control.enlang",
      "match": "\\b(use|import|when|otherwise when|otherwise|repeat until|repeat while|repeat|times|while|for each pair|for each|for|from|to|by|if|else if|else|in|give|return|yield|try|catch|finally)\\b"
    },
    {
      "name": "support.function.enlang",
      "match": "\\b(show|log|print|display|warn|error|alert|swap pair|swap|sort|arrange|reverse|keep|count of|count|first|last|keys|values|has_key|sub_string|string_substring|string_slice|pointer|ref|make_cell|get_cell|set_cell)\\b"
    },
    {
      "name": "keyword.operator.enlang",
      "match": "\\b(increases by|decreases by|arrange by|arrange with|arrange in|arrange at|swap with|is|is not|equals|is greater than|is less than|plus|minus|times|divided by|modulo|and|or|not|at|of)\\b|(\\+|\\-|\\*|\\/|=|==|!=|>|<|>=|<=)"
    },
    {
      "name": "storage.type.enlang",
      "match": "\\b(true|false|null|text|number|boolean|list|map|array|object|pair)\\b"
    }
  ]
}
