{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EnLang Mobile (.enlgm)",
  "scopeName": "source.enlgm",
  "patterns": [
    {
      "name": "comment.line.number-sign.enlgm",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.enlgm",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.enlgm", "match": "\\\\." }]
    },
    {
      "name": "constant.other.color.rgb-value.enlgm",
      "match": "#[0-9a-fA-F]{3,8}\\b"
    },
    {
      "name": "constant.numeric.enlgm",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "keyword.control.domain.enlgm",
      "match": "\\b(in mobile|use flutter|use package)\\b"
    },
    {
      "name": "entity.name.tag.mobile.enlgm",
      "match": "\\b(app|screen|theme|accent color|home screen|app bar|actions|icon button|body|scroll|column|row|centered|avatar|spacer|text|button|container|card|list view|image|input field|floating button)\\b"
    },
    {
      "name": "keyword.declaration.enlgm",
      "match": "\\b(size|bold|color|align|title|height|width|from|when tapped|show toast|go to|back)\\b"
    }
  ]
}
