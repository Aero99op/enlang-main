{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EnLang Script (.enlgs)",
  "scopeName": "source.enlgs",
  "patterns": [
    {
      "name": "comment.line.number-sign.enlgs",
      "match": "(#|//).*$"
    },
    {
      "name": "comment.block.enlgs",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.enlgs",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.enlgs", "match": "\\\\." }]
    },
    {
      "name": "string.quoted.single.enlgs",
      "begin": "'",
      "end": "'",
      "patterns": [{ "name": "constant.character.escape.enlgs", "match": "\\\\." }]
    },
    {
      "name": "constant.other.color.rgb-value.enlgs",
      "match": "#[0-9a-fA-F]{3,8}\\b"
    },
    {
      "name": "constant.numeric.enlgs",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "keyword.control.domain.enlgs",
      "match": "\\b(in script|in backend)\\b"
    },
    {
      "name": "support.function.dom.enlgs",
      "match": "\\b(set text of|set html of|set value of|set color of|set background of|set style of|add class|remove class|toggle class|show element|hide element|get value of|get text of|scroll to|animate|log|show|alert|fetch)\\b"
    },
    {
      "name": "keyword.operator.natural.enlgs",
      "match": "\\b(put|into|update|to|add|push|remove item at|remove|insert|at index|at|from|in)\\b"
    },
    {
      "name": "keyword.declaration.enlgs",
      "match": "\\b(create|define|let|set|change|assign|as|with|using|class|blueprint|interface|extends|async|await|to do|action|function)\\b"
    },
    {
      "name": "keyword.control.enlgs",
      "match": "\\b(if|then|else if|else|repeat|times|while|for each|for every|for|when|is clicked|is submitted|is changed|after|seconds|second|ms|milliseconds|try|catch|finally|throw|return|yield)\\b"
    },
    {
      "name": "keyword.operator.enlgs",
      "match": "\\b(is|is not|equals|is greater than|is less than|contains|and|or|not)\\b|(\\+|\\-|\\*|\\/|=|==|!=|>|<|>=|<=|&&|\\|\\||!)"
    },
    {
      "name": "storage.type.enlgs",
      "match": "\\b(true|false|null|undefined|text|number|boolean|list|map|array|object)\\b"
    }
  ]
}
