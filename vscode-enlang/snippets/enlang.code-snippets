{
  "EnLang Core Program": {
    "prefix": "enlg-core",
    "body": [
      "type enlg",
      "",
      "declare ${1:num} = ${2:10}",
      "print \"Value: \" + ${1:num}",
      "$0"
    ],
    "description": "Scaffold a core .enlg logic file with 'type enlg' header"
  },
  "EnLang Web Page": {
    "prefix": "enlg-page",
    "body": [
      "type enlgf",
      "",
      "document enlgf:",
      "    head:",
      "        title \"${1:App Title}\"",
      "    body:",
      "        header class \"main-navbar\":",
      "            heading 1 \"${2:BRAND LOGO}\"",
      "            button \"${3:ACTION}\" id \"btn-${4:action}\"",
      "        main class \"main-container\":",
      "            section class \"hero-section\":",
      "                heading 2 \"${5:Welcome}\"",
      "                paragraph \"${6:Description}\"",
      "                $0"
    ],
    "description": "Scaffold a complete .enlgf web page with 'type enlgf' header"
  },
  "EnLang Design Stylesheet": {
    "prefix": "enlg-design",
    "body": [
      "type enlgd",
      "",
      "define color \"primary\" as \"${1:#6366f1}\"",
      "",
      "for \"${2:body}\" apply:",
      "    background: \"${3:#090d16}\"",
      "    color: \"${4:#f8fafc}\"",
      "    font-family: \"${5:Outfit, sans-serif}\"",
      "end",
      "",
      "when \"${6:.btn-action}\" is hovered apply:",
      "    transform: \"scale(1.05)\"",
      "    opacity: 0.95",
      "end",
      "$0"
    ],
    "description": "Scaffold an .enlgd design stylesheet with 'type enlgd' header"
  },
  "EnLang Script Block": {
    "prefix": "enlg-script",
    "body": [
      "type enlgs",
      "",
      "in script:",
      "    create ${1:stateVar} as ${2:0}",
      "",
      "    when \"${3:btn-submit}\" is clicked:",
      "        set ${1:stateVar} = ${1:stateVar} + 1",
      "        refresh \"${4:display-id}\" with \"Updated: \" + ${1:stateVar}",
      "        $0"
    ],
    "description": "Scaffold a modern .enlgs client script with 'type enlgs' header"
  },
  "EnLang Mobile App": {
    "prefix": "enlg-mobile",
    "body": [
      "type enlgm",
      "",
      "in mobile:",
      "    use flutter \"material\"",
      "    use package \"google_fonts\"",
      "",
      "    app \"${1:MyApp}\":",
      "        theme dark",
      "        accent color \"${2:#00f2fe}\"",
      "        home screen ${3:HomeScreen}",
      "",
      "    screen ${3:HomeScreen}:",
      "        app bar:",
      "            title \"${4:Title}\"",
      "        body:",
      "            scroll:",
      "                column centered:",
      "                    text \"${5:Hello World}\" size 20, bold",
      "                    $0"
    ],
    "description": "Scaffold a modern .enlgm mobile screen with 'type enlgm' header"
  },
  "EnLang Database Table": {
    "prefix": "enlg-table",
    "body": [
      "type enlgdb",
      "",
      "create table \"${1:users}\" with:",
      "    id as integer primary key autoincrement",
      "    ${2:username} as text not null unique",
      "    ${3:email} as text not null",
      "    ${4:created_at} as timestamp default current_timestamp",
      "    $0"
    ],
    "description": "Scaffold a modern .enlgdb database table with 'type enlgdb' header"
  },
  "EnLang Database Query": {
    "prefix": "enlg-select",
    "body": [
      "select all from \"${1:users}\" where ${2:rating} >= ${3:1000} order by ${2:rating} descending limit ${4:20}"
    ],
    "description": "Natural select query in .enlgdb"
  },
  "EnLang Safe Drop Table": {
    "prefix": "enlg-safe-drop",
    "body": [
      "drop table \"${1:users}\" confirm \"DROP_${1/(.*)/${1:/upcase}/}\""
    ],
    "description": "Safe guarded table drop in .enlgdb"
  }
}
