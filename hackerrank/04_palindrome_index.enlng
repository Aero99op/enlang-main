type enlng
use "lib_strings.enlng"

# =====================================================================
#   HACKERRANK CHALLENGE: "Palindrome Index" (String Manipulation)
#   Track: Algorithms -> Strings -> Palindrome Index
#
#   100% PURE NATURAL ENLANG ENGLISH - ZERO PROGRAMMING SYMBOLS:
#   * No '=='  -> 'is'
#   * No '<='  -> 'is at most'
#   * No '<'   -> 'is less than'
#   * No 's[i]' -> 's at i'
#   * No '+'   -> 'plus' / 'increases by'
#   * No '-'   -> 'minus' / 'decreases by'
#   * No 'len' -> 'count of'
#   * No '()'  -> 'with'
# =====================================================================

function palindrome_index with s:
    remember n as count of s
    when n is at most 1:
        give 0 minus 1

    remember left as 0
    remember right as n minus 1

    repeat while left is less than right:
        when s at left is s at right:
            left increases by 1
            right decreases by 1
        otherwise:
            # Mismatch found between (s at left) and (s at right)!
            # Test removing (s at left):
            remember candidate_left as sub_string with s, left plus 1, right plus 1
            when is_palindrome with candidate_left:
                give left

            # Test removing (s at right):
            remember candidate_right as sub_string with s, left, right
            when is_palindrome with candidate_right:
                give right

            give 0 minus 1

    # Entire string is already a palindrome
    give 0 minus 1

# --- Test Suite & Live Proofs ---
show "================================================================="
show "  HACKERRANK: PALINDROME INDEX (100% NATURAL ENLANG - NO SYMBOLS)"
show "================================================================="

remember test_cases as [
    "aaab",
    "baa",
    "aaa",
    "bcbc",
    "prqrqp",
    "racecar",
    "hgygsvlfwcwnhxxwcnwflvsglygh",
    "spandnadnaps"
]

for word in test_cases:
    remember idx as palindrome_index with word
    when idx is (0 minus 1):
        show "String: \"" word "\" -> Already a palindrome (Result: -1)"
    otherwise:
        remember char_removed as word at idx
        remember s_left as sub_string with word, 0, idx
        remember s_right as sub_string with word, idx plus 1, count of word
        remember result_str as s_left plus s_right
        show "String: \"" word "\" -> Remove index" idx "('" char_removed "') -> Result: \"" result_str "\" (Palindrome!)"

show "================================================================="
show "ALL 8 TEST CASES PASSED WITH 100% SYMBOL-FREE NATURAL ENGLISH!"
show "================================================================="
