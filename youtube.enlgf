document enlgf:
    head:
        title "YouTube — Watch, Stream and Share"
        connect design youtube.enlgd
        connect script youtube.enlgs

    body:
        div class "yt-app":
            # YouTube Top Navigation Bar
            header class "yt-header":
                div class "yt-header-left":
                    button "☰" id "btn-sidebar-toggle" class "yt-icon-btn"
                    div class "yt-logo" id "btn-logo":
                        span "▶" class "yt-logo-icon"
                        span "YouTube" class "yt-logo-text"
                        span "IN" class "yt-country"

                div class "yt-header-center":
                    div class "yt-search-box":
                        input type "text" id "search-input" placeholder "Search videos, creators, tech tutorials..." class "yt-search-input"
                        button "🔍" id "btn-search" class "yt-search-btn"
                    button "🎙️" id "btn-voice" class "yt-icon-btn voice-btn"

                div class "yt-header-right":
                    button "＋ Create" id "btn-create" class "yt-btn-create"
                    button "🔔" id "btn-notif" class "yt-icon-btn notif-btn":
                        span "3" class "notif-badge"
                    button "☾" id "btn-theme" class "yt-icon-btn"
                    div "P" class "yt-user-avatar" id "user-profile"

            div class "yt-main-layout":
                # Left Navigation Sidebar
                aside class "yt-sidebar" id "yt-sidebar":
                    div class "sidebar-section":
                        button "🏠 Home" id "nav-home" class "sidebar-item active"
                        button "⚡ Shorts" id "nav-shorts" class "sidebar-item"
                        button "📺 Subscriptions" id "nav-subs" class "sidebar-item"

                    div class "sidebar-divider"

                    div class "sidebar-section":
                        p "YOU" class "sidebar-heading"
                        button "📁 Library" id "nav-library" class "sidebar-item"
                        button "🕒 History" id "nav-history" class "sidebar-item"
                        button "🎬 Your Videos" id "nav-your-videos" class "sidebar-item"
                        button "⏱️ Watch Later" id "nav-watch-later" class "sidebar-item"
                        button "👍 Liked Videos" id "nav-liked" class "sidebar-item"

                    div class "sidebar-divider"

                    div class "sidebar-section":
                        p "SUBSCRIPTIONS" class "sidebar-heading"
                        div class "sub-channel" id "sub-1":
                            span "☕" class "channel-icon"
                            span "Java & Spring Master" class "channel-name"
                        div class "sub-channel" id "sub-2":
                            span "🚀" class "channel-icon"
                            span "Enlang Official" class "channel-name"
                        div class "sub-channel" id "sub-3":
                            span "⚛️" class "channel-icon"
                            span "Next.js & React Pro" class "channel-name"
                        div class "sub-channel" id "sub-4":
                            span "🪐" class "channel-icon"
                            span "Three.js Creative 3D" class "channel-name"

                # Main Content Area
                main class "yt-content":
                    # Feed View (Home / Browse)
                    div id "view-feed" class "view-panel active":
                        # Category Filter Chips Bar
                        div class "category-bar" id "category-container":
                            button "All" id "chip-all" class "chip active"
                            button "Coding & AI" id "chip-coding" class "chip"
                            button "Java Backend" id "chip-java" class "chip"
                            button "Spring Boot" id "chip-spring" class "chip"
                            button "Enlang Stack" id "chip-enlang" class "chip"
                            button "System Design" id "chip-sysdesign" class "chip"
                            button "Next.js" id "chip-next" class "chip"
                            button "Cloudflare Edge" id "chip-edge" class "chip"
                            button "Lo-Fi Music" id "chip-music" class "chip"
                            button "Gaming" id "chip-gaming" class "chip"

                        # Video Cards Grid
                        div class "video-grid" id "video-grid-container":
                            # Video Card 1
                            div class "video-card" id "card-video-1":
                                div class "thumbnail-wrapper":
                                    div class "thumbnail-bg" style "background: linear-gradient(135deg, #1e3a8a, #3b82f6);":
                                        span "☕ Java 21 & Spring Boot 3.2 Full Masterclass" class "thumb-text"
                                    span "18:45" class "duration-badge"
                                div class "video-meta":
                                    div "P" class "channel-avatar"
                                    div class "video-details":
                                        h3 "Building High-Throughput Microservices with Java & Spring Boot" class "video-title"
                                        p "Prayas Kumar Sahoo • Java Backend" class "video-channel"
                                        p "245K views • 2 days ago" class "video-stats"

                            # Video Card 2
                            div class "video-card" id "card-video-2":
                                div class "thumbnail-wrapper":
                                    div class "thumbnail-bg" style "background: linear-gradient(135deg, #065f46, #10b981);":
                                        span "🪐 Enlang Compiler Architecture: Pure English Code" class "thumb-text"
                                    span "24:10" class "duration-badge"
                                div class "video-meta":
                                    div "E" class "channel-avatar"
                                    div class "video-details":
                                        h3 "How We Built Enlang: Compiling English to Python, JS & Flutter" class "video-title"
                                        p "Enlang Official • Compiler Engineering" class "video-channel"
                                        p "512K views • 1 week ago" class "video-stats"

                            # Video Card 3
                            div class "video-card" id "card-video-3":
                                div class "thumbnail-wrapper":
                                    div class "thumbnail-bg" style "background: linear-gradient(135deg, #701a75, #ec4899);":
                                        span "🌐 Cloudflare Pages + Next.js Zero 500 Errors" class "thumb-text"
                                    span "14:20" class "duration-badge"
                                div class "video-meta":
                                    div "C" class "channel-avatar"
                                    div class "video-details":
                                        h3 "Deploying Full-Stack Edge Apps on Cloudflare Workers & Pages" class "video-title"
                                        p "Edge Architects • Cloud Dev" class "video-channel"
                                        p "189K views • 3 days ago" class "video-stats"

                            # Video Card 4
                            div class "video-card" id "card-video-4":
                                div class "thumbnail-wrapper":
                                    div class "thumbnail-bg" style "background: linear-gradient(135deg, #7c2d12, #f97316);":
                                        span "🗄️ MySQL vs Oracle 19c: Query Optimization Masterclass" class "thumb-text"
                                    span "32:00" class "duration-badge"
                                div class "video-meta":
                                    div "D" class "channel-avatar"
                                    div class "video-details":
                                        h3 "Database Indexing, Stored Procedures & Connection Pooling" class "video-title"
                                        p "Database Wizardry • Performance" class "video-channel"
                                        p "98K views • 4 days ago" class "video-stats"

                            # Video Card 5
                            div class "video-card" id "card-video-5":
                                div class "thumbnail-wrapper":
                                    div class "thumbnail-bg" style "background: linear-gradient(135deg, #1e1b4b, #6366f1);":
                                        span "🎨 3D Solar & Lunar Shaders in WebGL & Three.js" class "thumb-text"
                                    span "21:15" class "duration-badge"
                                div class "video-meta":
                                    div "T" class "channel-avatar"
                                    div class "video-details":
                                        h3 "Procedural Corona Glows & Raymarched Moon Craters in WebGL" class "video-title"
                                        p "Creative Coding 3D • Shader Art" class "video-channel"
                                        p "340K views • 5 days ago" class "video-stats"

                            # Video Card 6
                            div class "video-card" id "card-video-6":
                                div class "thumbnail-wrapper":
                                    div class "thumbnail-bg" style "background: linear-gradient(135deg, #134e4a, #14b8a6);":
                                        span "📱 Enlang Mobile (.enlgm): 1:1 Flutter Compilation" class "thumb-text"
                                    span "16:40" class "duration-badge"
                                div class "video-meta":
                                    div "M" class "channel-avatar"
                                    div class "video-details":
                                        h3 "Build Android & iOS Flutter Apps with Pure English Sentences" class "video-title"
                                        p "Mobile Mastery • Cross-Platform" class "video-channel"
                                        p "420K views • 6 days ago" class "video-stats"

                    # Watch Page View (Player + Comments + Recommendations)
                    div id "view-watch" class "view-panel":
                        div class "watch-layout":
                            # Primary Watch Column
                            div class "watch-primary":
                                # Video Player Canvas
                                div class "video-player-container":
                                    div class "player-screen" id "player-canvas":
                                        div class "player-placeholder-content":
                                            span "▶" class "play-huge-icon" id "play-overlay-icon"
                                            h2 "Building High-Throughput Microservices with Java & Spring Boot" id "active-player-title"
                                            p "Streaming in 1080p60 HD • Pure Enlang Runtime" class "player-badge-sub"

                                    div class "player-controls":
                                        button "▶" id "btn-player-play" class "ctrl-btn"
                                        span "04:15 / 18:45" id "player-time-display" class "ctrl-time"
                                        div class "scrubber-bar" id "scrubber-track":
                                            div id "scrubber-progress" class "scrubber-fill" style "width: 25%;"
                                        button "🔊" id "btn-player-mute" class "ctrl-btn"
                                        button "⚙️ 1080p" id "btn-player-quality" class "ctrl-btn"
                                        button "⛶" id "btn-player-fullscreen" class "ctrl-btn"

                                # Video Title & Actions Bar
                                div class "watch-header":
                                    h1 "Building High-Throughput Microservices with Java & Spring Boot" id "watch-video-title" class "watch-title"
                                    
                                    div class "watch-actions-row":
                                        div class "channel-info-box":
                                            div "P" class "channel-avatar-lg"
                                            div:
                                                h4 "Prayas Kumar Sahoo" id "watch-channel-name" class "channel-title"
                                                p "128K subscribers" id "watch-sub-count" class "channel-subs"
                                            button "Subscribe" id "btn-subscribe" class "btn-subscribe"

                                        div class "action-buttons-group":
                                            div class "like-dislike-pill":
                                                button "👍 142K" id "btn-like" class "btn-like"
                                                div class "pill-sep"
                                                button "👎" id "btn-dislike" class "btn-dislike"
                                            button "↗ Share" id "btn-share" class "btn-action"
                                            button "⬇ Download" id "btn-download" class "btn-action"
                                            button "⋯ More" id "btn-more" class "btn-action"

                                # Description Box
                                div class "watch-description-box" id "desc-box":
                                    p "245,189 views • Premiered on Aug 15, 2026 • #Java #SpringBoot #Microservices" id "desc-stats" class "desc-stats"
                                    p "In this deep dive tutorial, Prayas Kumar Sahoo walks through architecting mission-critical Java 21 backend microservices, configuring HikariCP connection pools for Oracle & MySQL, and applying strict ACID transaction management." id "watch-desc-text" class "desc-content"

                                # Comments Section
                                div class "comments-container":
                                    div class "comments-header":
                                        h3 "328 Comments" id "comments-count-header"
                                        span "Sort by: Top Comments" class "sort-tag"

                                    # Add Comment Box
                                    div class "add-comment-row":
                                        div "U" class "user-avatar-sm"
                                        div class "comment-input-wrap":
                                            input type "text" id "new-comment-input" placeholder "Add a public comment..." class "comment-input"
                                            div class "comment-btn-bar":
                                                button "Cancel" id "btn-cancel-comment" class "btn-ghost"
                                                button "Comment" id "btn-submit-comment" class "btn-primary"

                                    # Comments List
                                    div class "comment-list" id "comment-list-container":
                                        div class "comment-card":
                                            div "A" class "user-avatar-sm" style "background: #3b82f6;"
                                            div class "comment-body":
                                                div class "comment-author-row":
                                                    span "@AlexDeveloper" class "comment-author"
                                                    span "2 hours ago" class "comment-time"
                                                p "The explanation of connection pooling and transaction propagation was crystal clear! Best Java video on YouTube." class "comment-msg"
                                                div class "comment-reactions":
                                                    button "👍 48" class "btn-react"
                                                    button "👎" class "btn-react"
                                                    button "Reply" class "btn-react"

                                        div class "comment-card":
                                            div "S" class "user-avatar-sm" style "background: #10b981;"
                                            div class "comment-body":
                                                div class "comment-author-row":
                                                    span "@SarahCode" class "comment-author"
                                                    span "5 hours ago" class "comment-time"
                                                p "Enlang compiling directly to Python, JS and Flutter is blowing my mind. Keep shipping!" class "comment-msg"
                                                div class "comment-reactions":
                                                    button "👍 124" class "btn-react"
                                                    button "👎" class "btn-react"
                                                    button "Reply" class "btn-react"

                            # Secondary Watch Column (Recommendations)
                            div class "watch-secondary":
                                h3 "Up Next" class "rec-header"
                                div class "rec-list":
                                    div class "rec-card" id "card-rec-2":
                                        div class "rec-thumb" style "background: linear-gradient(135deg, #065f46, #10b981);":
                                            span "24:10" class "duration-badge"
                                        div class "rec-details":
                                            h4 "How We Built Enlang Compiler" class "rec-title"
                                            p "Enlang Official" class "rec-channel"
                                            p "512K views" class "rec-stats"

                                    div class "rec-card" id "card-rec-3":
                                        div class "rec-thumb" style "background: linear-gradient(135deg, #701a75, #ec4899);":
                                            span "14:20" class "duration-badge"
                                        div class "rec-details":
                                            h4 "Deploying Edge Apps on Cloudflare" class "rec-title"
                                            p "Edge Architects" class "rec-channel"
                                            p "189K views" class "rec-stats"

                                    div class "rec-card" id "card-rec-5":
                                        div class "rec-thumb" style "background: linear-gradient(135deg, #1e1b4b, #6366f1);":
                                            span "21:15" class "duration-badge"
                                        div class "rec-details":
                                            h4 "3D Solar & Lunar WebGL Shaders" class "rec-title"
                                            p "Creative Coding 3D" class "rec-channel"
                                            p "340K views" class "rec-stats"

        # Toast Alert
        div id "yt-toast" class "yt-toast"
