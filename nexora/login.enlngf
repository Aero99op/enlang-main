document enlgf:
    head:
        title "Nexora Portal — Sovereign Authentication"
        connect design "styles.css"
        connect script "logic.js"

    body:
        header class "navbar":
            div class "container nav-inner":
                a href "/" class "brand-logo":
                    div class "logo-badge":
                        span "◆"
                    span "Nexora"
                ul class "nav-menu":
                    li:
                        a "Product" href "/product" class "nav-link"
                    li:
                        a "Solutions" href "/solutions" class "nav-link"
                    li:
                        a "Pricing" href "/pricing" class "nav-link"
                    li:
                        a "Resources" href "/resources" class "nav-link"
                div class "nav-actions":
                    a "Login" href "/login" class "btn-login active"
                    a "Get Started" href "/pricing" class "btn-pill-white"

        section class "auth-wrapper":
            div class "auth-card":
                div style "text-align: center; margin-bottom: 28px;":
                    div class "logo-badge" style "width: 38px; height: 38px; margin: 0 auto 14px;":
                        span "◆"
                    h2 "Welcome to Nexora" style "font-size: 1.7rem; font-weight: 800; color: #fff; margin-bottom: 6px;"
                    p "Sign in to access your sovereign developer workspaces" style "color: #94a3b8; font-size: 0.88rem;"

                button "Continue with GitHub" class "btn-oauth"
                button "Continue with Google" class "btn-oauth"

                div class "auth-divider" style "display: flex; align-items: center; text-align: center; margin: 20px 0; color: #64748b; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em;":
                    span "OR WITH EMAIL" style "padding: 0 10px; width: 100%;"

                form id "nexora_login_form":
                    div class "auth-input-group":
                        label "Work Email" class "auth-input-label"
                        input type "email" id "login_email" class "auth-input" placeholder "builder@nexora.app" required "required"

                    div class "auth-input-group":
                        label "Password" class "auth-input-label"
                        input type "password" id "login_password" class "auth-input" placeholder "••••••••••••" required "required"

                    button "Sign In to Dashboard →" type "submit" class "btn-auth-submit"

                div style "text-align: center; margin-top: 20px; font-size: 0.85rem; color: #94a3b8;":
                    span "Don't have an account? "
                    a "Sign up for free" href "/pricing" style "color: #3b82f6; font-weight: 600;"

        footer class "site-footer":
            div class "container":
                div class "footer-bottom":
                    p "© 2026 Nexora Platform Inc. All rights reserved. • Sovereign Architecture"

        div id "nexora_toast" class "toast-notification":
            span "🔔"
            span "Notification" id "toast_message"
