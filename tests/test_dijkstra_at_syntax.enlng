type enlng

# 5 Cities: Delhi(0), Jaipur(1), Agra(2), Bhopal(3), Mumbai(4)
# Distances from Source (Delhi: 0)
distances = [0, 999999, 999999, 999999, 999999]
visited = [false, false, false, false, false]

# Weighted Adjacency Matrix
graph = [
    [0, 4, 2, 0, 0],
    [4, 0, 1, 5, 0],
    [2, 1, 0, 8, 10],
    [0, 5, 8, 0, 2],
    [0, 0, 10, 2, 0]
]

# Dijkstra loop using 'at' syntax exclusively (Zero bracket lookups in the algorithm!)
for iter from 0 to 4:
    min_dist = 999999
    u = -1
    for v from 0 to 4:
        when visited at v == false and distances at v < min_dist:
            min_dist = distances at v
            u = v

    when u != -1:
        visited at u = true
        row_u = graph at u
        for v from 0 to 4:
            weight = row_u at v
            when weight > 0 and visited at v == false:
                new_dist = distances at u + weight
                when new_dist < distances at v:
                    distances at v = new_dist

show "Shortest distance to Delhi:" distances at 0
show "Shortest distance to Jaipur:" distances at 1
show "Shortest distance to Agra:" distances at 2
show "Shortest distance to Bhopal:" distances at 3
show "Shortest distance to Mumbai:" distances at 4

when distances at 0 == 0 and distances at 1 == 3 and distances at 2 == 2 and distances at 3 == 8 and distances at 4 == 10:
    show "[TEST PASS DIJKSTRA AT SYNTAX] Dijkstra without a single bracket lookup!"
otherwise:
    show "[FAIL DIJKSTRA AT SYNTAX]"
