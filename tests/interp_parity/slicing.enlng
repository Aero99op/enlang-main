type enlng
remember t as "hello world"
remember xs as [10, 20, 30, 40, 50]
show t[0:5]
show t[6:]
show t[:5]
show t[-5:]
show t[:-6]
show t[3:3] + "|"
show t[8:2] + "|"
show t[-100:100]
show xs[1:3]
show xs[:2]
show xs[3:]
show xs[-2:]
show xs[:]
show count of xs[1:4]
remember part as xs[0:2]
append(part, 99)
show part xs
remember n as 2
show t[n:n plus 3]
show t[n:count of t minus 1]
remember grid as [[1, 2, 3], [4, 5, 6]]
show grid[1][0:2]
show grid[1:][0]
show t[0:4]
show xs[:2]
show split("a,b,c,d", ",")[1:3]
for each w in xs[2:]:
    show w
show xs[1]
show t[4]
remember m as {"a": 1}
show m["a"]
remember num as 42
show num[0:1]
function slice_demo with s:
    give s[1:]
show slice_demo("xyz")
