type enlng
show to_number("42") plus 1
show to_number(" 3.5 ") times 2
show to_number("-7") to_number("1e3") to_number(5) to_number(2.5)
show to_text(42) + "!"
show to_text([1, "a", [2]])
show to_text({"k": 1})
show to_text(true) to_text(null) to_text("same")
show count of to_text(12345)
try:
    show to_number("12abc")
on error as e:
    show "caught:" e
try:
    show to_number("")
on error as e:
    show "caught:" e
try:
    show to_number([1])
on error as e:
    show "caught:" e
