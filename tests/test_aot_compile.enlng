type enlng

show "=============================================================="
show "    ENLANGG SOVEREIGN AOT NATIVE C COMPILATION TEST          "
show "=============================================================="

remember count as 0
remember total as 0

while count is less than 5:
    count increases by 1
    total = total + count * 10
    show "Loop step:" count "Current total:" total

when total is greater than 100:
    show "Test passed! Total exceeded 100:" total
otherwise:
    show "Total is:" total

show "AOT Native C Execution Finished with 0 Leaks!"
