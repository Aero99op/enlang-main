type enlng
node3 = { "val": 30, "next": null }
node2 = { "val": 20, "next": node3 }
node1 = { "val": 10, "next": node2 }

curr = node1
sum = 0
count = 0
while curr != null:
    sum = sum + curr.val
    count = count + 1
    curr = curr.next

when sum == 60 and count == 3:
    show "[TEST PASS 011] Linked List"
otherwise:
    show "[FAIL 011]"
