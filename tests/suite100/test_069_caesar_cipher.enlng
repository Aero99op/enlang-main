type enlng
# Simple shift simulation with dictionary lookup
alpha = "abcdefghijklmnopqrstuvwxyz"
shifted = "defghijklmnopqrstuvwxyzabc"
cipher_map = {}
for i from 0 to 25:
    cipher_map[alpha[i]] = shifted[i]

msg = "cab"
enc = cipher_map["c"] + cipher_map["a"] + cipher_map["b"]

when enc == "fde":
    show "[TEST PASS 069] Caesar Cipher"
otherwise:
    show "[FAIL 069]"
