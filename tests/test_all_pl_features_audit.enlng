type enlng

# ==============================================================================
# 🏛️ ENLNG SOVEREIGN 360° PROGRAMMING LANGUAGE CAPABILITY AUDIT
# Testing Every Single Core & Advanced Feature a Real Programming Language Offers
# ==============================================================================

# User Defined Functions & Recursion
action compute_factorial(n):
    when n <= 1:
        return 1
    return n * compute_factorial(n - 1)

action calculate_discount(price, tier):
    when tier == "VIP":
        return price * 0.8
    return price

action gcd(a, b):
    while b != 0:
        t = b
        b = a % b
        a = t
    return a

action is_prime(n):
    when n <= 1:
        return false
    d = 2
    while d * d <= n:
        when n % d == 0:
            return false
        d = d + 1
    return true

action relu(x):
    return max(0, x)

show ">>> [AUDIT START] Commencing Full 360° Enlng Capability Verification..."

# ------------------------------------------------------------------------------
# 1. PRIMITIVES & DATA TYPES
# ------------------------------------------------------------------------------
int_val = 42
float_val = 3.14159
str_val = "Sovereign Enlng"
bool_true = true
bool_false = false
null_val = null

when int_val == 42 and float_val > 3.14 and str_val == "Sovereign Enlng" and bool_true and not bool_false and null_val == null:
    show "[PASS 1/13] Primitives & Types (Int, Float, String, Bool, Null)"
otherwise:
    show "[FAIL 1/13] Primitives"

# ------------------------------------------------------------------------------
# 2. DECLARATIONS, IMMUTABILITY & MUTATIONS
# ------------------------------------------------------------------------------
remember mutable_counter as 100
freeze IMMUTABLE_MAGIC as 777

mutable_counter increases by 25
mutable_counter decreases by 5
change mutable_counter to 150

when mutable_counter == 150 and IMMUTABLE_MAGIC == 777:
    show "[PASS 2/13] Declarations, Freeze & In-Place Mutations"
otherwise:
    show "[FAIL 2/13] Declarations"

# ------------------------------------------------------------------------------
# 3. OPERATOR COMPREHENSIVENESS (DUAL OPERATORS & LOGIC)
# ------------------------------------------------------------------------------
a = 20
b = 10
sum_op = a plus b
diff_op = a minus b
prod_op = a times b
div_op = a divided by b
mod_op = a mod 7

logic_ok = false
when (a > b and b < a) or (a != b and not (b == a)):
    when a is greater than b and b is less than a:
        logic_ok = true

when sum_op == 30 and diff_op == 10 and prod_op == 200 and div_op == 2 and mod_op == 6 and logic_ok:
    show "[PASS 3/13] Dual Operators (Math, English Ops, Logical Conjunctions)"
otherwise:
    show "[FAIL 3/13] Operators"

# ------------------------------------------------------------------------------
# 4. DYNAMIC DATA STRUCTURES (LISTS & HASH MAPS)
# ------------------------------------------------------------------------------
dynamic_list = [10, 20, 30]
append(dynamic_list, 40)
list_len = count of dynamic_list

profile = {
    "username": "coder_99",
    "tier": "Master",
    "score": 950
}
profile["status"] = "active"
has_tier = has_key(profile, "tier")
profile_keys = keys(profile)
profile_vals = values(profile)

when dynamic_list[0] == 10 and dynamic_list[-1] == 40 and list_len == 4 and has_tier and profile.status == "active":
    show "[PASS 4/13] Dynamic Collections (Lists, Hash Maps, Nested Structure)"
otherwise:
    show "[FAIL 4/13] Dynamic Collections"

# ------------------------------------------------------------------------------
# 5. THE 4-WAY UNIVERSAL PROPERTY ACCESS (Brackets, Dot, At, Of)
# ------------------------------------------------------------------------------
user_record = {
    "role": "Architect",
    "clearance": 5
}

# Mode 1: Traditional Brackets
val_bracket = user_record["role"]

# Mode 2: Traditional Dot
val_dot = user_record.role

# Mode 3: Natural 'at' (Location)
val_at = user_record at "role"

# Mode 4: Natural 'of' (Ownership)
val_of = role of user_record

# Dynamic In-Place Mutation via 'of':
clearance of user_record increases by 2
change role of user_record to "GrandMaster"

when val_bracket == "Architect" and val_dot == "Architect" and val_at == "Architect" and val_of == "Architect" and role of user_record == "GrandMaster" and clearance of user_record == 7:
    show "[PASS 5/13] Universal 4-Way Property Access (Brackets, Dot, At, Of)"
otherwise:
    show "[FAIL 5/13] 4-Way Access"

# ------------------------------------------------------------------------------
# 6. FUNCTIONS, RECURSION & RETURN MODES
# ------------------------------------------------------------------------------
fact_result = compute_factorial(5)
disc_result = calculate_discount(1000, "VIP")

when fact_result == 120 and disc_result == 800:
    show "[PASS 6/13] First-Class Functions, Recursion & Scope Returns"
otherwise:
    show "[FAIL 6/13] Functions"

# ------------------------------------------------------------------------------
# 7. CONTROL FLOW & LOOPS
# ------------------------------------------------------------------------------
# A. Bounded Range Loop
range_sum = 0
for i from 1 to 5 by 1:
    range_sum increases by i

# B. Container Iteration
fruits = ["apple", "mango", "banana"]
fruit_count = 0
for f in fruits:
    fruit_count increases by 1

# C. Repeat While Loop with early stop
while_count = 0
repeat while while_count < 100:
    while_count increases by 1
    when while_count == 5:
        stop

when range_sum == 15 and fruit_count == 3 and while_count == 5:
    show "[PASS 7/13] Control Flow (Bounded Range, For-In, Repeat-While, Stop)"
otherwise:
    show "[FAIL 7/13] Loops"

# ------------------------------------------------------------------------------
# 8. SPATIAL ALGORITHMIC PRIMITIVES (Index-Free Sorting & Pair Swapping)
# ------------------------------------------------------------------------------
numbers_to_sort = [55, 12, 88, 3, 44, 91, 23]
repeat until sorted:
    for each pair in numbers_to_sort:
        when the left of the pair > the right of the pair:
            swap pair

when numbers_to_sort at 0 == 3 and numbers_to_sort at 1 == 12 and numbers_to_sort at 6 == 91:
    show "[PASS 8/13] Spatial Algorithmic Primitives (Index-Free Pair Swapping)"
otherwise:
    show "[FAIL 8/13] Spatial Sorting"

# ------------------------------------------------------------------------------
# 9. STRING PROCESSING & TEXT MANIPULATION
# ------------------------------------------------------------------------------
sample_text = "enlng,rocks,the,world"
has_world = contains(sample_text, "world")
first_char = sample_text[0]
last_char = sample_text[-1]

tokens = split(sample_text, ",")
rejoined = join(tokens, " ")

when has_world and first_char == "e" and last_char == "d" and count of tokens == 4 and rejoined == "enlng rocks the world":
    show "[PASS 9/13] String Processing (Indexing, Slicing, Contains, Split, Join)"
otherwise:
    show "[FAIL 9/13] String Processing"

# ------------------------------------------------------------------------------
# 10. MATHEMATICAL ENGINE & ADVANCED STATS
# ------------------------------------------------------------------------------
math_sqrt_val = sqrt(144)
math_pow_val = pow(2, 8)
math_abs_val = abs(-50)
math_min_val = min(15, 9)
math_max_val = max(15, 9)
math_gcd_val = gcd(48, 18)
math_prime_res = is_prime(29)

when math_sqrt_val == 12 and math_pow_val == 256 and math_abs_val == 50 and math_min_val == 9 and math_max_val == 15 and math_gcd_val == 6 and math_prime_res:
    show "[PASS 10/13] Mathematical Standard Library (sqrt, pow, abs, gcd, primes)"
otherwise:
    show "[FAIL 10/13] Math Standard Library"

# ------------------------------------------------------------------------------
# 11. MACHINE LEARNING & NUMERICAL TENSORS
# ------------------------------------------------------------------------------
vec_a = [1.0, 2.0, 3.0]
vec_b = [4.0, 5.0, 6.0]

dot_product = 0.0
for idx from 0 to 2 by 1:
    dot_product = dot_product + (vec_a at idx * vec_b at idx)

# Activation functions
relu_pos = relu(15.5)
relu_neg = relu(-10.0)

when dot_product == 32.0 and relu_pos == 15.5 and relu_neg == 0.0:
    show "[PASS 11/13] Machine Learning Primitives (Dot Product, Tensor Ops, ReLU)"
otherwise:
    show "[FAIL 11/13] ML Primitives"

# ------------------------------------------------------------------------------
# 12. PERSISTENT FILE SYSTEM & OS INTERFACE
# ------------------------------------------------------------------------------
test_audit_file = "audit_evidence.txt"
file_content = "ENLNG SOVEREIGN NATIVE PERSISTENCE CONFIRMED"
write_file(test_audit_file, file_content)

file_verified = false
when file_exists(test_audit_file):
    read_back = read_file(test_audit_file)
    when read_back == file_content:
        file_verified = true

system_timestamp = time_now()

when file_verified and system_timestamp > 0:
    show "[PASS 12/13] Persistent File I/O & Real-Time System OS Interface"
otherwise:
    show "[FAIL 12/13] File System"

# ------------------------------------------------------------------------------
# 13. SILENT WORDS ABSORPTION (Natural Human Fluency)
# ------------------------------------------------------------------------------
# In Enlng, 'the', 'that', 'it' are natively absorbed without breaking deterministic compilation
remember the initial_score as 90

human_sentence_ok = false
when the initial_score is at least 90:
    human_sentence_ok = true

when human_sentence_ok:
    show "[PASS 13/13] Grammatical Fluency (Silent Word Absorption Engine)"
otherwise:
    show "[FAIL 13/13] Silent Words"

