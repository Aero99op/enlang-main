    # Dedicated Trending Catalog
    define trendingCatalog as [ { rank: 1, id: "0e3GPea1Tyg", title: "$456,000 Squid Game In Real Life!", channel: "MrBeast", views: "630M views • Trending #1 on YouTube", desc: "456 people compete for $456,000 in real life recreation of Squid Game!", duration: "25:41", avatar: "https://yt3.ggpht.com/fxGKYucJAVme-YzgnGQru4xphDy00h7-hDxBJqJw-IdbvGiaEgB60eWfJY80cmJUqTv0umGl=s512-c-k-c0x00ffffff-no-rj" }, { rank: 2, id: "L_LUpnjgPso", title: "Grand Theft Auto VI Official Trailer 1 - 4K 60FPS", channel: "Rockstar Games", views: "215M views • Trending #2 on YouTube", desc: "Grand Theft Auto VI heads to the state of Leonida, home to the neon-soaked streets of Vice City.", duration: "01:31", avatar: "https://yt3.ggpht.com/ytc/AIdro_n8z5R9K3m5J7s=s512-c-k-c0x00ffffff-no-rj" }, { rank: 3, id: "gJrjgg1KVL4", title: "Spring Boot 3 Full Course 2025 - Beginner to Pro", channel: "Spandan Prayas Patra", views: "1.0M views • Trending #3 on YouTube", desc: "Complete guide to Java 21, Spring Boot 3, and high performance backend engineering.", duration: "1:11:22", avatar: "https://yt3.ggpht.com/SF6gtLA16ykecLQ-bEgYReAlazH0giurl5zfQyBMAClMofvSEE7IiKSdbFNDf40EcNYzKwPjfA=s512-c-k-c0x00ffffff-no-rj" } ]

    # Dynamic Real YouTube Shorts Pool (Fetched live from YouTube API with pagination)
    define dynamicShortsList as [ { title: "🔥 3 Insane Java 21 Performance Hacks you never knew existed! #Java #SpringBoot #Dev", author: "@SpandanPrayas", audio: "🎵 Spandan Original Audio • High Performance Remix", views: "3.2M", bg: "linear-gradient(180deg, #1e3a8a, #0f172a)", vid: "gJrjgg1KVL4" }, { title: "⚡ $456,000 Squid Game Behind The Scenes Secret #MrBeast #Challenge", author: "@MrBeast", audio: "🎵 Squid Game Official Theme", views: "45.1M", bg: "linear-gradient(180deg, #991b1b, #450a0a)", vid: "0e3GPea1Tyg" }, { title: "🎮 GTA 6 Vice City Graphics will blow your mind #GTA6 #Rockstar #Gaming", author: "@RockstarGames", audio: "🎵 Love Is A Long Road • Tom Petty", views: "12.4M", bg: "linear-gradient(180deg, #831843, #500724)", vid: "L_LUpnjgPso" } ]

    # Toast Notification Helper (100% Pure Enlang Syntax)
    to do showToast with message:
        set text of "yt-toast" to message
        show element "yt-toast"
        after 3 seconds:
            hide element "yt-toast"

    # Time Formatter Helper (100% Pure Enlang Logic)
    to do formatDuration with secs:
        create m as Math.floor(secs / 60)
        create s as secs % 60
        create mStr as m < 10 ? "0" + m : "" + m
        create sStr as s < 10 ? "0" + s : "" + s
        return mStr + ":" + sStr

    # PostMessage Controller for YouTube iframe player
    to do sendPlayerCmd with funcName, args:
        create ifr as document.getElementById("player-iframe")
        if ifr != null and ifr.contentWindow != null:
            ifr.contentWindow.postMessage(JSON.stringify({ event: "command", func: funcName, args: args || [] }), "*")

    to do sendShortsCmd with funcName, args:
        create ifr as document.getElementById("shorts-iframe")
        if ifr != null and ifr.contentWindow != null:
            ifr.contentWindow.postMessage(JSON.stringify({ event: "command", func: funcName, args: args || [] }), "*")

    # Scrubber Seek Logic
    to do seekScrubber with evt:
        create scrubberEl as document.getElementById("player-scrubber")
        if scrubberEl != null:
            create rect as scrubberEl.getBoundingClientRect()
            create pos as (evt.clientX - rect.left) / rect.width
            create clampedPos as Math.max(0, Math.min(1, pos))
            set playSeconds = Math.floor(clampedPos * totalVideoSeconds)
            create fillBar as document.getElementById("scrubber-progress")
            if fillBar != null:
                fillBar.style.width = (clampedPos * 100) + "%"
            create curStr as formatDuration(playSeconds)
            create totStr as formatDuration(totalVideoSeconds)
            set text of "player-time-display" to curStr + " / " + totStr
            call sendPlayerCmd with "seekTo", [playSeconds, true]
            call showToast with "⏩ Seeked to " + curStr

    # Chapter Seek Logic
    to do seekToChapter with sec, label:
        set playSeconds = sec
        call sendPlayerCmd with "seekTo", [sec, true]
        call showToast with "📍 Seeked to " + label

    # Hide all views helper (100% Pure Enlang Syntax)
    to do hideAllViews:
        hide element "view-feed"
        hide element "view-shorts"
        hide element "view-watch"
        hide element "view-subs"
        hide element "view-library"
        hide element "view-trending"
        hide element "dropdown-profile"
        hide element "dropdown-notif"

    # Open Home Feed View (100% Pure Enlang Syntax)
    to do openHomeFeed:
        set currentSearchQuery = ""
        set currentFeedPage = 1
        call hideAllViews
        show element "view-feed"
        window.scrollTo(0, 0)
        call renderGrid with homeCatalog
        set text of "live-status-title" to "🔴 YouTube Live Feed"
        set text of "live-status-desc" to "Displaying verified live YouTube stream catalog • Infinite Scroll active"
        call showToast with "🏠 YouTube Home Feed"

    # Open Shorts Reel View (100% Pure Enlang Syntax)
    to do openShortsReel:
        call hideAllViews
        show element "view-shorts"
        window.scrollTo(0, 0)
        call fetchMoreRealShorts
        call renderActiveShort with 0
        call showToast with "⚡ YouTube Shorts Reel active"

    # Open Subscriptions Feed (100% Pure Enlang Syntax)
    to do openSubsFeed:
        call hideAllViews
        show element "view-subs"
        window.scrollTo(0, 0)
        renderSubsGrid()
        call showToast with "📺 Subscriptions Feed"

    # Open Library / History View (100% Pure Enlang Syntax)
    to do openLibrary:
        call hideAllViews
        show element "view-library"
        window.scrollTo(0, 0)
        renderLibraryView()
        call showToast with "📁 Library & Watch History"

    # Open Trending View (100% Pure Enlang Syntax)
    to do openTrending:
        call hideAllViews
        show element "view-trending"
        window.scrollTo(0, 0)
        renderTrendingList()
        call showToast with "🔥 Trending on YouTube"

    # ── REAL YOUTUBE SHORTS LIVE FETCHER & INFINITE SCROLLER ──
    async to do fetchMoreRealShorts:
        if isFetchingShorts == true:
            return
        set isFetchingShorts = true
        create sUrl as "https://invidious.flokinet.to/api/v1/search?q=" + encodeURIComponent("#shorts viral trending") + "&page=" + currentShortsPage + "&type=video"
        try:
            create resp as await fetch(sUrl)
            create dataList as await resp.json()
            if dataList != null and dataList.length > 0:
                for each sItem in dataList:
                    create sId as sItem.videoId
                    create sTitle as sItem.title || "YouTube Short"
                    create sAuthor as "@" + (sItem.author ? sItem.author.split(" ").join("") : "Creator")
                    create sViews as sItem.viewCount ? (sItem.viewCount > 1000000 ? (sItem.viewCount/1000000).toFixed(1) + "M" : (sItem.viewCount/1000).toFixed(0) + "K") : "1.2M"
                    create sBg as "linear-gradient(180deg, #1e1b4b, #0f172a)"
                    dynamicShortsList.push({ title: sTitle, author: sAuthor, audio: "🎵 Original Audio • Trending Sound", views: sViews, bg: sBg, vid: sId })
                set currentShortsPage = currentShortsPage + 1
        catch err:
            show "Shorts fetch fallback active"
        set isFetchingShorts = false

    # Render Active Short in Reel (100% Pure Enlang Syntax)
    to do renderActiveShort with idx:
        if idx >= dynamicShortsList.length - 2:
            call fetchMoreRealShorts

        if idx < 0:
            set idx = 0
        if idx >= dynamicShortsList.length:
            set idx = dynamicShortsList.length - 1

        set currentShortIndex = idx
        create s as dynamicShortsList[idx]
        if s == null:
            return

        set background of "shorts-active-box" to s.bg
        create sIfr as document.getElementById("shorts-iframe")
        if sIfr != null:
            sIfr.src = "https://www.youtube-nocookie.com/embed/" + s.vid + "?autoplay=1&enablejsapi=1&controls=0&loop=1"
        set text of "shorts-title-text" to s.title
        set text of "shorts-author-name" to s.author
        set text of "shorts-audio-text" to s.audio
        set text of "shorts-like-count" to s.views

    # Dynamic Chapters Renderer (100% Pure Enlang Syntax)
    to do renderChaptersForVideo with vidId, title:
        create cWrapper as document.getElementById("chapters-container")
        if cWrapper != null:
            cWrapper.innerHTML = ""
            create chs as [ { sec: 0, label: "00:00 • Intro & Overview" }, { sec: 180, label: "03:00 • Architecture Deep Dive" }, { sec: 420, label: "07:00 • Implementation & Code" }, { sec: 780, label: "13:00 • Live Production Demo" }, { sec: 1020, label: "17:00 • Summary & Benchmarks" } ]
            for each ch in chs:
                create btn as document.createElement("button")
                btn.className = "chapter-btn"
                btn.textContent = ch.label
                btn.onclick = function() { seekToChapter(ch.sec, ch.label); }
                cWrapper.appendChild(btn)

    # ── REAL LIVE YOUTUBE COMMENTS FETCHER (Zero Dummy Placeholders) ──
    async to do fetchLiveCommentsForVideo with vidId, title, channel:
        create cContainer as document.getElementById("comment-list-container")
        if cContainer == null:
            return

        set html of "comment-list-container" to "<div style='padding:20px; color:#aaa; font-size:14px;'>⏳ Fetching live YouTube comments over internet...</div>"
        create cUrl as "https://invidious.flokinet.to/api/v1/comments/" + vidId

        try:
            create resp as await fetch(cUrl)
            create data as await resp.json()
            create comments as data.comments || []

            if comments.length > 0:
                set cContainer.innerHTML = ""
                set totalComments = comments.length
                set text of "comments-count-header" to totalComments + " Comments (Live YouTube)"

                for each c in comments:
                    create card as document.createElement("div")
                    card.className = c.isPinned ? "comment-card pinned" : "comment-card"

                    create authorName as c.author || "Viewer"
                    create authorAvatar as (c.authorThumbnails && c.authorThumbnails.length > 0) ? c.authorThumbnails[0].url : ""
                    create authorInit as authorName.replace(/^@/, "").charAt(0).toUpperCase() || "Y"
                    create pinnedHeader as c.isPinned ? "<span class='pinned-tag'>📌 Pinned by " + channel + "</span>" : ""
                    create publishedTime as c.publishedText || "Recently"
                    create commentText as c.content || ""
                    create likeCount as c.likeCount ? (c.likeCount > 1000 ? (c.likeCount/1000).toFixed(1) + "K" : c.likeCount) : "0"

                    create avatarHtml as ""
                    if authorAvatar != "":
                        set avatarHtml = "<div class='user-avatar-sm'><img src='" + authorAvatar + "' class='comment-avatar-img' onerror=\"this.style.display='none'; this.nextElementSibling.style.display='flex';\" /><span style='display:none;'>" + authorInit + "</span></div>"
                    else:
                        set avatarHtml = "<div class='user-avatar-sm' style='background: #3b82f6;'>" + authorInit + "</div>"

                    card.innerHTML = avatarHtml + "<div class='comment-body'>" + pinnedHeader + "<div class='comment-author-row'><span class='comment-author'>" + authorName + "</span><span class='comment-time'>" + publishedTime + "</span></div><p class='comment-msg'>" + commentText + "</p><div class='comment-reactions'><button class='btn-react'>👍 " + likeCount + "</button><button class='btn-react'>👎</button><button class='btn-react'>Reply</button></div></div>"
                    cContainer.appendChild(card)
                call showToast with "💬 Loaded " + comments.length + " live YouTube comments!"
            else:
                set html of "comment-list-container" to "<div style='padding:20px; color:#aaa; font-size:14px;'>Be the first to comment on this live stream!</div>"
                set text of "comments-count-header" to "0 Comments"
        catch err:
            set html of "comment-list-container" to "<div style='padding:20px; color:#aaa; font-size:14px;'>Live comments temporarily unavailable. Post a new comment below!</div>"

    # Open Watch Page with REAL Video Metadata & REAL Channel Avatar (100% Pure Enlang Syntax)
    to do openWatchPage with vidId, title, channel, views, desc, avatar:
        set currentVideoId = vidId
        create targetTitle as title || "YouTube Stream Video"
        create targetChannel as channel || "YouTube Creator"
        create targetViews as views || "100K views"
        create targetDesc as desc || ("Watch " + targetTitle + " streaming in high definition on YouTube.")
        create targetAvatar as avatar || "Y"

        set text of "watch-video-title" to targetTitle
        set text of "watch-channel-name" to targetChannel
        set text of "watch-desc-text" to targetDesc
        set text of "desc-stats" to targetViews + " • Premiered recently"

        # Update Real Channel Avatar Logo on Watch Page
        create wAvatarEl as document.getElementById("watch-channel-avatar")
        if wAvatarEl != null:
            if targetAvatar.startsWith("http") || targetAvatar.startsWith("//"):
                wAvatarEl.innerHTML = "<img src='" + targetAvatar + "' class='channel-avatar-img' onerror=\"this.style.display='none'; this.nextElementSibling.style.display='flex';\" /><span style='display:none;'>" + targetChannel.charAt(0) + "</span>"
            else:
                wAvatarEl.innerHTML = "<span>" + targetAvatar + "</span>"

        # Update Share Link
        set value of "share-link-input" to "https://youtu.be/" + vidId

        # Mount Real YouTube Iframe Stream
        create pIframe as document.getElementById("player-iframe")
        if pIframe != null:
            pIframe.src = "https://www.youtube-nocookie.com/embed/" + vidId + "?autoplay=1&enablejsapi=1"

        # Ambient Glow
        create ambientEl as document.getElementById("player-ambient-light")
        if ambientEl != null:
            ambientEl.style.background = "radial-gradient(circle, rgba(59, 130, 246, 0.35) 0%, rgba(15, 15, 15, 0) 75%)"

        # Reset Player Play State
        set isPlaying = true
        set text of "btn-player-play" to "⏸"
        set playSeconds = 0

        call hideAllViews
        show element "view-watch"

        window.scrollTo(0, 0)
        renderRecommendations(vidId)
        renderChaptersForVideo(vidId, targetTitle)
        call fetchLiveCommentsForVideo with vidId, targetTitle, targetChannel
        call showToast with "▶ Playing: " + targetTitle

    # Quick Play Helper by Video Item
    to do playVideoItem with item:
        if item != null:
            call openWatchPage with item.id, item.title, item.channel, item.views, item.desc, item.avatar

    # Render Recommendations in Watch View (100% Pure Enlang Syntax)
    to do renderRecommendations with activeVidId:
        create recList as document.getElementById("rec-list-container")
        if recList != null:
            recList.innerHTML = ""
            create others as homeCatalog.filter(function(item) { return item.id !== activeVidId; })
            for each item in others:
                create card as document.createElement("div")
                card.className = "rec-card"
                card.innerHTML = "<div class='rec-thumb'><img src='https://i.ytimg.com/vi/" + item.id + "/hqdefault.jpg' class='thumb-real-img' /><span class='duration-badge'>" + item.duration + "</span></div><div class='rec-details'><h4 class='rec-title'>" + item.title + "</h4><p class='rec-channel'>" + item.channel + " ✓</p><p class='rec-stats'>" + item.views + "</p></div>"
                card.onclick = function() { playVideoItem(item); }
                recList.appendChild(card)

    # Render Subscriptions Feed (100% Pure Enlang Syntax)
    to do renderSubsGrid:
        create sRow as document.getElementById("subs-channels-row")
        if sRow != null:
            sRow.innerHTML = ""
            create subChannels as [ { name: "Spandan Prayas", avatar: "https://yt3.ggpht.com/SF6gtLA16ykecLQ-bEgYReAlazH0giurl5zfQyBMAClMofvSEE7IiKSdbFNDf40EcNYzKwPjfA=s512-c-k-c0x00ffffff-no-rj" }, { name: "MrBeast", avatar: "https://yt3.ggpht.com/fxGKYucJAVme-YzgnGQru4xphDy00h7-hDxBJqJw-IdbvGiaEgB60eWfJY80cmJUqTv0umGl=s512-c-k-c0x00ffffff-no-rj" }, { name: "JavaScript Mastery", avatar: "https://yt3.ggpht.com/wg1TITEoPfxvBGfzu-mm1mVmEBoTU4m9Lk0dtoqY4AXjS5ndQm92RrGQMgL2xKTcq0JyNxW9=s512-c-k-c0x00ffffff-no-rj" }, { name: "Snax Gaming", avatar: "https://yt3.ggpht.com/SF6gtLA16ykecLQ-bEgYReAlazH0giurl5zfQyBMAClMofvSEE7IiKSdbFNDf40EcNYzKwPjfA=s512-c-k-c0x00ffffff-no-rj" } ]
            for each sc in subChannels:
                create bubble as document.createElement("div")
                bubble.className = "channel-story-bubble"
                bubble.innerHTML = "<div class='channel-story-avatar'><img src='" + sc.avatar + "' class='channel-avatar-img' /></div><span class='channel-story-name'>" + sc.name + "</span>"
                bubble.onclick = function() { searchLiveYouTube(sc.name); }
                sRow.appendChild(bubble)

        create sGrid as document.getElementById("subs-grid-container")
        if sGrid != null:
            sGrid.innerHTML = ""
            for each item in subsCatalog:
                create card as document.createElement("div")
                card.className = "video-card"
                create avHtml as (item.avatar && item.avatar.startsWith("http")) ? "<div class='channel-avatar'><img src='" + item.avatar + "' class='channel-avatar-img' /></div>" : "<div class='channel-avatar'>" + (item.avatar || item.channel.charAt(0)) + "</div>"
                card.innerHTML = "<div class='thumbnail-wrapper'><img src='https://i.ytimg.com/vi/" + item.id + "/hqdefault.jpg' class='thumb-real-img' /><span class='duration-badge'>" + item.duration + "</span></div><div class='video-meta'>" + avHtml + "<div class='video-details'><h3 class='video-title'>" + item.title + "</h3><p class='video-channel'>" + item.channel + " ✓</p><p class='video-stats'>" + item.views + "</p></div></div>"
                card.onclick = function() { playVideoItem(item); }
                sGrid.appendChild(card)

    # Render Library & Watch History View (100% Pure Enlang Syntax)
    to do renderLibraryView:
        create hContainer as document.getElementById("history-list-container")
        if hContainer != null:
            hContainer.innerHTML = ""
            for each item in historyCatalog:
                create card as document.createElement("div")
                card.className = "history-card"
                card.innerHTML = "<div class='history-thumb'><img src='https://i.ytimg.com/vi/" + item.id + "/hqdefault.jpg' class='thumb-real-img' /><span class='duration-badge'>" + item.duration + "</span></div><div class='history-details'><h3 class='history-title'>" + item.title + "</h3><p class='history-sub'>" + item.channel + " • " + item.views + "</p><p class='history-time'>" + item.time + "</p></div>"
                card.onclick = function() { playVideoItem(item); }
                hContainer.appendChild(card)

        create wlContainer as document.getElementById("watch-later-container")
        if wlContainer != null:
            wlContainer.innerHTML = ""
            for each item in watchLaterCatalog:
                create card as document.createElement("div")
                card.className = "video-card"
                create avHtml as (item.avatar && item.avatar.startsWith("http")) ? "<div class='channel-avatar'><img src='" + item.avatar + "' class='channel-avatar-img' /></div>" : "<div class='channel-avatar'>" + (item.avatar || item.channel.charAt(0)) + "</div>"
                card.innerHTML = "<div class='thumbnail-wrapper'><img src='https://i.ytimg.com/vi/" + item.id + "/hqdefault.jpg' class='thumb-real-img' /><span class='duration-badge'>" + item.duration + "</span></div><div class='video-meta'>" + avHtml + "<div class='video-details'><h3 class='video-title'>" + item.title + "</h3><p class='video-channel'>" + item.channel + " ✓</p><p class='video-stats'>" + item.views + "</p></div></div>"
                card.onclick = function() { playVideoItem(item); }
                wlContainer.appendChild(card)

        create lkContainer as document.getElementById("liked-videos-container")
        if lkContainer != null:
            lkContainer.innerHTML = ""
            for each item in likedCatalog:
                create card as document.createElement("div")
                card.className = "video-card"
                create avHtml as (item.avatar && item.avatar.startsWith("http")) ? "<div class='channel-avatar'><img src='" + item.avatar + "' class='channel-avatar-img' /></div>" : "<div class='channel-avatar'>" + (item.avatar || item.channel.charAt(0)) + "</div>"
                card.innerHTML = "<div class='thumbnail-wrapper'><img src='https://i.ytimg.com/vi/" + item.id + "/hqdefault.jpg' class='thumb-real-img' /><span class='duration-badge'>" + item.duration + "</span></div><div class='video-meta'>" + avHtml + "<div class='video-details'><h3 class='video-title'>" + item.title + "</h3><p class='video-channel'>" + item.channel + " ✓</p><p class='video-stats'>" + item.views + "</p></div></div>"
                card.onclick = function() { playVideoItem(item); }
                lkContainer.appendChild(card)

    # Render Trending Page List (100% Pure Enlang Syntax)
    to do renderTrendingList:
        create tContainer as document.getElementById("trending-list-container")
        if tContainer != null:
            tContainer.innerHTML = ""
            for each item in trendingCatalog:
                create card as document.createElement("div")
                card.className = "trending-card"
                card.innerHTML = "<div class='trending-rank-badge'>#" + item.rank + "</div><div class='history-thumb'><img src='https://i.ytimg.com/vi/" + item.id + "/hqdefault.jpg' class='thumb-real-img' /><span class='duration-badge'>" + item.duration + "</span></div><div class='history-details'><h3 class='history-title'>" + item.title + "</h3><p class='history-sub'>" + item.channel + " ✓ • " + item.views + "</p><p class='desc-content' style='color:#aaa; font-size:12px;'>" + item.desc + "</p></div>"
                card.onclick = function() { playVideoItem(item); }
                tContainer.appendChild(card)

    # Render Dynamic Video Cards to Main Grid with Real Channel Avatars (100% Pure Enlang Syntax)
    to do renderGrid with items:
        create grid as document.getElementById("video-grid-container")
        if grid != null:
            grid.innerHTML = ""
            for each item in items:
                create card as document.createElement("div")
                card.className = "video-card"
                card.id = "card-" + item.id

                create avatarHtml as ""
                if item.avatar != null && (item.avatar.startsWith("http") || item.avatar.startsWith("//")):
                    set avatarHtml = "<div class='channel-avatar'><img src='" + item.avatar + "' class='channel-avatar-img' onerror=\"this.style.display='none'; this.nextElementSibling.style.display='flex';\" /><span style='display:none;'>" + item.channel.charAt(0) + "</span></div>"
                else:
                    set avatarHtml = "<div class='channel-avatar'>" + (item.avatar || item.channel.charAt(0)) + "</div>"

                card.innerHTML = "<div class='thumbnail-wrapper'><img src='https://i.ytimg.com/vi/" + item.id + "/hqdefault.jpg' class='thumb-real-img' onerror=\"this.src='https://i.ytimg.com/vi/" + item.id + "/mqdefault.jpg'\" /><span class='duration-badge'>" + item.duration + "</span></div><div class='video-meta'>" + avatarHtml + "<div class='video-details'><h3 class='video-title'>" + item.title + "</h3><p class='video-channel'>" + item.channel + " ✓</p><p class='video-stats'>" + item.views + "</p></div></div>"
                card.onclick = function() { playVideoItem(item); }
                grid.appendChild(card)

    # ── CONTEXT-AWARE INFINITE LOAD MORE (Search-Specific or Feed-Specific Pagination) ──
    async to do loadMoreContent:
        set currentFeedPage = currentFeedPage + 1
        create grid as document.getElementById("video-grid-container")
        if grid == null:
            return

        call showToast with "⏳ Loading page " + currentFeedPage + " from live YouTube..."

        if currentSearchQuery != "":
            create targetUrl as "https://invidious.flokinet.to/api/v1/search?q=" + encodeURIComponent(currentSearchQuery) + "&page=" + currentFeedPage + "&type=video"
            try:
                create resp as await fetch(targetUrl)
                create apiList as await resp.json()
                if apiList != null and apiList.length > 0:
                    for each item in apiList:
                        create vId as item.videoId
                        create vTitle as item.title || "YouTube Video"
                        create vAuthor as item.author || "YouTube Creator"
                        create vAvatar as (item.authorThumbnails && item.authorThumbnails.length > 0) ? item.authorThumbnails[item.authorThumbnails.length - 1].url : ""
                        create vViews as (item.viewCount ? (item.viewCount > 1000000 ? (item.viewCount/1000000).toFixed(1) + "M views" : (item.viewCount/1000).toFixed(0) + "K views") : "100K views") + " • " + (item.publishedText || "Recently")
                        create vDur as item.lengthSeconds ? (Math.floor(item.lengthSeconds/60) + ":" + ((item.lengthSeconds%60 < 10 ? "0" : "") + (item.lengthSeconds%60))) : "10:00"
                        create vDesc as item.description || ("Watch " + vTitle + " live on YouTube.")
                        create cardObj as { id: vId, title: vTitle, channel: vAuthor, views: vViews, duration: vDur, desc: vDesc, avatar: vAvatar, category: "All" }

                        create card as document.createElement("div")
                        card.className = "video-card"
                        card.id = "card-" + vId
                        create avHtml as (vAvatar != "") ? "<div class='channel-avatar'><img src='" + vAvatar + "' class='channel-avatar-img' onerror=\"this.style.display='none'; this.nextElementSibling.style.display='flex';\" /><span style='display:none;'>" + vAuthor.charAt(0) + "</span></div>" : "<div class='channel-avatar'>" + vAuthor.charAt(0) + "</div>"
                        card.innerHTML = "<div class='thumbnail-wrapper'><img src='https://i.ytimg.com/vi/" + vId + "/hqdefault.jpg' class='thumb-real-img' onerror=\"this.src='https://i.ytimg.com/vi/" + vId + "/mqdefault.jpg'\" /><span class='duration-badge'>" + vDur + "</span></div><div class='video-meta'>" + avHtml + "<div class='video-details'><h3 class='video-title'>" + vTitle + "</h3><p class='video-channel'>" + vAuthor + " ✓</p><p class='video-stats'>" + vViews + "</p></div></div>"
                        card.onclick = function() { playVideoItem(cardObj); }
                        grid.appendChild(card)

                    call showToast with "✨ Loaded " + apiList.length + " more live YouTube videos for '" + currentSearchQuery + "'!"
            catch err:
                call showToast with "No more live videos found for this search"
        else:
            # Home feed pagination
            create pool as homeCatalog
            if currentCategoryFilter != "All":
                create filtered as homeCatalog.filter(function(item) { return item.category == currentCategoryFilter; })
                if filtered.length > 0:
                    set pool = filtered
            for each item in pool:
                create card as document.createElement("div")
                card.className = "video-card"
                create avHtml as (item.avatar && item.avatar.startsWith("http")) ? "<div class='channel-avatar'><img src='" + item.avatar + "' class='channel-avatar-img' /></div>" : "<div class='channel-avatar'>" + (item.avatar || item.channel.charAt(0)) + "</div>"
                card.innerHTML = "<div class='thumbnail-wrapper'><img src='https://i.ytimg.com/vi/" + item.id + "/hqdefault.jpg' class='thumb-real-img' /><span class='duration-badge'>" + item.duration + "</span></div><div class='video-meta'>" + avHtml + "<div class='video-details'><h3 class='video-title'>" + item.title + "</h3><p class='video-channel'>" + item.channel + " ✓</p><p class='video-stats'>" + item.views + "</p></div></div>"
                card.onclick = function() { playVideoItem(item); }
                grid.appendChild(card)
            call showToast with "✨ Loaded " + pool.length + " more videos into home feed!"

    # Category Filter Logic (100% Pure Enlang Syntax)
    to do filterByCategory with categoryName:
        set currentCategoryFilter = categoryName
        create allChips as document.querySelectorAll(".chip")
        allChips.forEach(function(chip) { chip.classList.remove("active"); })

        if categoryName == "All":
            add class "active" to "chip-all"
            call renderGrid with homeCatalog
            set text of "live-status-title" to "🔴 All YouTube Feed"
            set text of "live-status-desc" to "Displaying " + homeCatalog.length + " live videos across all genres • Infinite Scroll active"
        else:
            create filtered as homeCatalog.filter(function(item) { return item.category == categoryName; })
            if filtered.length == 0:
                set filtered = homeCatalog
            call renderGrid with filtered
            set text of "live-status-title" to "🔴 Category: " + categoryName
            set text of "live-status-desc" to "Displaying " + filtered.length + " curated live YouTube videos for " + categoryName

        call showToast with "Showing category: " + categoryName

    # Search Match Helper
    to do matchVideoQuery with v, qLow:
        create fullText as (v.title + " " + v.channel + " " + v.desc + " " + v.category).toLowerCase()
        if fullText.indexOf(qLow) != -1:
            return true
        if qLow.indexOf("gta") != -1 and fullText.indexOf("grand theft auto") != -1:
            return true
        if qLow.indexOf("squid") != -1 and fullText.indexOf("squid") != -1:
            return true
        if qLow.indexOf("mrbeast") != -1 and fullText.indexOf("mrbeast") != -1:
            return true
        return false

    # ── REAL-TIME LIVE YOUTUBE ONLINE FETCHER (With Real Channel Logos & Avatars) ──
    async to do fetchLiveYouTubeFromWeb with query:
        set text of "live-status-title" to "⚡ Fetching live YouTube stream results for: " + query + "..."
        set text of "live-status-desc" to "Connecting to live YouTube API stream..."
        create targetUrl as "https://invidious.flokinet.to/api/v1/search?q=" + encodeURIComponent(query) + "&page=1&type=video"

        try:
            create response as await fetch(targetUrl)
            create apiList as await response.json()
            if apiList != null and apiList.length > 0:
                create liveCards as []
                for each item in apiList:
                    create vId as item.videoId
                    create vTitle as item.title || "YouTube Video"
                    create vAuthor as item.author || "YouTube Creator"
                    create vAvatar as (item.authorThumbnails && item.authorThumbnails.length > 0) ? item.authorThumbnails[item.authorThumbnails.length - 1].url : ""
                    create vViews as (item.viewCount ? (item.viewCount > 1000000 ? (item.viewCount/1000000).toFixed(1) + "M views" : (item.viewCount/1000).toFixed(0) + "K views") : "100K views") + " • " + (item.publishedText || "Recently")
                    create vDur as item.lengthSeconds ? (Math.floor(item.lengthSeconds/60) + ":" + ((item.lengthSeconds%60 < 10 ? "0" : "") + (item.lengthSeconds%60))) : "10:00"
                    create vDesc as item.description || ("Watch " + vTitle + " live on YouTube.")
                    liveCards.push({ id: vId, title: vTitle, channel: vAuthor, views: vViews, duration: vDur, desc: vDesc, avatar: vAvatar, category: "All" })

                call renderGrid with liveCards
                set text of "live-status-title" to "🔴 Live YouTube Search Results for: " + query
                set text of "live-status-desc" to "Fetched " + liveCards.length + " real YouTube videos live with official channel logos"
                call showToast with "🎬 Fetched " + liveCards.length + " live YouTube videos for '" + query + "'"
        catch err:
            call showToast with "Displaying instant matches for '" + query + "'"

    # ── GLOBAL SEARCH & DIRECT YOUTUBE URL RESOLVER ──
    to do searchLiveYouTube with query:
        create q as (query || "").trim()
        if q == "":
            set currentSearchQuery = ""
            set currentFeedPage = 1
            call renderGrid with homeCatalog
            return

        set currentSearchQuery = q
        set currentFeedPage = 1

        # Check if query is a Direct YouTube URL or raw 11-char ID
        create directVidId as ""
        if q.length == 11 and q.indexOf(" ") == -1:
            set directVidId = q
        else:
            if q.includes("youtube.com/watch?v="):
                set directVidId = q.split("v=")[1].split("&")[0]
            else:
                if q.includes("youtu.be/"):
                    set directVidId = q.split("youtu.be/")[1].split("?")[0]

        if directVidId != "":
            call openWatchPage with directVidId, ("Live Video Stream (" + directVidId + ")"), "YouTube Direct Stream", "1 view • Just loaded", "Direct stream loaded from YouTube URL.", "Y"
            call showToast with "🎬 Directly playing YouTube stream: " + directVidId
            return

        # Instant Preliminary Local Matches (<5ms)
        create qLow as q.toLowerCase()
        create matches as homeCatalog.filter(function(v) { return matchVideoQuery(v, qLow); })

        call hideAllViews
        show element "view-feed"

        if matches.length > 0:
            call renderGrid with matches
        else:
            call renderGrid with homeCatalog

        # Trigger Live YouTube Search with Real Avatars
        call fetchLiveYouTubeFromWeb with q

    # Initial App Load: Render All Feed Cards
    call renderGrid with homeCatalog

    # Attach Live Instant Search Listener on Search Input (Enter key + Keyup + Input)
    create searchInpEl as document.getElementById("search-input")
    if searchInpEl != null:
        searchInpEl.onkeyup = function(e) { if (e.key === "Enter") { searchLiveYouTube(searchInpEl.value); } }
        searchInpEl.oninput = function() { if (searchInpEl.value.length >= 3) { searchLiveYouTube(searchInpEl.value); } }

    # Attach Timeline Scrubber Click & Seek Controller
    create scrubberEl as document.getElementById("player-scrubber")
    if scrubberEl != null:
        scrubberEl.onclick = function(e) { seekScrubber(e); }

    # Attach Mouse Wheel Listener to Shorts Container for Infinite Scrolling
    create shortsContEl as document.getElementById("view-shorts")
    if shortsContEl != null:
        shortsContEl.onwheel = function(e) { if (e.deltaY > 30) { renderActiveShort(currentShortIndex + 1); } if (e.deltaY < -30) { renderActiveShort(currentShortIndex - 1); } }

    # ── SIDEBAR NAVIGATION (100% Pure Enlang Syntax) ──
    when "nav-home" is clicked:
        call openHomeFeed

    when "btn-logo" is clicked:
        call openHomeFeed

    when "nav-shorts" is clicked:
        call openShortsReel

    when "nav-subs" is clicked:
        call openSubsFeed

    when "nav-library" is clicked:
        call openLibrary

    when "nav-history" is clicked:
        call openLibrary

    when "nav-your-videos" is clicked:
        call openSubsFeed
        call showToast with "🎬 Your uploaded videos (Spandan Prayas Patra)"

    when "nav-watch-later" is clicked:
        call openLibrary
        call showToast with "⏱️ Watch Later playlist (14 videos)"

    when "nav-liked" is clicked:
        call openLibrary
        call showToast with "👍 Liked videos playlist (86 videos)"

    when "sub-1" is clicked:
        call filterByCategory with "Java Backend"

    when "sub-2" is clicked:
        call filterByCategory with "Enlang Stack"

    when "sub-3" is clicked:
        call filterByCategory with "Next.js"

    when "sub-4" is clicked:
        call filterByCategory with "Coding & AI"

    when "sub-5" is clicked:
        call searchLiveYouTube with "MrBeast"

    when "nav-trending" is clicked:
        call openTrending

    when "nav-music" is clicked:
        call filterByCategory with "Lo-Fi Music"

    when "nav-gaming" is clicked:
        call filterByCategory with "Gaming"

    when "nav-news" is clicked:
        call searchLiveYouTube with "World Tech News"

    when "nav-sports" is clicked:
        call searchLiveYouTube with "Cricket Highlights"

    # Infinite Load More Trigger (Context-Aware Pagination)
    when "btn-load-more" is clicked:
        call loadMoreContent

    # Sidebar Collapse Toggle
    when "btn-sidebar-toggle" is clicked:
        toggle class "collapsed" on "yt-sidebar"

    # ── TOP BAR ACTIONS, PROFILE & MODALS (100% PURE ENLGS) ──
    when "btn-create" is clicked:
        show element "modal-create"

    when "btn-close-create" is clicked:
        hide element "modal-create"

    when "btn-cancel-upload" is clicked:
        hide element "modal-create"

    when "btn-publish-video" is clicked:
        create uTitleInp as document.getElementById("upload-title-input")
        create uTitle as (uTitleInp != null && uTitleInp.value) ? uTitleInp.value : "New Enlang Video by Spandan Prayas Patra"
        create newV as { id: "gJrjgg1KVL4", title: uTitle, channel: "Spandan Prayas Patra", subs: "128K subscribers", views: "1 view • Just now", desc: "Newly uploaded creator video in Enlang.", category: "All", duration: "12:30", avatar: "https://yt3.ggpht.com/SF6gtLA16ykecLQ-bEgYReAlazH0giurl5zfQyBMAClMofvSEE7IiKSdbFNDf40EcNYzKwPjfA=s512-c-k-c0x00ffffff-no-rj" }
        homeCatalog.unshift(newV)
        call openHomeFeed
        hide element "modal-create"
        call showToast with "🚀 Video Published Live: " + uTitle

    when "btn-notif" is clicked:
        create dNotif as document.getElementById("dropdown-notif")
        if dNotif != null:
            if dNotif.style.display == "flex":
                hide element "dropdown-notif"
            else:
                dNotif.style.display = "flex"

    when "btn-voice" is clicked:
        call showToast with "🎙️ Listening... Say 'Snax Gaming', 'Spring Boot', or 'MrBeast'"

    # User Profile Dropdown Menu Toggle
    when "user-profile" is clicked:
        create dProf as document.getElementById("dropdown-profile")
        if dProf != null:
            if dProf.style.display == "flex":
                hide element "dropdown-profile"
            else:
                dProf.style.display = "flex"

    when "btn-profile-channel" is clicked:
        call openSubsFeed
        call showToast with "👤 Opening Your Channel (@SpandanPrayas)"

    when "btn-profile-studio" is clicked:
        call showToast with "🎬 YouTube Studio Creator Dashboard"

    when "btn-profile-switch" is clicked:
        call showToast with "🔄 Account Switcher Dialog"

    when "btn-profile-signout" is clicked:
        call showToast with "🚪 Signed out of YouTube"

    when "btn-profile-location" is clicked:
        call showToast with "🌐 Location: India (IN)"

    when "btn-share" is clicked:
        show element "modal-share"

    when "btn-close-share" is clicked:
        hide element "modal-share"

    when "btn-copy-share" is clicked:
        hide element "modal-share"
        call showToast with "🔗 Link copied to clipboard!"

    # Live Search Execution on Button Click
    when "btn-search" is clicked:
        create sInpEl as document.getElementById("search-input")
        if sInpEl != null:
            call searchLiveYouTube with sInpEl.value

    # ── CATEGORY FILTER CHIPS ──
    when "chip-all" is clicked:
        call filterByCategory with "All"

    when "chip-coding" is clicked:
        call filterByCategory with "Coding & AI"

    when "chip-java" is clicked:
        call filterByCategory with "Java Backend"

    when "chip-spring" is clicked:
        call filterByCategory with "Java Backend"

    when "chip-enlang" is clicked:
        call filterByCategory with "Enlang Stack"

    when "chip-sysdesign" is clicked:
        call filterByCategory with "System Design"

    when "chip-next" is clicked:
        call filterByCategory with "Next.js"

    when "chip-edge" is clicked:
        call filterByCategory with "Next.js"

    when "chip-music" is clicked:
        call filterByCategory with "Lo-Fi Music"

    when "chip-gaming" is clicked:
        call filterByCategory with "Gaming"

    when "chip-science" is clicked:
        call filterByCategory with "Science & Tech"

    when "chip-podcasts" is clicked:
        call filterByCategory with "System Design"

    # Shorts Shelf Card Clicks
    when "short-shelf-1" is clicked:
        call openShortsReel

    when "short-shelf-2" is clicked:
        call openShortsReel

    when "short-shelf-3" is clicked:
        call openShortsReel

    when "short-shelf-4" is clicked:
        call openShortsReel

    # ── VIDEO PLAYER NATIVE CONTROLS (POSTMESSAGE ENABLED) ──
    when "btn-player-play" is clicked:
        if isPlaying == true:
            set isPlaying = false
            set text of "btn-player-play" to "▶"
            call sendPlayerCmd with "pauseVideo", []
            call showToast with "⏸ Stream paused"
        else:
            set isPlaying = true
            set text of "btn-player-play" to "⏸"
            call sendPlayerCmd with "playVideo", []
            call showToast with "▶ Stream playing"

    when "btn-player-next" is clicked:
        create nextItem as homeCatalog[1]
        call openWatchPage with nextItem.id, nextItem.title, nextItem.channel, nextItem.views, nextItem.desc, nextItem.avatar

    when "btn-player-mute" is clicked:
        if isMuted == true:
            set isMuted = false
            set text of "btn-player-mute" to "🔊"
            call sendPlayerCmd with "unMute", []
            call showToast with "Audio unmuted (100%)"
        else:
            set isMuted = true
            set text of "btn-player-mute" to "🔇"
            call sendPlayerCmd with "mute", []
            call showToast with "Audio muted"

    when "btn-player-speed" is clicked:
        create sBtn as document.getElementById("btn-player-speed")
        create rate as 1
        if playbackSpeed == "1x":
            set playbackSpeed = "1.5x"
            set rate = 1.5
        else:
            if playbackSpeed == "1.5x":
                set playbackSpeed = "2x"
                set rate = 2
            else:
                if playbackSpeed == "2x":
                    set playbackSpeed = "0.5x"
                    set rate = 0.5
                else:
                    set playbackSpeed = "1x"
                    set rate = 1
        if sBtn != null:
            sBtn.innerText = playbackSpeed
        call sendPlayerCmd with "setPlaybackRate", [rate]
        call showToast with "⚡ Playback Speed: " + playbackSpeed

    # Quality Option Cycle (1080p -> 4K -> 1440p -> 720p -> 480p)
    when "btn-player-quality" is clicked:
        create qList as [ "1080p HD", "4K (2160p)", "1440p QHD", "720p HD", "480p", "Auto" ]
        set qualityIndex = (qualityIndex + 1) % qList.length
        create curQ as qList[qualityIndex]
        set text of "btn-player-quality" to "⚙️ " + curQ
        call sendPlayerCmd with "setPlaybackQuality", [curQ.toLowerCase()]
        call showToast with "⚙️ Quality set to " + curQ

    when "btn-player-cc" is clicked:
        call showToast with "📝 Closed Captions: English (Auto-generated)"

    when "btn-player-fullscreen" is clicked:
        create pCont as document.querySelector(".video-player-container")
        if document.fullscreenElement == null:
            if pCont != null:
                pCont.requestFullscreen()
                call showToast with "Entered Fullscreen Player"
        else:
            document.exitFullscreen()
            call showToast with "Exited Fullscreen Player"

    # ── TIMELINE SCRUBBER & CHAPTERS (POSTMESSAGE SEEK) ──
    every 1 second:
        if isPlaying == true:
            if playSeconds < totalVideoSeconds:
                set playSeconds = playSeconds + 1
                create curStr as formatDuration(playSeconds)
                create totStr as formatDuration(totalVideoSeconds)
                set text of "player-time-display" to curStr + " / " + totStr
                create pct as (playSeconds / totalVideoSeconds) * 100
                create fillBar as document.getElementById("scrubber-progress")
                if fillBar != null:
                    fillBar.style.width = pct + "%"

    when "ch-1" is clicked:
        set playSeconds = 0
        call sendPlayerCmd with "seekTo", [0, true]
        call showToast with "📍 Chapter: 00:00 • Introduction"

    when "ch-2" is clicked:
        set playSeconds = 255
        call sendPlayerCmd with "seekTo", [255, true]
        call showToast with "📍 Chapter: 04:15 • Setup"

    when "ch-3" is clicked:
        set playSeconds = 570
        call sendPlayerCmd with "seekTo", [570, true]
        call showToast with "📍 Chapter: 09:30 • Core Logic"

    when "ch-4" is clicked:
        set playSeconds = 840
        call sendPlayerCmd with "seekTo", [840, true]
        call showToast with "📍 Chapter: 14:00 • Benchmarks"

    # ── SOCIAL ACTIONS (LIKE, SUBSCRIBE, JOIN, SHARE, CLIP) ──
    when "btn-join" is clicked:
        call showToast with "⭐ Welcome! Channel Membership perks unlocked."

    when "btn-subscribe" is clicked:
        create sBtn as document.getElementById("btn-subscribe")
        if isSubscribed == true:
            set isSubscribed = false
            set text of "btn-subscribe" to "Subscribe"
            if sBtn != null:
                sBtn.style.background = "#ffffff"
                sBtn.style.color = "#0f0f0f"
            call showToast with "Unsubscribed from Creator"
        else:
            set isSubscribed = true
            set text of "btn-subscribe" to "Subscribed ✓"
            if sBtn != null:
                sBtn.style.background = "#272727"
                sBtn.style.color = "#aaaaaa"
            call showToast with "🔔 Subscribed to Creator!"

    when "btn-like" is clicked:
        create lBtn as document.getElementById("btn-like")
        if isLiked == true:
            set isLiked = false
            set text of "btn-like" to "👍 142K"
            if lBtn != null:
                lBtn.style.color = "#f1f1f1"
        else:
            set isLiked = true
            set text of "btn-like" to "👍 142.1K"
            if lBtn != null:
                lBtn.style.color = "#3ea6ff"
            call showToast with "Added to Liked Videos"

    when "btn-dislike" is clicked:
        call showToast with "Disliked video"

    when "btn-download" is clicked:
        call showToast with "⬇ Downloading 1080p stream for offline playback..."

    when "btn-clip" is clicked:
        call showToast with "✂ Create Clip dialog opened"

    when "btn-more" is clicked:
        call showToast with "⋯ Options: Save to Playlist, Report, Transcript"

    # ── SHORTS REEL CONTROLS (UNLIMITED INFINITE REAL SHORTS) ──
    when "btn-shorts-next" is clicked:
        call renderActiveShort with (currentShortIndex + 1)
        call showToast with "Next Short loaded"

    when "btn-shorts-prev" is clicked:
        call renderActiveShort with (currentShortIndex - 1)
        call showToast with "Previous Short loaded"

    when "btn-shorts-like" is clicked:
        if isShortsLiked == true:
            set isShortsLiked = false
            set text of "shorts-like-count" to "245K"
        else:
            set isShortsLiked = true
            set text of "shorts-like-count" to "245.1K"
            call showToast with "Liked Short!"

    when "btn-shorts-dislike" is clicked:
        call showToast with "Disliked Short"

    when "btn-shorts-comment" is clicked:
        call showToast with "💬 Opening Shorts Comments (4.2K)"

    when "btn-shorts-share" is clicked:
        call showToast with "🔗 Shorts link copied!"

    when "btn-shorts-sub" is clicked:
        create sBtn as document.getElementById("btn-shorts-sub")
        if sBtn != null:
            if sBtn.innerText == "Subscribe":
                set text of "btn-shorts-sub" to "Subscribed ✓"
                sBtn.style.background = "#272727"
                sBtn.style.color = "#aaaaaa"
                call showToast with "Subscribed to Creator!"
            else:
                set text of "btn-shorts-sub" to "Subscribe"
                sBtn.style.background = "#ffffff"
                sBtn.style.color = "#0f0f0f"

    when "btn-shorts-mute" is clicked:
        call sendShortsCmd with "mute", []
        call showToast with "Shorts audio toggled"

    # ── REAL-TIME USER COMMENTS (Live Add) ──
    to do postComment:
        create cInp as document.getElementById("new-comment-input")
        if cInp == null || cInp.value.trim() == "":
            call showToast with "Please type a comment before posting"
            return
        create cText as cInp.value.trim()

        create cContainer as document.getElementById("comment-list-container")
        if cContainer != null:
            create cCard as document.createElement("div")
            cCard.className = "comment-card"
            cCard.innerHTML = "<div class='user-avatar-sm' style='background: #8b5cf6;'>S</div><div class='comment-body'><div class='comment-author-row'><span class='comment-author'>@SpandanPrayas (You)</span><span class='comment-time'>Just now</span></div><p class='comment-msg'>" + cText + "</p><div class='comment-reactions'><button class='btn-react'>👍 1</button><button class='btn-react'>👎</button><button class='btn-react'>Reply</button></div></div>"
            cContainer.prepend(cCard)
            set cInp.value = ""
            set totalComments = totalComments + 1
            set text of "comments-count-header" to totalComments + " Comments"
            call showToast with "💬 Comment posted publicly!"

    when "btn-submit-comment" is clicked:
        call postComment

    when "btn-cancel-comment" is clicked:
        set value of "new-comment-input" to ""

    # Clear History (100% Pure Enlang Syntax)
    when "btn-clear-history" is clicked:
        set html of "history-list-container" to "<p style='color: #888; padding: 20px;'>Watch history is empty.</p>"
        call showToast with "🗑️ Watch History Cleared"

    # Theme Toggle (OLED Dark <-> Pure Black Text Light Mode)
    when "btn-theme" is clicked:
        create b as document.body
        if b.classList.contains("light-theme"):
            remove class "light-theme" from "body"
            set text of "btn-theme" to "☾"
            call showToast with "Switched to YouTube Dark Mode"
        else:
            add class "light-theme" to "body"
            set text of "btn-theme" to "☼"
            call showToast with "Switched to YouTube Light Mode"

    when "btn-profile-appearance" is clicked:
        create b as document.body
        if b.classList.contains("light-theme"):
            remove class "light-theme" from "body"
            set text of "btn-theme" to "☾"
            call showToast with "Switched to YouTube Dark Mode"
        else:
            add class "light-theme" to "body"
            set text of "btn-theme" to "☼"
            call showToast with "Switched to YouTube Light Mode"
