# Enlang Script (.enlgs) - YouTube 1:1 Complete Engine

in script:
    # State Declarations
    create isPlaying as true
    create isMuted as false
    create isSubscribed as false
    create isLiked as false
    create currentVideoId as "gJrjgg1KVL4"
    create currentShortIndex as 0
    create totalComments as 328
    create playSeconds as 255
    create totalVideoSeconds as 4282
    create playbackSpeed as "1x"
    create isShortsLiked as false

    show "▶ Initializing YouTube 1:1 Live Engine in Pure Enlang (.enlgs)..."

    # Default Curated Live Video Database (Real YouTube IDs & HD Thumbnails)
    define liveVideoCatalog as [ { id: "gJrjgg1KVL4", title: "Spring Boot 3 Full Course 2025 - Beginner to Pro", channel: "Spandan Prayas Patra", subs: "128K subscribers", views: "1,039,987 views • Premiered on Aug 15, 2026", desc: "In this deep dive tutorial, Spandan Prayas Patra walks through architecting mission-critical Java 21 backend microservices, configuring HikariCP connection pools for Oracle & MySQL, and applying strict ACID transaction management.", ambient: "rgba(59, 130, 246, 0.3)", duration: "1:11:22" }, { id: "dQw4w9WgXcQ", title: "Rick Astley - Never Gonna Give You Up (Official Music Video 4K)", channel: "Rick Astley", subs: "3.4M subscribers", views: "1,520,840,112 views • 14 years ago", desc: "The official video for 'Never Gonna Give You Up' by Rick Astley. 4K Remastered.", ambient: "rgba(236, 72, 153, 0.3)", duration: "03:33" }, { id: "8aGhZQkoFbQ", title: "Next.js 15 & React 19 Full Stack Masterclass", channel: "JavaScript Mastery", subs: "1.1M subscribers", views: "489,420 views • 3 weeks ago", desc: "Master full-stack Next.js with Server Actions, Edge Middleware, and Cloudflare Deployments.", ambient: "rgba(16, 185, 129, 0.3)", duration: "2:45:10" }, { id: "HXV3zeRR3h4", title: "System Design for High Scale - 100 Million Users", channel: "ByteByteGo", subs: "1.9M subscribers", views: "980,120 views • 1 month ago", desc: "An insider look into database sharding, distributed caches, and load balancers at massive scale.", ambient: "rgba(249, 115, 22, 0.3)", duration: "18:24" }, { id: "Q7AOvWpIVHU", title: "Three.js 3D Web Graphics & WebGL Shaders Tutorial", channel: "Creative Coding 3D", subs: "340K subscribers", views: "340,900 views • 5 days ago", desc: "Shader art tutorial implementing dual plasma rings and procedural celestial textures in WebGL.", ambient: "rgba(99, 102, 241, 0.3)", duration: "21:15" }, { id: "pTJJsmejUOQ", title: "Flutter 3.24 & Dart Full Course for Mobile Apps", channel: "FreeCodeCamp", subs: "9.8M subscribers", views: "1,420,150 views • 2 months ago", desc: "Build cross-platform iOS & Android mobile applications with clean architecture.", ambient: "rgba(20, 184, 166, 0.3)", duration: "4:32:00" } ]

    # Shorts Database
    define shortsList as [ { title: "🔥 3 Insane Java 21 Performance Hacks you never knew existed! #Java #SpringBoot #Dev", author: "@SpandanPrayas", audio: "🎵 Spandan Original Audio • High Performance Remix", views: "3.2M", bg: "linear-gradient(180deg, #1e3a8a, #0f172a)", vid: "gJrjgg1KVL4" }, { title: "🚀 Write Clean Code in English with Enlang! Zero boilerplate #Enlang #Compilers", author: "@EnlangOfficial", audio: "🎵 Enlang Sound Studio • Compiler Waves", views: "1.8M", bg: "linear-gradient(180deg, #047857, #064e3b)", vid: "dQw4w9WgXcQ" }, { title: "🌐 Cloudflare Workers under 1ms Latency around the world #Edge #Cloudflare", author: "@EdgeArchitects", audio: "🎵 Ultra Edge Lo-Fi Beat", views: "950K", bg: "linear-gradient(180deg, #6d28d9, #2e1065)", vid: "8aGhZQkoFbQ" }, { title: "✨ Raymarched Black Hole in 30 Lines of WebGL Shader #Threejs #GLSL", author: "@CreativeCoding3D", audio: "🎵 Cosmic Raymarch Audio", views: "2.4M", bg: "linear-gradient(180deg, #b45309, #451a03)", vid: "Q7AOvWpIVHU" } ]

    # Toast Notification Helper in Pure Enlgs
    to do showToast with message:
        create toastEl as document.getElementById("yt-toast")
        if toastEl != null:
            toastEl.textContent = message
            toastEl.style.display = "block"
            after 3 seconds:
                create t2 as document.getElementById("yt-toast")
                if t2 != null:
                    t2.style.display = "none"

    # Time Formatter Helper in Pure Enlgs
    to do formatDuration with secs:
        create m as Math.floor(secs / 60)
        create s as secs % 60
        create mStr as m < 10 ? "0" + m : "" + m
        create sStr as s < 10 ? "0" + s : "" + s
        return mStr + ":" + sStr

    # Hide all views helper in Pure Enlgs
    to do hideAllViews:
        create pFeed as document.getElementById("view-feed")
        create pShorts as document.getElementById("view-shorts")
        create pWatch as document.getElementById("view-watch")
        create pSubs as document.getElementById("view-subs")
        create pLib as document.getElementById("view-library")
        if pFeed != null:
            pFeed.style.display = "none"
        if pShorts != null:
            pShorts.style.display = "none"
        if pWatch != null:
            pWatch.style.display = "none"
        if pSubs != null:
            pSubs.style.display = "none"
        if pLib != null:
            pLib.style.display = "none"

    # Open Home Feed in Pure Enlgs
    to do openHomeFeed:
        call hideAllViews
        create pFeed as document.getElementById("view-feed")
        if pFeed != null:
            pFeed.style.display = "block"
        window.scrollTo(0, 0)
        call showToast with "🏠 YouTube Home Feed"

    # Open Shorts Reel View in Pure Enlgs
    to do openShortsReel:
        call hideAllViews
        create pShorts as document.getElementById("view-shorts")
        if pShorts != null:
            pShorts.style.display = "block"
        window.scrollTo(0, 0)
        call renderActiveShort with 0
        call showToast with "⚡ YouTube Shorts Reel active"

    # Open Subscriptions Feed in Pure Enlgs
    to do openSubsFeed:
        call hideAllViews
        create pSubs as document.getElementById("view-subs")
        if pSubs != null:
            pSubs.style.display = "block"
        window.scrollTo(0, 0)
        call showToast with "📺 Subscriptions Feed"

    # Open Library / History View in Pure Enlgs
    to do openLibrary:
        call hideAllViews
        create pLib as document.getElementById("view-library")
        if pLib != null:
            pLib.style.display = "block"
        window.scrollTo(0, 0)
        call showToast with "📁 Library & Watch History"

    # Render Active Short in Reel
    to do renderActiveShort with idx:
        set currentShortIndex = idx
        create s as shortsList[idx]
        if s == null:
            return
        create sBox as document.getElementById("shorts-active-box")
        if sBox != null:
            sBox.style.background = s.bg
        create sDesc as document.getElementById("shorts-title-text")
        if sDesc != null:
            sDesc.textContent = s.title

    # Load and Stream Video by ID (Embedding Real Live YouTube Stream)
    to do openWatchPage with vidId:
        set currentVideoId = vidId
        create v as liveVideoCatalog.find(function(item) { return item.id == vidId; })
        if v == null:
            create customV as { id: vidId, title: "YouTube Stream #" + vidId, channel: "YouTube Creator", subs: "100K subscribers", views: "Real-time YouTube Stream", desc: "Streaming live from YouTube Innertube Engine.", ambient: "rgba(59, 130, 246, 0.3)" }
            set v = customV

        set text of "watch-video-title" to v.title
        set text of "watch-channel-name" to v.channel
        set text of "watch-sub-count" to v.subs
        set text of "watch-desc-text" to v.desc
        set text of "desc-stats" to v.views

        # Mount Real YouTube Iframe Embed
        create pIframe as document.getElementById("player-iframe")
        if pIframe != null:
            pIframe.src = "https://www.youtube-nocookie.com/embed/" + vidId + "?autoplay=1&enablejsapi=1"

        create ambientEl as document.getElementById("player-ambient-light")
        if ambientEl != null:
            ambientEl.style.background = "radial-gradient(circle, " + (v.ambient || "rgba(59,130,246,0.3)") + " 0%, rgba(15, 15, 15, 0) 75%)"

        call hideAllViews
        create pWatch as document.getElementById("view-watch")
        if pWatch != null:
            pWatch.style.display = "block"

        window.scrollTo(0, 0)
        call showToast with "▶ Now Streaming: " + v.title

    # Render Dynamic Video Cards to Grid
    to do renderDynamicGrid with items:
        create grid as document.getElementById("video-grid-container")
        if grid != null:
            grid.innerHTML = ""
            for each item in items:
                create card as document.createElement("div")
                card.className = "video-card"
                card.id = "card-live-" + item.id
                card.innerHTML = "<div class='thumbnail-wrapper'><img src='" + item.thumb + "' class='thumb-real-img' /><span class='duration-badge'>" + item.duration + "</span></div><div class='video-meta'><div class='channel-avatar'>" + item.channel.charAt(0) + "</div><div class='video-details'><h3 class='video-title'>" + item.title + "</h3><p class='video-channel'>" + item.channel + " ✓</p><p class='video-stats'>" + item.views + "</p></div></div>"
                card.onclick = function() { openWatchPage(item.id); }
                grid.appendChild(card)

    # Category Filter Logic in Pure Enlgs
    to do renderCategoryFilter with categoryName:
        create filtered as liveVideoCatalog
        create mapped as filtered.map(function(v) { return { id: v.id, title: v.title, channel: v.channel, views: v.views, duration: v.duration, thumb: "https://i.ytimg.com/vi/" + v.id + "/hqdefault.jpg" }; })
        renderDynamicGrid(mapped)
        create statusSub as document.querySelector(".live-subtext")
        if statusSub != null:
            statusSub.textContent = "Displaying YouTube feed for category: " + categoryName

    # ── INNERTUBE LIVE SEARCH & FEED ENGINE IN PURE ENLGS ──
    to do searchLiveYouTube with query:
        call showToast with "🔍 Fetching live YouTube feed for: " + query
        create statusSub as document.querySelector(".live-subtext")
        if statusSub != null:
            statusSub.textContent = "Fetching live videos for: " + query + "..."

        create payload as JSON.stringify({ context: { client: { clientName: "WEB", clientVersion: "2.20240101.01.00", gl: "IN", hl: "en" } }, query: query })
        
        fetch("https://www.youtube.com/youtubei/v1/search", { method: "POST", headers: { "Content-Type": "application/json" }, body: payload }).then(function(res) { return res.json(); }).then(function(data) { var primary = data.contents && data.contents.twoColumnSearchResultsRenderer && data.contents.twoColumnSearchResultsRenderer.primaryContents && data.contents.twoColumnSearchResultsRenderer.primaryContents.sectionListRenderer && data.contents.twoColumnSearchResultsRenderer.primaryContents.sectionListRenderer.contents; if (primary && primary.length > 0) { var items = []; var sectionContents = primary[0].itemSectionRenderer && primary[0].itemSectionRenderer.contents; if (sectionContents) { sectionContents.forEach(function(c) { if (c.videoRenderer && c.videoRenderer.videoId) { var vr = c.videoRenderer; var title = vr.title && vr.title.runs && vr.title.runs[0] ? vr.title.runs[0].text : "YouTube Video"; var ch = vr.ownerText && vr.ownerText.runs && vr.ownerText.runs[0] ? vr.ownerText.runs[0].text : "Creator"; var views = vr.viewCountText ? vr.viewCountText.simpleText : "100K views"; var dur = vr.lengthText ? vr.lengthText.simpleText : "10:00"; items.push({ id: vr.videoId, title: title, channel: ch, views: views, duration: dur, thumb: "https://i.ytimg.com/vi/" + vr.videoId + "/hqdefault.jpg" }); } }); } if (items.length > 0) { renderDynamicGrid(items); if (statusSub != null) { statusSub.textContent = "Loaded " + items.length + " live YouTube videos for: " + query; } showToast("✨ Loaded " + items.length + " live YouTube videos!"); return; } } renderCategoryFilter(query); }).catch(function(err) { renderCategoryFilter(query); });

    # ── VIDEO CARDS CLICK HANDLERS ──
    when "card-video-1" is clicked:
        call openWatchPage with "gJrjgg1KVL4"

    when "card-video-2" is clicked:
        call openWatchPage with "dQw4w9WgXcQ"

    when "card-video-3" is clicked:
        call openWatchPage with "8aGhZQkoFbQ"

    when "card-video-4" is clicked:
        call openWatchPage with "HXV3zeRR3h4"

    when "card-video-5" is clicked:
        call openWatchPage with "Q7AOvWpIVHU"

    when "card-video-6" is clicked:
        call openWatchPage with "pTJJsmejUOQ"

    # Up Next Recommendation Cards
    when "card-rec-2" is clicked:
        call openWatchPage with "dQw4w9WgXcQ"

    when "card-rec-3" is clicked:
        call openWatchPage with "8aGhZQkoFbQ"

    when "card-rec-5" is clicked:
        call openWatchPage with "Q7AOvWpIVHU"

    when "subs-card-1" is clicked:
        call openWatchPage with "gJrjgg1KVL4"

    when "subs-card-2" is clicked:
        call openWatchPage with "dQw4w9WgXcQ"

    # Shorts Shelf Cards on Home Feed
    when "short-1" is clicked:
        call openShortsReel

    when "short-2" is clicked:
        call openShortsReel

    when "short-3" is clicked:
        call openShortsReel

    when "short-4" is clicked:
        call openShortsReel

    # ── SIDEBAR NAVIGATION ──
    when "nav-home" is clicked:
        call openHomeFeed

    when "btn-logo" is clicked:
        call openHomeFeed

    when "nav-shorts" is clicked:
        call openShortsReel

    when "nav-subs" is clicked:
        call openSubsFeed

    when "nav-library" is clicked:
        call openLibrary

    when "nav-history" is clicked:
        call openLibrary

    when "nav-your-videos" is clicked:
        call showToast with "🎬 Your uploaded videos list"

    when "nav-watch-later" is clicked:
        call showToast with "⏱️ Watch Later list (14 videos)"

    when "nav-liked" is clicked:
        call showToast with "👍 Liked videos playlist (86 videos)"

    when "sub-1" is clicked:
        call searchLiveYouTube with "Java 21 Spring Boot"

    when "sub-2" is clicked:
        call searchLiveYouTube with "Enlang Compiler Architecture"

    when "sub-3" is clicked:
        call searchLiveYouTube with "Next.js 15 React 19"

    when "sub-4" is clicked:
        call searchLiveYouTube with "Three.js WebGL Shaders"

    when "nav-trending" is clicked:
        call searchLiveYouTube with "Trending in India"

    when "nav-music" is clicked:
        call searchLiveYouTube with "Top Music Songs"

    when "nav-gaming" is clicked:
        call searchLiveYouTube with "Trending Gaming Gameplay"

    when "nav-news" is clicked:
        call searchLiveYouTube with "World Tech News"

    when "nav-sports" is clicked:
        call searchLiveYouTube with "Cricket Highlights"

    # Sidebar Collapse Toggle
    when "btn-sidebar-toggle" is clicked:
        create sb as document.getElementById("yt-sidebar")
        if sb != null:
            if sb.style.display == "none":
                sb.style.display = "flex"
            else:
                sb.style.display = "none"

    # ── TOP BAR ACTIONS & MODALS ──
    when "btn-create" is clicked:
        create mCreate as document.getElementById("modal-create")
        if mCreate != null:
            mCreate.style.display = "flex"

    when "btn-close-create" is clicked:
        create mCreate as document.getElementById("modal-create")
        if mCreate != null:
            mCreate.style.display = "none"

    when "btn-cancel-upload" is clicked:
        create mCreate as document.getElementById("modal-create")
        if mCreate != null:
            mCreate.style.display = "none"

    when "btn-publish-video" is clicked:
        create uTitle as get value of "upload-title-input"
        if uTitle == "":
            set uTitle = "New Enlang Video by Spandan Prayas Patra"
        create mCreate as document.getElementById("modal-create")
        if mCreate != null:
            mCreate.style.display = "none"
        call showToast with "🚀 Video Published: " + uTitle

    when "btn-notif" is clicked:
        create dNotif as document.getElementById("dropdown-notif")
        if dNotif != null:
            if dNotif.style.display == "flex":
                dNotif.style.display = "none"
            else:
                dNotif.style.display = "flex"

    when "btn-voice" is clicked:
        call showToast with "🎙️ Listening... Speak to search YouTube"

    when "user-profile" is clicked:
        call showToast with "👤 Signed in as Spandan Prayas Patra (Creator)"

    # Live Search Execution
    when "btn-search" is clicked:
        create q as get value of "search-input"
        if q == "":
            call showToast with "Please type a search query"
            return
        call searchLiveYouTube with q

    # ── CATEGORY FILTER CHIPS (LIVE SEARCH INTEGRATION) ──
    when "chip-all" is clicked:
        call searchLiveYouTube with "Trending"

    when "chip-coding" is clicked:
        call searchLiveYouTube with "Coding and AI Tutorials"

    when "chip-java" is clicked:
        call searchLiveYouTube with "Java 21 Spring Boot"

    when "chip-spring" is clicked:
        call searchLiveYouTube with "Spring Boot Microservices"

    when "chip-enlang" is clicked:
        call searchLiveYouTube with "Compiler Engineering Enlang"

    when "chip-sysdesign" is clicked:
        call searchLiveYouTube with "System Design High Scale"

    when "chip-next" is clicked:
        call searchLiveYouTube with "Next.js Full Stack Tutorial"

    when "chip-edge" is clicked:
        call searchLiveYouTube with "Cloudflare Pages and Workers"

    when "chip-music" is clicked:
        call searchLiveYouTube with "Lo-Fi Beats to Relax"

    when "chip-gaming" is clicked:
        call searchLiveYouTube with "Gaming Gameplay 2026"

    when "chip-podcasts" is clicked:
        call searchLiveYouTube with "Tech Podcasts"

    # ── VIDEO PLAYER CONTROLS ──
    when "btn-player-play" is clicked:
        if isPlaying == true:
            set isPlaying = false
            set text of "btn-player-play" to "▶"
            call showToast with "⏸ Stream paused"
        else:
            set isPlaying = true
            set text of "btn-player-play" to "⏸"
            call showToast with "▶ Stream playing"

    when "btn-player-next" is clicked:
        call openWatchPage with "dQw4w9WgXcQ"

    when "btn-player-mute" is clicked:
        create mBtn as document.getElementById("btn-player-mute")
        if isMuted == true:
            set isMuted = false
            set text of "btn-player-mute" to "🔊"
            call showToast with "Audio unmuted (100%)"
        else:
            set isMuted = true
            set text of "btn-player-mute" to "🔇"
            call showToast with "Audio muted"

    when "btn-player-speed" is clicked:
        create sBtn as document.getElementById("btn-player-speed")
        if playbackSpeed == "1x":
            set playbackSpeed = "1.5x"
        else:
            if playbackSpeed == "1.5x":
                set playbackSpeed = "2x"
            else:
                set playbackSpeed = "1x"
        if sBtn != null:
            sBtn.innerText = playbackSpeed
        call showToast with "⚡ Playback Speed: " + playbackSpeed

    when "btn-player-cc" is clicked:
        call showToast with "📝 Closed Captions: English (Auto-generated)"

    when "btn-player-quality" is clicked:
        call showToast with "⚙️ Stream Quality: 1080p60 Full HD"

    when "btn-player-fullscreen" is clicked:
        create pCont as document.querySelector(".video-player-container")
        if document.fullscreenElement == null:
            if pCont != null:
                pCont.requestFullscreen()
                call showToast with "Entered Fullscreen Player"
        else:
            document.exitFullscreen()
            call showToast with "Exited Fullscreen Player"

    # ── TIMELINE SCRUBBER & CHAPTERS ──
    every 1 second:
        if isPlaying == true:
            if playSeconds < totalVideoSeconds:
                set playSeconds = playSeconds + 1
                create curStr as formatDuration(playSeconds)
                create totStr as formatDuration(totalVideoSeconds)
                set text of "player-time-display" to curStr + " / " + totStr
                create pct as (playSeconds / totalVideoSeconds) * 100
                create fillBar as document.getElementById("scrubber-progress")
                if fillBar != null:
                    fillBar.style.width = pct + "%"

    when "ch-1" is clicked:
        set playSeconds = 0
        call showToast with "📍 Chapter: 00:00 • Introduction"

    when "ch-2" is clicked:
        set playSeconds = 255
        call showToast with "📍 Chapter: 04:15 • HikariCP & Oracle Setup"

    when "ch-3" is clicked:
        set playSeconds = 570
        call showToast with "📍 Chapter: 09:30 • ACID Transactions"

    when "ch-4" is clicked:
        set playSeconds = 840
        call showToast with "📍 Chapter: 14:00 • High-Throughput Benchmarks"

    # ── SOCIAL ACTIONS (LIKE, SUBSCRIBE, JOIN, SHARE, CLIP) ──
    when "btn-join" is clicked:
        call showToast with "⭐ Welcome! Channel Membership perks unlocked."

    when "btn-subscribe" is clicked:
        create sBtn as document.getElementById("btn-subscribe")
        if isSubscribed == true:
            set isSubscribed = false
            sBtn.innerText = "Subscribe"
            sBtn.style.background = "#ffffff"
            sBtn.style.color = "#0f0f0f"
            call showToast with "Unsubscribed from Creator"
        else:
            set isSubscribed = true
            sBtn.innerText = "Subscribed ✓"
            sBtn.style.background = "#272727"
            sBtn.style.color = "#aaaaaa"
            call showToast with "🔔 Subscribed to Creator!"

    when "btn-like" is clicked:
        create lBtn as document.getElementById("btn-like")
        if isLiked == true:
            set isLiked = false
            lBtn.innerText = "👍 142K"
            lBtn.style.color = "#f1f1f1"
        else:
            set isLiked = true
            lBtn.innerText = "👍 142.1K"
            lBtn.style.color = "#3ea6ff"
            call showToast with "Added to Liked Videos"

    when "btn-dislike" is clicked:
        call showToast with "Disliked video"

    when "btn-share" is clicked:
        create mShare as document.getElementById("modal-share")
        if mShare != null:
            mShare.style.display = "flex"

    when "btn-close-share" is clicked:
        create mShare as document.getElementById("modal-share")
        if mShare != null:
            mShare.style.display = "none"

    when "btn-copy-share" is clicked:
        create mShare as document.getElementById("modal-share")
        if mShare != null:
            mShare.style.display = "none"
        call showToast with "🔗 Link copied to clipboard!"

    when "btn-download" is clicked:
        call showToast with "⬇ Downloading 1080p stream for offline playback..."

    when "btn-clip" is clicked:
        call showToast with "✂ Create Clip dialog opened"

    when "btn-more" is clicked:
        call showToast with "⋯ Options: Save to Playlist, Report, Transcript"

    # ── SHORTS REEL CONTROLS ──
    when "btn-shorts-next" is clicked:
        create nextIdx as (currentShortIndex + 1) % shortsList.length
        call renderActiveShort with nextIdx
        call showToast with "Next Short loaded"

    when "btn-shorts-prev" is clicked:
        create prevIdx as (currentShortIndex - 1 + shortsList.length) % shortsList.length
        call renderActiveShort with prevIdx
        call showToast with "Previous Short loaded"

    when "btn-shorts-like" is clicked:
        create sLike as document.getElementById("shorts-like-count")
        if isShortsLiked == true:
            set isShortsLiked = false
            if sLike != null:
                sLike.textContent = "245K"
        else:
            set isShortsLiked = true
            if sLike != null:
                sLike.textContent = "245.1K"
            call showToast with "Liked Short!"

    when "btn-shorts-dislike" is clicked:
        call showToast with "Disliked Short"

    when "btn-shorts-comment" is clicked:
        call showToast with "💬 Opening Shorts Comments (4.2K)"

    when "btn-shorts-share" is clicked:
        call showToast with "🔗 Shorts link copied!"

    when "btn-shorts-sub" is clicked:
        create sBtn as document.getElementById("btn-shorts-sub")
        if sBtn != null:
            if sBtn.innerText == "Subscribe":
                sBtn.innerText = "Subscribed ✓"
                sBtn.style.background = "#272727"
                sBtn.style.color = "#aaaaaa"
                call showToast with "Subscribed to Creator!"
            else:
                sBtn.innerText = "Subscribe"
                sBtn.style.background = "#ffffff"
                sBtn.style.color = "#0f0f0f"

    when "btn-shorts-mute" is clicked:
        call showToast with "Shorts audio toggled"

    # ── REAL-TIME COMMENTS IN PURE ENLGS ──
    to do postComment:
        create cText as get value of "new-comment-input"
        if cText == "":
            call showToast with "Please type a comment before posting"
            return

        create cContainer as document.getElementById("comment-list-container")
        if cContainer != null:
            create cCard as document.createElement("div")
            cCard.className = "comment-card"
            cCard.innerHTML = "<div class='user-avatar-sm' style='background: #8b5cf6;'>S</div><div class='comment-body'><div class='comment-author-row'><span class='comment-author'>@SpandanPrayas (You)</span><span class='comment-time'>Just now</span></div><p class='comment-msg'>" + cText + "</p><div class='comment-reactions'><button class='btn-react'>👍 1</button><button class='btn-react'>👎</button><button class='btn-react'>Reply</button></div></div>"
            cContainer.prepend(cCard)
            set value of "new-comment-input" to ""
            set totalComments = totalComments + 1
            set text of "comments-count-header" to totalComments + " Comments"
            call showToast with "💬 Comment posted publicly!"

    when "btn-submit-comment" is clicked:
        call postComment

    when "btn-cancel-comment" is clicked:
        set value of "new-comment-input" to ""

    # Clear History
    when "btn-clear-history" is clicked:
        create hContainer as document.getElementById("history-list-container")
        if hContainer != null:
            hContainer.innerHTML = "<p style='color: #888; padding: 20px;'>Watch history is empty.</p>"
        call showToast with "🗑️ Watch History Cleared"

    # Theme Toggle
    when "btn-theme" is clicked:
        create b as document.body
        create tBtn as document.getElementById("btn-theme")
        if tBtn.innerText == "☾":
            tBtn.innerText = "☼"
            b.style.background = "#ffffff"
            b.style.color = "#0f0f0f"
            call showToast with "Switched to YouTube Light Mode"
        else:
            tBtn.innerText = "☾"
            b.style.background = "#0f0f0f"
            b.style.color = "#f1f1f1"
            call showToast with "Switched to YouTube Dark Mode"
