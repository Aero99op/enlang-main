type enlng

# ==============================================================
#   ENLNG NATIVE LIBRARY: PANDAS (stdlib/pandas.enlng)
#   Pure Natural English Data Analysis, DataFrames & Series
# ==============================================================

define function DataFrame with data_dict:
    return {
        "type": "DataFrame",
        "columns": keys of data_dict,
        "data": data_dict,
        "rows_count": count of (data_dict[first key of data_dict])
    }

define function Series with data_list, name:
    return {
        "type": "Series",
        "name": name,
        "values": data_list,
        "length": count of data_list
    }

define function read_csv with file_path:
    display ">> [PANDAS] Ingesting CSV dataset from '" + file_path + "'..."
    return {
        "type": "DataFrame",
        "source": file_path,
        "status": "loaded"
    }

define function head with df, n:
    display ">> [PANDAS] Displaying top " + n + " rows..."
    return df

define function describe with df:
    display ">> [PANDAS] Computing descriptive statistics for all numerical columns..."
    return {}

define function value_counts with series:
    display ">> [PANDAS] Computing unique category frequencies..."
    return {}
