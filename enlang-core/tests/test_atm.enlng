type enlng

create a balance of 50000
create a pin of 7788
create a daily_limit of 20000
create a failed_attempts of 0
create a max_attempts of 3
create an authenticated of false

display "ATM Terminal Started. Balance: Rs. 50000"

create an entered_pin of 7788

if entered_pin is equal to pin:
    set authenticated = true
    display "PIN is Verified Successfully."
else:
    set failed_attempts = failed_attempts + 1
    display "Incorrect PIN."

if authenticated is true:
    create a withdraw_amount of 15000

    if withdraw_amount is greater than daily_limit:
        display "Withdrawal rejected: Daily limit exceeded."
    elif withdraw_amount is greater than balance:
        display "Withdrawal rejected: Insufficient balance."
    else:
        set balance = balance - withdraw_amount
        display "Withdrawal successful: Rs. 15000 dispensed."
        display "Remaining Balance: Rs. " + balance

    create a deposit_amount of 5000
    set balance = balance + deposit_amount
    display "Deposit successful: Rs. 5000 added."
    display "Final Account Balance: Rs. " + balance
else:
    if failed_attempts is at least max_attempts:
        display "Card blocked due to maximum attempts."
