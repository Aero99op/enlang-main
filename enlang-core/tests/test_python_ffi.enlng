type enlng

# ==============================================================
#   ENLNG PYTHON INJECTION (FFI) TEST SUITE
#   Supports:
#     1. Line Prefix   : @python <code>
#     2. String Literal: @python "<code>"
#     3. Block Format  : @python ( <code> )
# ==============================================================

display "=============================================================="
display "       ⚡ ENLNG NATIVE PYTHON INJECTION (FFI) ENGINE          "
display "=============================================================="

# Test 1: String Literal Injection
display ">> Test 1: Executing String Literal @python \"...\""
@python "print('   [PYTHON FFI] String literal executed! Python version active.')"

# Test 2: Line-Level Prefix Injection
display ">> Test 2: Executing Line-Level Prefix @python ..."
@python print('   [PYTHON FFI] Line-level code execution verified!')

# Test 3: Multiline Block Injection with NumPy & Matplotlib
display ">> Test 3: Executing Multiline Block @python ( ... ) for Bell MF Plotting"

@python (
import numpy as np
import matplotlib.pyplot as plt

# 1. Generate range from -10 to +10
x = np.linspace(-10, 10, 200)

# 2. Compute Generalized Bell MF: 1 / (1 + |x/2|^8)
a, b, c = 2.0, 4.0, 0.0
y = 1.0 / (1.0 + np.abs((x - c) / a)**(2.0 * b))

# 3. Plot and save PNG
plt.figure(figsize=(9, 5))
plt.plot(x, y, color='#9333ea', linewidth=2.5, label='Bell MF (a=2, b=4, c=0)')
plt.fill_between(x, y, color='#c084fc', alpha=0.3)
plt.axvline(0, color='#dc2626', linestyle='--', alpha=0.7, label='Center (c=0)')
plt.axvline(2, color='#f59e0b', linestyle=':', alpha=0.8, label='Crossover (c+a=2)')
plt.axvline(-2, color='#f59e0b', linestyle=':', alpha=0.8, label='Crossover (c-a=-2)')
plt.title('Generalized Bell Membership Function (Injected via @python in Enlng)', fontsize=13, fontweight='bold')
plt.xlabel('Universe of Discourse (x)', fontsize=11)
plt.ylabel('Degree of Membership μ(x)', fontsize=11)
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend(loc='upper right')
plt.tight_layout()

# Save real PNG image directly to disk
plt.savefig('bell_mf_from_enlng.png', dpi=150)
print('   [PYTHON FFI] Generated bell_mf_from_enlng.png directly on disk!')
)

display "=============================================================="
display "   RESULT: ALL @python INJECTION FORMATS EXECUTED 100%!       "
display "=============================================================="
