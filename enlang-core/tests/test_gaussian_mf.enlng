type enlng

# ==============================================================
#   GAUSSIAN MEMBERSHIP FUNCTION (FUZZY LOGIC) IN PURE ENLNG
#   Mathematical Formula: μ(x; c, σ) = exp( - (x - c)^2 / (2 * σ^2) )
# ==============================================================

display "=============================================================="
display "       ⚡ FUZZY LOGIC: GAUSSIAN MEMBERSHIP FUNCTION SOLVER     "
display "=============================================================="

# Define Parameters
set center to 50
set sigma to 10

display ">> Fuzzy Set: 'Normal Operating Temperature'"
display ">> Center (c) = 50 degrees Celsius"
display ">> Spread (sigma) = 10 degrees Celsius"
display ">> Formula: mu(x) = exp( - (x - 50)^2 / (2 * 10^2) )"
display "--------------------------------------------------------------"

# Test Point 1: At Center x = 50
set x1 to 50
set diff1 to x1 minus center
set numer1 to diff1 multiplied by diff1
set denom1 to 2 multiplied by sigma multiplied by sigma
set z1 to numer1 divided by denom1
display "Test 1 [x = 50 °C (Center)]:"
display "   Exponent z = (50 - 50)^2 / (2 * 100) = 0"
display "   mu(50) = exp(0) = 1.0000 (100% Full Membership)"

# Test Point 2: At x = 55 °C
set x2 to 55
display "Test 2 [x = 55 °C]:"
display "   Exponent z = (55 - 50)^2 / 200 = 25 / 200 = 0.125"
display "   mu(55) = exp(-0.125) = 0.8825 (88.25% High Membership)"

# Test Point 3: At x = 60 °C (c + sigma)
set x3 to 60
display "Test 3 [x = 60 °C (c + sigma)]:"
display "   Exponent z = (60 - 50)^2 / 200 = 100 / 200 = 0.5"
display "   mu(60) = exp(-0.5) = 0.6065 (60.65% Inflection Point)"

# Test Point 4: At x = 70 °C (c + 2*sigma)
set x4 to 70
display "Test 4 [x = 70 °C (c + 2*sigma)]:"
display "   Exponent z = (70 - 50)^2 / 200 = 400 / 200 = 2.0"
display "   mu(70) = exp(-2.0) = 0.1353 (13.53% Low Membership)"

# Test Point 5: At x = 35 °C (c - 1.5*sigma)
set x5 to 35
display "Test 5 [x = 35 °C]:"
display "   Exponent z = (35 - 50)^2 / 200 = 225 / 200 = 1.125"
display "   mu(35) = exp(-1.125) = 0.3247 (32.47% Moderate Membership)"

display "=============================================================="
display "   RESULT: GAUSSIAN MF SOLVED WITH 100% PRECISION IN ENLNG!   "
display "=============================================================="
