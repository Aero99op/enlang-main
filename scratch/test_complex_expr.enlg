# Advanced Complex Expressions Test in Enlang
declare math_res = (10 + 20) / 2
print "Math (10+20)/2: " + math_res

declare chain_sum = 1 + 2 + 3 + 4 + 5
print "Chain sum: " + chain_sum

declare is_odd = 29 % 2 == 1
print "Is 29 odd? " + is_odd

declare msg = "Factorial of " + 5 + " is " + 120
print msg

declare arr = [10, 20, 30]
declare item = arr[1]
print "Array index 1: " + item
