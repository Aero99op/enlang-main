# 1. Test AI Prime Code
create number as 30

function isPrime with n:
    if n <= 1:
        return false
    create i as 2
    while i * i <= n:
        if n % i == 0:
            return false
        set i to i + 1
    return true

create result as call isPrime with number
if result is true:
    print number + " is a prime number."
else:
    print number + " is NOT a prime number."
