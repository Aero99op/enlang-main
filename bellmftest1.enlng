type enlng

# =====================================================================
# ENLANG BELL MEMBERSHIP FUNCTION GRAPH (USING PYTHON LIBRARIES)
# Zero custom math function. Uses:
# - skfuzzy (fuzz.gbellmf) for Generalized Bell Membership Function
# - numpy (np.linspace) for domain grid evaluation
# - matplotlib.pyplot (plt) for visualization and saving
# =====================================================================

use library "numpy" as np
use library "skfuzzy" as fuzz
use library "matplotlib.pyplot" as plt

# Generate high-resolution domain from 0 to 10
x = np.linspace(0.0, 10.0, 500)

# Compute Bell MF curves directly using library functions (gbellmf)
# 1. Standard Bell MF: a=2.0 (width), b=4.0 (slope), c=5.0 (center)
y_standard = fuzz.gbellmf(x, 2.0, 4.0, 5.0)

# 2. Broad Slope Bell MF: a=3.0, b=2.0, c=5.0
y_broad = fuzz.gbellmf(x, 3.0, 2.0, 5.0)

# 3. Steep Narrow Bell MF: a=1.5, b=6.0, c=5.0
y_steep = fuzz.gbellmf(x, 1.5, 6.0, 5.0)

# Create figure
plt.figure(figsize=[10, 6], dpi=300)

# Plot all membership curves
plt.plot(x, y_standard, color="#0052cc", linewidth=2.5, label="Standard Bell MF (a=2.0, b=4.0, c=5.0)")
plt.plot(x, y_broad, color="#ff5630", linewidth=2.0, linestyle="--", label="Broad Slope Bell (a=3.0, b=2.0, c=5.0)")
plt.plot(x, y_steep, color="#36b37e", linewidth=2.0, linestyle="-.", label="Steep Narrow Bell (a=1.5, b=6.0, c=5.0)")

# Fill area under standard curve
plt.fill_between(x, y_standard, color="#0052cc", alpha=0.15)

# Add titles, labels, legend, grid
plt.title("Generalized Bell Membership Function (skfuzzy.gbellmf in Enlang)", fontsize=14, fontweight="bold", pad=14)
plt.xlabel("Input Variable (x)", fontsize=12, labelpad=8)
plt.ylabel("Membership Degree \u03bc(x)", fontsize=12, labelpad=8)
plt.ylim(-0.05, 1.10)
plt.xlim(0.0, 10.0)
plt.grid(true, linestyle=":", alpha=0.6)
plt.legend(loc="upper right", frameon=true, fontsize=10)

# Save output
output_path = "bellmftest1.png"
plt.savefig(output_path, dpi=300, bbox_inches="tight")
plt.close()

show "=== BELL MF GENERATED VIA SKFUZZY ==="
show "Saved directly to:" output_path
